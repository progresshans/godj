	legacyPermissions, interests orm.ManyToMany[members.Member, models.Permission, L]
	grants                       orm.ManyToMany[catalog.Team, catalog.Grant, L]
	sharedGroupGrants            orm.ManyToMany[models.Group, catalog.Grant, L]
	sharedPermissionGrants       orm.ManyToMany[catalog.Team, models.Permission, L]
}
