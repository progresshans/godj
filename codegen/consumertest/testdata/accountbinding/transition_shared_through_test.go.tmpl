func stMust(t *testing.T, err error) {
	t.Helper()
	if err != nil {
		t.Fatal(err)
	}
}

func stSave[M any](ctx context.Context, scope db.Mutator, objects orm.Manager[M], before *M, values map[string]query.Value) (M, error) {
	var zero M
	prepared, err := objects.PrepareValues(before, values)
	if err != nil {
		return zero, err
	}
	row, err := prepared.Model()
	if err != nil {
		return zero, err
	}
	err = prepared.Save(ctx, scope, &row)
	return row, err
}

func stRows[M any](t *testing.T, scope db.Queryer, objects orm.Manager[M]) map[int64]map[string]query.Value {
	t.Helper()
	name, err := objects.PrimaryKeyField()
	stMust(t, err)
	rows, err := objects.Using(scope).OrderBy(orm.NewAutoField[M](name).Asc()).All(t.Context())
	stMust(t, err)
	result := make(map[int64]map[string]query.Value, len(rows))
	for _, row := range rows {
		key, present, err := objects.PrimaryKey(row)
		stMust(t, err)
		id, ok := key.Integer()
		if !present || !ok {
			t.Fatal("native row lost its key")
		}
		values, err := objects.ModelValues(row)
		stMust(t, err)
		result[id] = values
	}
	return result
}

func stSnapshot(t *testing.T, backend database.Backend) map[string]any {
	t.Helper()
	result, err := db.ReadSnapshotResult(t.Context(), backend, func(_ context.Context, scope db.Queryer) (map[string]any, error) {
		return map[string]any{
			"users": stRows(t, scope, models.UserObjects), "members": stRows(t, scope, members.MemberObjects),
			"old_groups": stRows(t, scope, models.GroupObjects), "old_permissions": stRows(t, scope, models.PermissionObjects),
			"groups": stRows(t, scope, catalog.TeamObjects), "permissions": stRows(t, scope, catalog.GrantObjects),
			"plain": stRows(t, scope, bridges.BridgeObjects), "unique": stRows(t, scope, bridges.UniqueBridgeObjects),
			"hubs":      stRows(t, scope, bridges.HubObjects),
			"ownership": stRows(t, scope, domainmodels.TransitionObjects), "mappings": stRows(t, scope, domainmodels.MappingObjects),
			"audit": stRows(t, scope, auditmodels.EventObjects), "sessions": stRows(t, scope, sessionmodels.SessionObjects),
		}, nil
	})
	stMust(t, err)
	return result
}

type stInsertion struct {
	key  int64
	plan query.InsertPlan
}
type stBackend struct {
	database.Backend
	table, mode         string
	inserted            []stInsertion
	identities          map[string][]stInsertion
	signedIdentities    bool
	receipt, finished   bool
	nativeGeneratedKeys bool
	faults              int
	mutate              func(context.Context, db.Queryer) error
}

func (backend *stBackend) CoordinatedAtomic(ctx context.Context, write func(db.Session) error) error {
	return backend.wrap(func(visit func(db.Session) error) error { return backend.Backend.CoordinatedAtomic(ctx, visit) }, write)
}
func (backend *stBackend) CoordinatedAtomicRelation(ctx context.Context, write func(db.RelationSession) error) error {
	return backend.wrap(func(visit func(db.Session) error) error {
		return backend.Backend.CoordinatedAtomicRelation(ctx, func(scope db.RelationSession) error { return visit(scope) })
	}, func(scope db.Session) error { return write(scope.(*stScope)) })
}
func (backend *stBackend) wrap(native func(func(db.Session) error) error, write func(db.Session) error) error {
	completed := false
	err := native(func(scope db.Session) error {
		if err := write(&stScope{Session: scope, owner: backend}); err != nil {
			return err
		}
		completed = true
		if backend.mode == "unknown_rollback" {
			return errors.New("shared through rollback after complete writes")
		}
		return nil
	})
	if completed {
		backend.finished = true
	}
	if completed && (backend.mode == "unknown_rollback" || err == nil && backend.mode == "unknown_commit") {
		return &query.Error{Category: query.CategoryBackend, Code: query.CodeCommitOutcomeUnknown}
	}
	return err
}

type stScope struct {
	db.Session
	owner *stBackend
}

func (scope *stScope) ValidateSession(ctx context.Context) error {
	return scope.Session.(db.SessionValidator).ValidateSession(ctx)
}
func (scope *stScope) RelationSetNull(ctx context.Context, plan query.RelationSetNullPlan) (int64, error) {
	return scope.Session.(db.RelationSession).RelationSetNull(ctx, plan)
}
func (scope *stScope) plan(plan query.InsertPlan) query.InsertPlan {
	if scope.owner.nativeGeneratedKeys {
		return plan
	}
	count := len(scope.owner.inserted)
	if scope.owner.signedIdentities && stIdentityTable(plan.Table()) {
		count = len(scope.owner.identities[plan.Table()])
	} else if scope.owner.mode != "signed_keys" || plan.Table() != scope.owner.table {
		return plan
	}
	key, _ := plan.ReturningKey()
	value := -int64(100 + count)
	if count == 0 {
		value = 0
	}
	return query.NewInsertPlanReturningKey(plan.Table(), append(plan.Assignments(), query.NewAssignment(key, query.Integer(value))), key)
}
func (scope *stScope) Insert(ctx context.Context, plan query.InsertPlan) (int64, error) {
	plan = scope.plan(plan)
	id, err := scope.Session.Insert(ctx, plan)
	if err != nil {
		return id, err
	}
	if plan.Table() == scope.owner.table {
		scope.owner.inserted = append(scope.owner.inserted, stInsertion{id, plan})
	}
	if stIdentityTable(plan.Table()) {
		scope.owner.identities[plan.Table()] = append(scope.owner.identities[plan.Table()], stInsertion{id, plan})
	}
	if plan.Table() == "godj_account_domain_transition" {
		scope.owner.receipt = true
	}
	if scope.owner.mode == "audit_failure" && plan.Table() == "godj_account_audit_event" {
		scope.owner.faults++
		return id, errors.New("shared through failure after audit write")
	}
	return id, nil
}
func (scope *stScope) InsertOnConflict(ctx context.Context, plan query.ConflictInsertPlan) (db.ConflictInsertResult, error) {
	plan = query.NewConflictInsertPlan(scope.plan(plan.Insert()), plan.Target())
	result, err := scope.Session.(db.ConflictInserter).InsertOnConflict(ctx, plan)
	if err == nil && result.Inserted && plan.Table() == scope.owner.table {
		scope.owner.inserted = append(scope.owner.inserted, stInsertion{result.Key, plan.Insert()})
	}
	return result, err
}
func (scope *stScope) Update(ctx context.Context, plan query.UpdatePlan) (int64, error) {
	count, err := scope.Session.Update(ctx, plan)
	if err == nil && scope.owner.mode == "rollback" && plan.Table() == "godj_identity_user" {
		scope.owner.faults++
		return count, errors.New("shared through failure after source retirement")
	}
	return count, err
}

func stIdentityTable(table string) bool {
	return slices.Contains([]string{"members_member", "catalog_team", "catalog_grant"}, table)
}

