func TestAccountCatalogTransition(t *testing.T){
 for _,strategy:=range []string{"staged","created"}{t.Run(strategy,func(t *testing.T){
  cases:=[]string{@@STAGED_CASES@@};if strategy=="created"{cases=[]string{@@CREATED_CASES@@}}
  for _,mode:=range cases{t.Run(mode,func(t *testing.T){testAccountCatalogTransition(t,strategy,mode)})}
 })}
}

func testAccountCatalogTransition(t *testing.T,strategy,mode string){
 f:=newCTFixture(t,strategy,mode)
 if mode=="configuration"{
  for _,maximum:=range []int{-1,accountmodel.MaximumTransitionCatalogRows+1}{config:=f.config;config.MaxCatalogRows=maximum;if _,err:=accountmodel.NewTransition(f.oldStore,f.nextStore,config);err==nil{t.Fatal("invalid catalog limit accepted")}}
  if _,err:=f.prepare(t,strings.Repeat("b",64),f.catalogMapping,f.catalogMapping);err==nil{t.Fatal("multiple catalog mappings accepted")}
  return
 }
 mapping:=accountmodel.CatalogMappings{Groups:slices.Clone(f.catalogMapping.Groups),Permissions:slices.Clone(f.catalogMapping.Permissions)}
 switch mode{
 case "duplicate_mapping":mapping.Groups=append(mapping.Groups,mapping.Groups[0])
 case "incomplete_mapping":mapping.Groups=mapping.Groups[:len(mapping.Groups)-1]
 case "mapping_revision":mapping.Permissions[0].TargetRevision++
 case "shared_group_nonidentity":mapping.Groups[0].TargetID,mapping.Groups[1].TargetID=mapping.Groups[1].TargetID,mapping.Groups[0].TargetID
 case "wrong_code":ctMust(t,ctPatchIn(t.Context(),f.native,catalog.GrantObjects,f.grants[2],map[string]query.Value{"symbol":query.String("app.other")}))
 case "invalid_unused_code":ctMust(t,ctPatchIn(t.Context(),f.native,catalog.GrantObjects,f.grants[2],map[string]query.Value{"symbol":query.String("invalid permission")}))
 case "invalid_unused_revision":ctMust(t,ctPatchIn(t.Context(),f.native,catalog.TeamObjects,f.teams[1],map[string]query.Value{"version":query.Integer(0)}))
 case "wrong_unused_group_grants":_,err:=catalog.TeamGrantsLinkObjects.Create(t.Context(),f.native,catalog.NewTeamGrantsLinkCreate(f.teams[1].ID,f.grants[2].ID));ctMust(t,err)
 case "same_effective_wrong_direct":
  if strategy=="staged"{row,err:=members.MemberPermissionsLinkObjects.Using(f.native).Filter(members.MemberPermissionsLinkFields.SourceID.Exact(f.newRows[0].ID)).Get(t.Context());ctMust(t,err);_,err=members.MemberPermissionsLinkObjects.Delete(t.Context(),f.native,&row);ctMust(t,err)}
 }
 if mode=="read_cleanup"{f.backend.mode=mode}
 operation:=strings.Repeat("b",64)
 snapshots:=f.backend.snapshots.Load()
 catalogs:=[]accountmodel.CatalogMappings{mapping};if mode=="missing_mapping"{catalogs=nil}
 prepared,err:=f.prepare(t,operation,catalogs...);f.backend.mode=""
 early:=slices.Contains([]string{"missing_mapping","duplicate_mapping","incomplete_mapping","mapping_revision","shared_group_nonidentity","catalog_limit","catalog_inventory_limit","wrong_code","invalid_unused_code","invalid_unused_revision","wrong_unused_group_grants","read_cleanup"},mode)||strategy=="staged"&&mode=="same_effective_wrong_direct"
