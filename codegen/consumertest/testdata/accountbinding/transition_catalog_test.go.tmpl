func ctStores(t *testing.T,backend database.Backend,role ir.AccountRole)(accountmodel.Binding[members.Member],*accountmodel.SessionStore[models.User],*accountmodel.SessionStore[members.Member]){
 t.Helper()
 source,err:=project.NewAccountCredentialStore(backend);ctMust(t,err)
 binding,err:=accountmodel.Bind(role,members.MemberDescriptor{},models.GoDjRelationSchema(),members.GoDjRelationSchema(),host.GoDjRelationSchema(),catalog.GoDjRelationSchema());ctMust(t,err)
 var target *accountmodel.CredentialStore[members.Member]
 if role.Catalog.Group.AppLabel=="godj_identity" {
  target,err=accountmodel.NewCredentialStore(backend,binding,models.GroupDescriptor{},catalog.GrantDescriptor{})
 } else if role.Catalog.Permission.AppLabel=="godj_identity" {
  target,err=accountmodel.NewCredentialStore(backend,binding,catalog.TeamDescriptor{},models.PermissionDescriptor{})
 } else { target,err=accountmodel.NewCredentialStore(backend,binding,catalog.TeamDescriptor{},catalog.GrantDescriptor{}) }
 ctMust(t,err)
 oldStore,err:=accountmodel.NewSessionStore(source,sessiondb.Config{});ctMust(t,err)
 nextStore,err:=accountmodel.NewSessionStore(target,sessiondb.Config{});ctMust(t,err)
 return binding,oldStore,nextStore
}

