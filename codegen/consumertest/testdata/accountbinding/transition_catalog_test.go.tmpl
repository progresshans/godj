func ctMust(t *testing.T, err error) { t.Helper(); if err != nil { t.Fatal(err) } }

func ctPatchIn[M any](ctx context.Context, scope db.Mutator, objects orm.Manager[M], row M, values map[string]query.Value) error {
 prepared, err := objects.PrepareValues(&row, values); if err != nil { return err }
 value, err := prepared.Model(); if err != nil { return err }
 return prepared.Save(ctx, scope, &value)
}

type ctBackend struct {
 database.Backend
 mode string
 team, grant int64
 faults, completed, snapshots atomic.Int32
 policy atomic.Bool
}

func (b *ctBackend) ReadSnapshot(ctx context.Context, read func(db.Queryer) error) error {
 b.snapshots.Add(1)
 err := b.Backend.ReadSnapshot(ctx, read)
 if err == nil && b.mode == "read_cleanup" { return errors.New("private catalog transition cleanup") }
 return err
}

func (b *ctBackend) finish(completed bool, err error) error {
 if completed && (b.mode == "unknown_rollback" || err == nil && b.mode == "unknown_commit") {
  return &query.Error{Category:query.CategoryBackend, Code:query.CodeCommitOutcomeUnknown}
 }
 return err
}

func (b *ctBackend) write(scope db.Session, write func(db.Session) error) (bool, error) {
 if err := write(&ctScope{Session:scope, owner:b}); err != nil { return false, err }
 b.completed.Add(1)
 if b.mode == "unknown_rollback" { return true, errors.New("rollback after complete native catalog transition") }
 return true, nil
}

func (b *ctBackend) CoordinatedAtomic(ctx context.Context, write func(db.Session) error) error {
 completed := false
 err := b.Backend.CoordinatedAtomic(ctx, func(scope db.Session) error { var err error; completed, err = b.write(scope, write); return err })
 return b.finish(completed, err)
}

func (b *ctBackend) CoordinatedAtomicRelation(ctx context.Context, write func(db.RelationSession) error) error {
 completed := false
 err := b.Backend.CoordinatedAtomicRelation(ctx, func(scope db.RelationSession) error {
  var err error
  completed, err = b.write(scope, func(wrapped db.Session) error { return write(wrapped.(*ctScope)) })
  return err
 })
 return b.finish(completed, err)
}

type ctScope struct { db.Session; owner *ctBackend }
func (s *ctScope) ValidateSession(ctx context.Context) error { return s.Session.(db.SessionValidator).ValidateSession(ctx) }
func (s *ctScope) RelationSetNull(ctx context.Context, plan query.RelationSetNullPlan) (int64,error) { return s.Session.(db.RelationSession).RelationSetNull(ctx,plan) }
func (s *ctScope) InsertOnConflict(ctx context.Context, plan query.ConflictInsertPlan) (bool,error) {
 inserted,err:=s.Session.(db.ConflictInserter).InsertOnConflict(ctx,plan)
 if err==nil&&inserted&&plan.Table()=="members_member_permissions"&&s.owner.mode=="same_effective_wrong_direct"{err=s.loseDirect(ctx)}
 return inserted,err
}
func (s *ctScope) loseDirect(ctx context.Context)error{
 if !s.owner.faults.CompareAndSwap(0,1){return nil}
 row,found,err:=members.MemberPermissionsLinkObjects.Using(s.Session).OrderBy(members.MemberPermissionsLinkFields.ID.Desc()).First(ctx);if err!=nil{return err};if !found{return errors.New("no actual direct grant to remove")}
 _,err=members.MemberPermissionsLinkObjects.Delete(ctx,s.Session,&row);return err
}
func (s *ctScope) changeCatalog(ctx context.Context, link bool) error {
 if !s.owner.faults.CompareAndSwap(0,1) { return nil }
 if link {
  _,err:=catalog.TeamGrantsLinkObjects.Create(ctx,s.Session,catalog.NewTeamGrantsLinkCreate(s.owner.team,s.owner.grant));return err
 }
 row,err:=catalog.TeamObjects.Using(s.Session).Filter(catalog.TeamFields.ID.Exact(s.owner.team)).Get(ctx);if err!=nil{return err}
 return ctPatchIn(ctx,s.Session,catalog.TeamObjects,row,map[string]query.Value{"note":query.String("native rule changed unused catalog")})
}
func (s *ctScope) Update(ctx context.Context, plan query.UpdatePlan)(int64,error){
 count,err:=s.Session.Update(ctx,plan);if err!=nil{return count,err}
 if plan.Table()=="godj_identity_user" {
  if s.owner.mode=="rollback" { s.owner.faults.Add(1);return count,errors.New("failure after native source retirement") }
  if s.owner.mode=="retirement_catalog_change" { if err:=s.changeCatalog(ctx,false);err!=nil{return count,err} }
 }
 return count,nil
}
func (s *ctScope) Insert(ctx context.Context,plan query.InsertPlan)(int64,error){
 id,err:=s.Session.Insert(ctx,plan);if err!=nil{return id,err}
 if plan.Table()=="members_member_permissions"&&s.owner.mode=="same_effective_wrong_direct"{if err:=s.loseDirect(ctx);err!=nil{return id,err}}
 if s.owner.mode=="audit_failure"&&plan.Table()=="godj_account_audit_event" || s.owner.mode=="mapping_failure"&&plan.Table()=="godj_account_domain_mapping" || s.owner.mode=="receipt_failure"&&plan.Table()=="godj_account_domain_transition" {
  s.owner.faults.Add(1);return id,errors.New("failure after native catalog transition dependency INSERT")
 }
 if plan.Table()=="godj_account_domain_transition" && (s.owner.mode=="late_catalog_change"||s.owner.mode=="late_link_change") {
  if err:=s.changeCatalog(ctx,s.owner.mode=="late_link_change");err!=nil{return id,err}
 }
 if plan.Table()=="members_member"&&s.owner.mode=="target_insert_catalog_change" { if err:=s.changeCatalog(ctx,false);err!=nil{return id,err} }
 return id,nil
}

