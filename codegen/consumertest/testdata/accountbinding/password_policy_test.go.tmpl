)

// Keep native rollback, then vary only its reported completion. A confirmed
// policy rejection is renderable; joined cleanup, swallowed failure and an
// unknown outcome must remain execution failures with no provisional result.
type accountPolicyBoundary struct {
	database.Backend
	mode                      string
	writes, callbacks, faults int
	cause                     error
}

func (boundary *accountPolicyBoundary) complete(err error) error {
	if _, rejected := accountmodel.PasswordInputDiagnostics(err); !rejected {
		return err
	}
	switch boundary.mode {
	case "cleanup":
		boundary.faults++
		return errors.Join(err, boundary.cause)
	case "swallowed":
		boundary.faults++
		return nil
	case "unknown":
		boundary.faults++
		return errors.Join(err, boundary.cause)
	default:
		return err
	}
}

func (boundary *accountPolicyBoundary) CoordinatedAtomic(ctx context.Context, callback func(db.Session) error) error {
	boundary.writes++
	return boundary.complete(boundary.Backend.CoordinatedAtomic(ctx, func(scope db.Session) error {
		boundary.callbacks++
		return callback(scope)
	}))
}

func (boundary *accountPolicyBoundary) CoordinatedAtomicRelation(ctx context.Context, callback func(db.RelationSession) error) error {
	boundary.writes++
	return boundary.complete(boundary.Backend.CoordinatedAtomicRelation(ctx, func(scope db.RelationSession) error {
		boundary.callbacks++
		return callback(scope)
	}))
}

func TestAccountPasswordPolicyBoundaries(t *testing.T) {
	for _, operation := range []string{"create", "password"} {
		creationInputRun(t, operation, func(t *testing.T) {
			f := newCreationInputFixture(t, false)
			member, err := f.objects.Using(f.native).Filter(f.login.Exact("member")).Get(t.Context())
			creationInputCheck(t, err)
			key, present, err := f.objects.PrimaryKey(member)
			creationInputCheck(t, err)
			id, integer := key.Integer()
			if !present || !integer {
				t.Fatal("policy target has no key")
			}
			changed, err := f.runtime.Accounts().Passwords().SetPassword(t.Context(), f.actor, id, 1, accountPasswordText)
			creationInputCheck(t, err)
			if changed.ID != id || changed.Revision != 2 {
				t.Fatal("policy target was not provisioned")
			}
			credential, err := f.runtime.Authenticator().Authenticate(t.Context(), "member", accountPasswordText)
			creationInputCheck(t, err)
			for range 3 {
				_, err := f.runtime.Sessions().Create(t.Context(), map[string]string{auth.SessionPrincipalIDKey: credential.Principal().ID(), auth.SessionCredentialStampKey: credential.SessionStamp(), "preserve": "target"})
				creationInputCheck(t, err)
			}
			actorCredential, err := f.runtime.Authenticator().Resolve(t.Context(), f.actor.ID())
			creationInputCheck(t, err)
			_, err = f.runtime.Sessions().Create(t.Context(), map[string]string{auth.SessionPrincipalIDKey: f.actor.ID(), auth.SessionCredentialStampKey: actorCredential.SessionStamp(), "preserve": "actor"})
			creationInputCheck(t, err)
			_, err = f.runtime.Sessions().Create(t.Context(), map[string]string{"preserve": "anonymous"})
			creationInputCheck(t, err)
			for _, mode := range []string{"preflight", "final", "cleanup", "swallowed", "unknown", "cancel_preflight", "cancel_final"} {
				creationInputRun(t, mode, func(t *testing.T) {
					boundary := &accountPolicyBoundary{Backend: f.native, mode: mode, cause: errors.New("private-policy-cleanup")}
					if mode == "unknown" {
						boundary.cause = &query.Error{Code: query.CodeCommitOutcomeUnknown, Detail: "private-policy-outcome"}
					}
					ctx, cancel := context.WithCancel(t.Context())
					defer cancel()
					calls := 0
					config := f.config
					config.Accounts.ValidatePassword = func(_ context.Context, raw string, profile orm.ModelView[usernameAccount]) (validation.Errors, error) {
						calls++
						source, valid := profile.Model()
						value, loaded := profile.Get(f.role.Login)
						name, textual := value.String()
						wantName := "member"
						if operation == "create" {
							wantName = "Candidate"
						}
						secret, hasSecret := profile.Get(f.role.Password)
						encoded, stringSecret := secret.String()
						if !valid || !source.Equal(f.metadata) || !loaded || !textual || name != wantName || !hasSecret || !stringSecret || encoded != "" || raw != "  replacement secret  " {
							t.Fatal("policy lost its typed profile or received a credential")
						}
						if calls == 1 && mode != "preflight" && mode != "cancel_preflight" {
							return validation.Errors{}, nil
						}
						if mode == "cancel_preflight" || mode == "cancel_final" {
							cancel()
						}
						return validation.NewErrors(validation.New("password", "policy_rejected")), nil
					}
					owner, err := project.NewAccountRuntime(t.Context(), boundary, f.hasher, auth.PrincipalAuthorizer{}, config)
					creationInputCheck(t, err)
					before, hashes := f.snapshot(t), f.hasher.calls.Load()
					var failure error
					if operation == "create" {
						// Preserve the same selected profile as the rest of this
						// consumer without guessing a custom model's field name.
						values := map[string]query.Value{f.role.Login: query.String("Candidate")}
						for _, field := range config.Accounts.CreateFields {
							if field != f.role.Login {
								values[field] = query.String("NZ")
							}
						}
						input, err := f.objects.Input(values)
						creationInputCheck(t, err)
						creator := owner.Accounts().Creator()
						prepared, err := creator.Prepare(ctx, f.actor, input, "  replacement secret  ")
						failure = err
						if err == nil {
							result, err := creator.Commit(ctx, f.actor, prepared)
							failure = err
							if !reflect.DeepEqual(result, accountmodel.Creation{}) {
								t.Fatal("failed policy published a creation receipt")
							}
							// A final refusal consumes the same prepared attempt,
							// including uncertain completion. Never replay it.
							replayed, replayError := creator.Commit(t.Context(), f.actor, prepared)
							if !errors.Is(replayError, &accountmodel.Error{Code: accountmodel.CodeConflict}) || !reflect.DeepEqual(replayed, accountmodel.Creation{}) {
								t.Fatal("failed prepared creation was replayable", replayError)
							}
						} else {
							result, invalid := creator.Commit(t.Context(), f.actor, prepared)
							if !errors.Is(invalid, &accountmodel.Error{Code: accountmodel.CodeInvalidInput}) || !reflect.DeepEqual(result, accountmodel.Creation{}) {
								t.Fatal("failed preparation published a usable candidate", invalid)
							}
						}
					} else {
						result, err := owner.Accounts().Passwords().SetPassword(ctx, f.actor, id, changed.Revision, "  replacement secret  ")
						failure = err
						if result != (accountmodel.PasswordEditResult{}) {
							t.Fatal("failed policy published a password receipt")
						}
					}
					wantCalls, wantWrites, wantHashes, wantFaults := 2, 1, int64(1), 0
					if mode == "preflight" || mode == "cancel_preflight" {
						wantCalls, wantWrites, wantHashes = 1, 0, 0
					}
					if mode == "cleanup" || mode == "swallowed" || mode == "unknown" {
						wantFaults = 1
					}
					if failure == nil || calls != wantCalls || boundary.writes != wantWrites || boundary.callbacks != wantWrites || boundary.faults != wantFaults || f.hasher.calls.Load()-hashes != wantHashes {
						t.Fatal("policy phase, hash or native attempt differs", failure, calls, boundary.writes, boundary.callbacks, boundary.faults, f.hasher.calls.Load()-hashes)
					}
					diagnostics, credentialRejection := accountmodel.PasswordInputDiagnostics(failure)
					_, rejected := validation.Rejected(failure)
					if mode == "preflight" || mode == "final" {
						if !credentialRejection || !rejected || !reflect.DeepEqual(diagnostics.All(), []validation.Violation{validation.New("password", "policy_rejected")}) {
							t.Fatal("confirmed password rejection lost its origin", failure)
						}
					} else {
						if credentialRejection || rejected {
							t.Fatal("unconfirmed or canceled policy became renderable input", failure)
						}
						switch mode {
						case "cancel_preflight", "cancel_final":
							if !errors.Is(failure, context.Canceled) {
								t.Fatal("policy cancellation cause disappeared", failure)
							}
						case "unknown":
							if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodeOutcomeUnknown}) || !errors.Is(failure, boundary.cause) {
								t.Fatal("policy unknown completion was misclassified", failure)
							}
						default:
							if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodePersistence}) || mode == "cleanup" && !errors.Is(failure, boundary.cause) {
								t.Fatal("policy completion failure was hidden", failure)
							}
						}
					}
					// The uncanceled parent and original native backend remain
					// independent of both the failed owner and fault injection.
					if !reflect.DeepEqual(before, f.snapshot(t)) {
						t.Fatal("policy failure changed account, catalog, relation, session, domain or audit rows")
					}
				})
			}
		})
	}
}
