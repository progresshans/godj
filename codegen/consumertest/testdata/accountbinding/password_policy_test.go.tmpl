// Construct the one permitted physical change from the independent writer's
// requested field/value, never from the state observed after a failed command.
func (f *creationInputFixture) passwordPolicyExpectedProfile(t *testing.T, before creationInputState, id int64, field, value string) {
	t.Helper()
	column := -1
	for _, plan := range f.plans {
		if plan.Table() != f.metadata.DBTable {
			continue
		}
		for index, selected := range plan.SourceFields() {
			if selected.Name() == field {
				column = index
			}
		}
	}
	if column < 0 {
		t.Fatal("password policy observation omitted its declared profile attribute")
	}
	matched := 0
	for _, row := range before[f.metadata.DBTable] {
		if row[f.keys[f.metadata.DBTable]] == id {
			row[column] = value
			matched++
		}
	}
	if matched != 1 {
		t.Fatal("password policy observation did not identify exactly one target")
	}
}

func TestAccountDefaultPasswordPolicyCurrentProfile(t *testing.T) {
	for _, mode := range []string{"final", "cleanup", "swallowed", "unknown"} {
		creationInputRun(t, mode, func(t *testing.T) {
			f := newCreationInputFixture(t, false)
			target := f.passwordPolicyTarget(t)
			const field, raw = "@@PROFILE@@", "Zebracascade"
			policy, err := f.binding.DefaultPasswordValidator(accountmodel.PasswordAttribute{Field: field, Label: "profile"})
			creationInputCheck(t, err)
			boundary := &accountPolicyBoundary{Backend: f.native, mode: mode, cause: errors.New("private current-profile rollback cleanup")}
			if mode == "unknown" {
				boundary.cause = &query.Error{Code: query.CodeCommitOutcomeUnknown, Detail: "private current-profile outcome"}
			}
			var observed []string
			var scopes []int64
			config := f.config
			config.Accounts.ValidatePassword = func(ctx context.Context, secret string, profile orm.ModelView[usernameAccount]) (validation.Errors, error) {
				value, loaded := profile.Get(field)
				text, textual := value.String()
				encoded, _ := profile.Get(f.role.Password)
				hash, validHash := encoded.String()
				if !loaded || !textual || !validHash || hash != "" || secret != raw {
					return validation.Errors{}, errors.New("current-profile policy lost selected values or received a credential")
				}
				observed = append(observed, text)
				scopes = append(scopes, boundary.scopes.Load())
				return policy(ctx, secret, profile)
			}
			owner, err := project.NewAccountRuntime(t.Context(), boundary, f.hasher, auth.PrincipalAuthorizer{}, config)
			creationInputCheck(t, err)
			peer, err := database.Open(t.Context(), f.database)
			creationInputCheck(t, err)
			defer func() { creationInputCheck(t, peer.Close()) }()
			before, hashes := f.snapshot(t), f.hasher.calls.Load()
			f.passwordPolicyExpectedProfile(t, before, target.id, field, raw)
			writes := 0
			f.hasher.hook.Store(&creationInputHashHook{run: func(ctx context.Context) error {
				if boundary.scopes.Load() != 0 {
					return errors.New("default password hashing retained a native scope")
				}
				ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
				defer cancel()
				return peer.CoordinatedAtomic(ctx, func(scope db.Session) error {
					changed, err := f.objects.ApplyValues(target.row, map[string]query.Value{field: query.String(raw)})
					if err != nil {
						return err
					}
					// Deliberately keep the same credential and revision. The
					// real default validator must inspect the current profile.
					if err := f.objects.Save(ctx, scope, &changed, orm.UpdateFieldNames[usernameAccount](field)); err != nil {
						return err
					}
					writes++
					return nil
				})
			}})
			defer f.hasher.hook.Store(nil)
			result, failure := owner.Accounts().Passwords().SetPassword(t.Context(), f.actor, target.id, target.revision, raw)
			wantFaults := 1
			if mode == "final" {
				wantFaults = 0
			}
			if result != (accountmodel.PasswordEditResult{}) || failure == nil || writes != 1 || f.hasher.calls.Load() != hashes+1 || boundary.writes != 1 || boundary.callbacks != 1 || boundary.faults != wantFaults || !slices.Equal(observed, []string{"NZ", raw}) || !slices.Equal(scopes, []int64{0, 1}) {
				t.Fatal("current default policy did not observe one independent edit and one password attempt", failure)
			}
			native, nativeRejected := accountmodel.PasswordInputDiagnostics(boundary.nativeError)
			items := native.All()
			if !nativeRejected || len(items) != 1 || items[0].Field() != "password" || items[0].Code() != "password_too_similar" {
				t.Fatal("native rollback did not follow the real default similarity rejection", boundary.nativeError)
			}
			_, rejected := validation.Rejected(failure)
			diagnostics, renderable := accountmodel.PasswordInputDiagnostics(failure)
			if mode == "final" {
				if !rejected || !renderable || !reflect.DeepEqual(diagnostics.All(), items) {
					t.Fatal("confirmed current-profile rejection lost its exact diagnostics")
				}
			} else {
				if rejected || renderable {
					t.Fatal("unconfirmed current-profile rollback became input rejection")
				}
				code := accountmodel.CodeOutcomeUnknown
				if mode == "cleanup" {
					code = accountmodel.CodePersistence
				}
				if !errors.Is(failure, &accountmodel.Error{Code: code}) || mode != "swallowed" && !errors.Is(failure, boundary.cause) || mode == "swallowed" && !errors.Is(failure, &query.Error{Code: query.CodeTransactionOutcomeUnknown}) {
					t.Fatal("current-profile rollback lost its cause or certainty", failure)
				}
			}
			if !reflect.DeepEqual(before, f.snapshot(t)) {
				t.Fatal("rejected password command changed native rows beyond the independent profile edit")
			}
			for _, id := range target.sessions.ids {
				_, found, err := f.runtime.SessionStore().Load(t.Context(), id)
				creationInputCheck(t, err)
				if !found {
					t.Fatal("current-profile rejection revoked a target session")
				}
			}
			_, err = f.runtime.Authenticator().Authenticate(t.Context(), "member", accountPasswordText)
			creationInputCheck(t, err)
			if _, err := f.runtime.Authenticator().Authenticate(t.Context(), "member", raw); !errors.Is(err, auth.ErrInvalidCredentials) {
				t.Fatal("rejected current-profile password was installed", err)
			}
			if !reflect.DeepEqual(before, f.snapshot(t)) {
				t.Fatal("observing a rejected password changed native state")
			}
		})
	}
}

func TestAccountPasswordPolicyAdmission(t *testing.T) {
	for _, mode := range []string{"denied_creation", "stale_password", "omitted_creation_policy", "omitted_password_policy"} {
		creationInputRun(t, mode, func(t *testing.T) {
			f := newCreationInputFixture(t, false)
			target := f.passwordPolicyTarget(t)
			policy, err := f.binding.DefaultPasswordValidator()
			creationInputCheck(t, err)
			calls := 0
			config := f.config
			config.Accounts.ValidatePassword = func(ctx context.Context, raw string, profile orm.ModelView[usernameAccount]) (validation.Errors, error) {
				calls++
				return policy(ctx, raw, profile)
			}
			omitted := strings.HasPrefix(mode, "omitted_")
			if omitted {
				config.Accounts.ValidatePassword = nil
			}
			boundary := &accountPolicyBoundary{Backend: f.native}
			owner, err := project.NewAccountRuntime(t.Context(), boundary, f.hasher, auth.PrincipalAuthorizer{}, config)
			creationInputCheck(t, err)
			before, hashes := f.snapshot(t), f.hasher.calls.Load()
			if mode == "denied_creation" || mode == "omitted_creation_policy" {
				input, err := f.objects.Input(map[string]query.Value{f.role.Login: query.String("PolicyCandidate"), "@@PROFILE@@": query.String("NZ")})
				creationInputCheck(t, err)
				actor := f.actor
				if mode == "denied_creation" {
					actor = target.credential.Principal()
				}
				creator := owner.Accounts().Creator()
				prepared, failure := creator.Prepare(t.Context(), actor, input, "1")
				if omitted {
					creationInputCheck(t, failure)
					result, err := creator.Commit(t.Context(), actor, prepared)
					creationInputCheck(t, err)
					f.saved(t, before, result, "PolicyCandidate", "1", true)
				} else if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodePermission}) || !reflect.DeepEqual(prepared, accountmodel.PreparedCreation[usernameAccount]{}) {
					t.Fatal("weak password hid current creation admission or published a candidate", failure)
				}
			} else {
				revision := target.revision
				if mode == "stale_password" {
					revision++
				}
				result, failure := owner.Accounts().Passwords().SetPassword(t.Context(), f.actor, target.id, revision, "1")
				if omitted {
					creationInputCheck(t, failure)
					if result.ID != target.id || result.Revision != target.revision+1 || result.RevokedSessions != 3 {
						t.Fatal("explicitly omitted policy lost the ordinary credential lifecycle")
					}
					f.passwordChanged(t, before, target.row, target.id, target.revision+1, target.sessions)
					_, err := f.runtime.Authenticator().Authenticate(t.Context(), "member", "1")
					creationInputCheck(t, err)
				} else if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodeConflict}) || result != (accountmodel.PasswordEditResult{}) {
					t.Fatal("weak password hid stale revision or published a password result", failure)
				}
			}
			wantHashes, wantWrites := int64(0), 0
			if omitted {
				wantHashes, wantWrites = 1, 1
			} else if !reflect.DeepEqual(before, f.snapshot(t)) {
				t.Fatal("admission or stale revision rejection changed native state")
			}
			if calls != 0 || f.hasher.calls.Load() != hashes+wantHashes || boundary.writes != wantWrites || boundary.callbacks != wantWrites {
				t.Fatal("policy choice or admission performed unexpected validation, hashing or native writes")
			}
		})
	}
}

// Reopened credentials must also work through an actual TCP login and durable
// browser session. No staff role is needed for this ordinary account route.
func passwordPolicyReopenedHTTP[G, P any](t *testing.T, f *creationInputFixture, selected *accountmodel.Runtime[usernameAccount, G, P], name, raw string) {
	t.Helper()
	runtime, err := websession.New(websession.Config{Sessions: selected.Sessions(), Authenticator: selected.Authenticator(), LoginPersistence: selected.LoginPersistence(), Authorizer: auth.PrincipalAuthorizer{},
		Clock: func() time.Time { return f.now }, SessionCookie: websession.CookieConfig{Path: "/", AllowInsecure: true}, CSRFCookie: websession.CookieConfig{Path: "/", AllowInsecure: true},
		LoginPath: "/login/", FallbackPath: "/who/", AllowedNextPaths: []string{"/who/"}})
	creationInputCheck(t, err)
	routes := []web.Route{
		{Name: "policysession:csrf", Method: "GET", Path: "/login/", Handler: func(request *web.Request) (web.Response, error) {
			token, err := runtime.CSRFToken(request)
			if err != nil {
				return web.Response{}, err
			}
			response, err := web.HTML(200, []byte(token.Value()))
			if err != nil {
				return web.Response{}, err
			}
			return token.Apply(response)
		}},
		{Name: "policysession:login", Method: "POST", Path: "/login/", Handler: func(request *web.Request) (web.Response, error) {
			incoming := request.HTTP()
			incoming.Body = http.MaxBytesReader(nil, incoming.Body, 64<<10)
			if err := incoming.ParseForm(); err != nil {
				return web.Response{}, err
			}
			if err := runtime.VerifyCSRF(request, incoming.PostForm["csrfmiddlewaretoken"]); err != nil {
				return web.NewResponse(403, nil, nil)
			}
			result, err := runtime.Login(request, incoming.PostForm.Get("username"), incoming.PostForm.Get("password"))
			if err == auth.ErrInvalidCredentials {
				return web.NewResponse(401, nil, nil)
			}
			if err != nil {
				return web.Response{}, err
			}
			response, err := web.NewResponse(204, nil, nil)
			if err != nil {
				return web.Response{}, err
			}
			return result.Apply(response)
		}},
		{Name: "policysession:who", Method: "GET", Path: "/who/", Handler: func(request *web.Request) (web.Response, error) {
			principal, err := runtime.Principal(request)
			if err != nil {
				return web.Response{}, err
			}
			if !principal.Authenticated() {
				return web.NewResponse(401, nil, nil)
			}
			return web.HTML(200, []byte(principal.ID()))
		}},
	}
	config, err := settings.New(settings.Definition{ProjectName: "password_policy_reopen", InstalledApps: append(project.InstalledApps(), apps.Config{Name: "example.com/godj-project-bundle/consumer", Label: "policysession"})})
	creationInputCheck(t, err)
	application, err := web.NewApplication(web.Config{Settings: config, Routes: routes})
	creationInputCheck(t, err)
	server := httptest.NewServer(application)
	defer server.Close()
	previous, err := f.objects.Using(f.native).Filter(f.login.Exact(name)).Get(t.Context())
	creationInputCheck(t, err)
	key, present, err := f.objects.PrimaryKey(previous)
	creationInputCheck(t, err)
	id, integer := key.Integer()
	if !present || !integer {
		t.Fatal("reopened login target has no native key")
	}
	credential, err := selected.Authenticator().Authenticate(t.Context(), name, raw)
	creationInputCheck(t, err)
	for _, password := range []string{strings.TrimSpace(raw), raw} {
		jar, err := cookiejar.New(nil)
		creationInputCheck(t, err)
		client := server.Client()
		client.Jar, client.Timeout = jar, 30*time.Second
		client.CheckRedirect = func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }
		browser := &creationInputHTTP{fixture: f, client: client, server: server}
		status, _, token := browser.send(t, "GET", "/login/", nil)
		if status != 200 || len(token) != 128 {
			t.Fatal("reopened policy login lost its real CSRF token")
		}
		before := f.snapshot(t)
		status, _, _ = browser.send(t, "POST", "/login/", url.Values{"username": {name}, "password": {password}, "csrfmiddlewaretoken": {string(token)}})
		if password != raw {
			if status != 401 || !reflect.DeepEqual(before, f.snapshot(t)) {
				t.Fatal("reopened HTTP login accepted trimmed secret or changed durable state", status)
			}
			continue
		}
		if status != 204 {
			t.Fatal("reopened HTTP login rejected the exact saved secret", status)
		}
		status, _, body := browser.send(t, "GET", "/who/", nil)
		if status != 200 || string(body) != credential.Principal().ID() {
			t.Fatal("reopened browser session did not resolve the saved account", status)
		}
		address, err := url.Parse(server.URL)
		creationInputCheck(t, err)
		var sessionID sessions.ID
		for _, cookie := range jar.Cookies(address) {
			if cookie.Name == websession.DefaultSessionCookieName {
				sessionID, err = sessions.ParseID(cookie.Value)
				creationInputCheck(t, err)
			}
		}
		record, found, err := selected.SessionStore().Load(t.Context(), sessionID)
		creationInputCheck(t, err)
		principal, _ := record.Value(auth.SessionPrincipalIDKey)
		stamp, _ := record.Value(auth.SessionCredentialStampKey)
		if !sessionID.Valid() || !found || principal != credential.Principal().ID() || stamp != credential.SessionStamp() {
			t.Fatal("reopened HTTP login omitted its durable credential-bound session")
		}
		current, err := f.objects.Using(f.native).Filter(f.key.Exact(id)).Get(t.Context())
		creationInputCheck(t, err)
		fields := map[string]query.Value{}
		if f.role.LastLogin != "" {
			fields[f.role.LastLogin] = query.DateTime(f.now)
		}
		expected, err := f.objects.ApplyValues(previous, fields)
		creationInputCheck(t, err)
		if !reflect.DeepEqual(current, expected) {
			t.Fatal("reopened HTTP login changed profile/revision or lost LastLogin")
		}
		after := f.snapshot(t)
		accountTable := f.metadata.DBTable
		for index, row := range after[accountTable] {
			if row[f.keys[accountTable]] == id {
				for _, original := range before[accountTable] {
					if original[f.keys[accountTable]] == id {
						after[accountTable][index] = original
					}
				}
			}
		}
		sessionTable := (sessionmodels.SessionDescriptor{}).Metadata().DBTable
		known := make(map[any]bool)
		for _, row := range before[sessionTable] {
			known[row[f.keys[sessionTable]]] = true
		}
		retained := make([][]any, 0, len(before[sessionTable]))
		added := 0
		for _, row := range after[sessionTable] {
			if known[row[f.keys[sessionTable]]] {
				retained = append(retained, row)
			} else {
				added++
			}
		}
		after[sessionTable] = retained
		if added != 1 || !reflect.DeepEqual(before, after) {
			t.Fatal("reopened HTTP login changed unrelated account, catalog, session, domain or audit rows")
		}
	}
}
