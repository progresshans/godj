// The selected model's default strength policy runs through the real Admin
// create/password routes, including renamed login fields and private inputs.
func TestAccountAdminDefaultPasswordPolicy(t *testing.T) {
	for _, operation := range []string{"create", "password"} {
		creationInputRun(t, operation, func(t *testing.T) {
			f := newCreationInputFixture(t, false)
			member, err := f.objects.Using(f.native).Filter(f.login.Exact("member")).Get(t.Context())
			creationInputCheck(t, err)
			key, present, err := f.objects.PrimaryKey(member)
			creationInputCheck(t, err)
			id, integer := key.Integer()
			if !present || !integer {
				t.Fatal("default policy target has no stored identity")
			}
			initial, err := f.runtime.Accounts().Passwords().SetPassword(t.Context(), f.actor, id, 1, accountPasswordText)
			creationInputCheck(t, err)
			credential, err := f.runtime.Authenticator().Authenticate(t.Context(), "member", accountPasswordText)
			creationInputCheck(t, err)
			beforeSessionRows, err := sessionmodels.SessionObjects.Using(f.native).OrderBy(sessionmodels.SessionFields.ID.Asc()).All(t.Context())
			creationInputCheck(t, err)
			priorSessionKeys := make(map[int64]bool)
			for _, row := range beforeSessionRows {
				priorSessionKeys[row.ID] = true
			}
			var targetSessions []sessions.ID
			for range 3 {
				record, err := f.runtime.Sessions().Create(t.Context(), map[string]string{auth.SessionPrincipalIDKey: credential.Principal().ID(), auth.SessionCredentialStampKey: credential.SessionStamp(), "preserve": "target"})
				creationInputCheck(t, err)
				targetSessions = append(targetSessions, record.ID())
			}
			seededRows, err := sessionmodels.SessionObjects.Using(f.native).OrderBy(sessionmodels.SessionFields.ID.Asc()).All(t.Context())
			creationInputCheck(t, err)
			targetSessionKeys := make(map[int64]bool)
			for _, row := range seededRows {
				if !priorSessionKeys[row.ID] {
					targetSessionKeys[row.ID] = true
				}
			}
			if len(seededRows) != len(beforeSessionRows)+3 || len(targetSessionKeys) != 3 {
				t.Fatal("target session fixture did not create three physical rows")
			}
			actorCredential, err := f.runtime.Authenticator().Resolve(t.Context(), f.actor.ID())
			creationInputCheck(t, err)
			_, err = f.runtime.Sessions().Create(t.Context(), map[string]string{auth.SessionPrincipalIDKey: f.actor.ID(), auth.SessionCredentialStampKey: actorCredential.SessionStamp(), "preserve": "actor"})
			creationInputCheck(t, err)
			_, err = f.runtime.Sessions().Create(t.Context(), map[string]string{"preserve": "anonymous"})
			creationInputCheck(t, err)

			attributes := []accountmodel.PasswordAttribute{{Field: f.role.Login, Label: "username"}}
			policy, err := f.binding.DefaultPasswordValidator(attributes...)
			creationInputCheck(t, err)
			// The caller cannot redirect an already-constructed policy to a
			// credential column by mutating its declaration slice.
			attributes[0].Field = f.role.Password
			var calls atomic.Int64
			config := f.config
			config.Accounts.ValidatePassword = func(ctx context.Context, raw string, profile orm.ModelView[usernameAccount]) (validation.Errors, error) {
				calls.Add(1)
				secret, _ := profile.Get(f.role.Password)
				if encoded, _ := secret.String(); encoded != "" {
					return validation.Errors{}, errors.New("default strength policy received a credential")
				}
				return policy(ctx, raw, profile)
			}
			f.runtime, err = project.NewAccountRuntime(t.Context(), f.native, f.hasher, auth.PrincipalAuthorizer{}, config)
			creationInputCheck(t, err)
			h := f.admin(t)
			endpoint, name := "/admin/accounts/add/", "Candidate"
			first, second := f.form(t, "admin_enabled").PasswordFields().First, f.form(t, "admin_enabled").PasswordFields().Confirmation
			if operation == "password" {
				endpoint, name = "/admin/accounts/command/password/?id="+strconv.FormatInt(id, 10), "member"
				first, second = "password1", "password2"
			}
			input := func(t *testing.T, raw string) url.Values {
				t.Helper()
				if operation == "create" {
					return h.choiceData(t, name, raw, raw, "false")
				}
				status, _, page := h.send(t, "GET", endpoint, nil)
				token := creationInputToken.FindSubmatch(page)
				if status != 200 || len(token) != 2 {
					t.Fatal("password command did not render its own form", status)
				}
				return url.Values{first: {raw}, second: {raw}, "expected_revision": {strconv.FormatInt(initial.Revision, 10)}, "csrfmiddlewaretoken": {string(token[1])}}
			}
			for _, probe := range []struct {
				name, password string
				codes          []string
			}{
				{"short", "Ａ９", []string{"password_too_short"}},
				{"common", " PASSWORD ", []string{"password_too_common"}},
				{"numeric", "¹²³⁴⁵⁶⁷⁸", []string{"password_entirely_numeric"}},
				{"similarity", name + "12", []string{"password_too_similar"}},
				{"combined", "123", []string{"password_too_short", "password_too_common", "password_entirely_numeric"}},
			} {
				creationInputRun(t, probe.name, func(t *testing.T) {
					data := input(t, probe.password)
					before, hashes, ids, policies := f.snapshot(t), f.hasher.calls.Load(), f.ids.Load(), calls.Load()
					status, headers, body := h.send(t, "POST", endpoint, data)
					var codes []string
					for _, match := range regexp.MustCompile(`data-error-field="([^"]+)" data-error-code="([^"]+)"`).FindAllSubmatch(body, -1) {
						if string(match[1]) != second {
							t.Fatal("default password policy escaped its command namespace")
						}
						codes = append(codes, string(match[2]))
					}
					widgets := 0
					for _, field := range regexp.MustCompile(`<input\b[^>]*>`).FindAll(body, -1) {
						if !strings.Contains(string(field), `name="`+first+`"`) && !strings.Contains(string(field), `name="`+second+`"`) {
							continue
						}
						widgets++
						value := regexp.MustCompile(`value="([^"]*)"`).FindSubmatch(field)
						if len(value) != 0 && len(value[1]) != 0 {
							t.Fatal("default policy redisplayed a password")
						}
					}
					if status != 200 || headers.Get("Location") != "" || headers.Get("Cache-Control") != "no-store" || widgets != 2 || !slices.Equal(codes, probe.codes) || calls.Load() != policies+1 || f.hasher.calls.Load() != hashes || f.ids.Load() != ids || !reflect.DeepEqual(before, f.snapshot(t)) {
						t.Fatal("default policy order, private widgets or pre-hash rejection differed", operation, probe.name, status, codes)
					}
				})
			}
			creationInputRun(t, "success_and_reopen", func(t *testing.T) {
				const raw = "  retained selected Admin secret  "
				data := input(t, raw)
				before, hashes, ids, policies := f.snapshot(t), f.hasher.calls.Load(), f.ids.Load(), calls.Load()
				previous, err := f.objects.Using(f.native).Filter(f.key.Exact(id)).Get(t.Context())
				creationInputCheck(t, err)
				previousValues, err := f.objects.ModelValues(previous)
				creationInputCheck(t, err)
				status, headers, _ := h.send(t, "POST", endpoint, data)
				if status != 302 || headers.Get("Location") == "" || f.hasher.calls.Load() != hashes+1 {
					t.Fatal("default policy success did not commit once", status)
				}
				if operation == "create" {
					f.choiceSaved(t, before, name, raw, true)
					if calls.Load() != policies+4 || f.ids.Load() != ids+1 {
						t.Fatal("default creation policy lost a final fence or repeated identity work")
					}
				} else {
					current, err := f.objects.Using(f.native).Filter(f.key.Exact(id)).Get(t.Context())
					creationInputCheck(t, err)
					values, err := f.objects.ModelValues(current)
					creationInputCheck(t, err)
					revision, _ := values[f.role.Revision].Integer()
					encoded, _ := values[f.role.Password].String()
					preserved, err := f.objects.ApplyValues(current, map[string]query.Value{f.role.Password: previousValues[f.role.Password], f.role.Revision: previousValues[f.role.Revision]})
					creationInputCheck(t, err)
					if revision != initial.Revision+1 || !reflect.DeepEqual(preserved, previous) || calls.Load() != policies+2 || f.ids.Load() != ids {
						t.Fatal("default password change overwrote profile or omitted a policy fence")
					}
					matched, err := f.hasher.Verify(t.Context(), raw, encoded)
					creationInputCheck(t, err)
					if !matched {
						t.Fatal("default policy changed retained password bytes")
					}
					for _, session := range targetSessions {
						_, found, err := f.runtime.SessionStore().Load(t.Context(), session)
						creationInputCheck(t, err)
						if found {
							t.Fatal("default password change retained a target session")
						}
					}
					after := f.snapshot(t)
					if len(after[f.metadata.DBTable]) != len(before[f.metadata.DBTable]) {
						t.Fatal("password change altered account row cardinality")
					}
					for index, row := range before[f.metadata.DBTable] {
						if row[f.keys[f.metadata.DBTable]] == id {
							after[f.metadata.DBTable][index] = row
						}
					}
					sessionTable := (sessionmodels.SessionDescriptor{}).Metadata().DBTable
					expectedSessions := make([][]any, 0, len(before[sessionTable]))
					for _, row := range before[sessionTable] {
						key, valid := row[f.keys[sessionTable]].(int64)
						if !valid {
							t.Fatal("physical session identity lost its integer type")
						}
						if !targetSessionKeys[key] {
							expectedSessions = append(expectedSessions, row)
						}
					}
					before[sessionTable] = expectedSessions
					events, err := auditmodels.EventObjects.Using(f.native).OrderBy(auditmodels.EventFields.ID.Asc()).All(t.Context())
					creationInputCheck(t, err)
					auditTable := (auditmodels.EventDescriptor{}).Metadata().DBTable
					if len(events) != len(before[auditTable])+1 || len(after[auditTable]) != len(events) {
						t.Fatal("default password change omitted or duplicated an audit")
					}
					event := events[len(events)-1]
					domain, _ := f.actor.CredentialDomain()
					var fields []string
					creationInputCheck(t, json.Unmarshal([]byte(event.ChangedFields), &fields))
					if event.Domain != domain.Identifier() || event.ActorID != f.actor.ID() || event.Model != f.role.Model.AppLabel+"."+f.role.Model.ModelName || event.ObjectID != id || event.Action != string(admin.ActionChange) || !event.RecordedAt.Equal(f.now) || !slices.Equal(fields, []string{f.role.Password}) {
						t.Fatal("default password change lost exact audit ownership")
					}
					after[auditTable] = after[auditTable][:len(before[auditTable])]
					if !reflect.DeepEqual(before, after) {
						t.Fatal("default password change modified unrelated native rows")
					}
				}
				peer, err := database.Open(t.Context(), f.database)
				creationInputCheck(t, err)
				defer func() { creationInputCheck(t, peer.Close()) }()
				reopened, err := project.NewAccountRuntime(t.Context(), peer, f.hasher, auth.PrincipalAuthorizer{}, config)
				creationInputCheck(t, err)
				_, err = reopened.Authenticator().Authenticate(t.Context(), name, raw)
				creationInputCheck(t, err)
				for _, rejected := range []string{strings.TrimSpace(raw), accountPasswordText} {
					if _, err := reopened.Authenticator().Authenticate(t.Context(), name, rejected); !errors.Is(err, auth.ErrInvalidCredentials) {
						t.Fatal("reopened credential accepted altered or previous secret", err)
					}
				}
			})
		})
	}
}

// Keep native rollback, then vary only its reported completion. A confirmed
// policy rejection is renderable; joined cleanup, swallowed failure and an
// unknown outcome must remain execution failures with no provisional result.
type accountPolicyBoundary struct {
	database.Backend
	mode                      string
	writes, callbacks, faults int
	cause                     error
}

func (boundary *accountPolicyBoundary) complete(err error) error {
	if _, rejected := accountmodel.PasswordInputDiagnostics(err); !rejected {
		return err
	}
	switch boundary.mode {
	case "cleanup":
		boundary.faults++
		return errors.Join(err, boundary.cause)
	case "swallowed":
		boundary.faults++
		return nil
	case "unknown":
		boundary.faults++
		return errors.Join(err, boundary.cause)
	default:
		return err
	}
}

func (boundary *accountPolicyBoundary) CoordinatedAtomic(ctx context.Context, callback func(db.Session) error) error {
	boundary.writes++
	return boundary.complete(boundary.Backend.CoordinatedAtomic(ctx, func(scope db.Session) error {
		boundary.callbacks++
		return callback(scope)
	}))
}

func (boundary *accountPolicyBoundary) CoordinatedAtomicRelation(ctx context.Context, callback func(db.RelationSession) error) error {
	boundary.writes++
	return boundary.complete(boundary.Backend.CoordinatedAtomicRelation(ctx, func(scope db.RelationSession) error {
		boundary.callbacks++
		return callback(scope)
	}))
}

func TestAccountPasswordPolicyBoundaries(t *testing.T) {
	for _, operation := range []string{"create", "password"} {
		creationInputRun(t, operation, func(t *testing.T) {
			f := newCreationInputFixture(t, false)
			member, err := f.objects.Using(f.native).Filter(f.login.Exact("member")).Get(t.Context())
			creationInputCheck(t, err)
			key, present, err := f.objects.PrimaryKey(member)
			creationInputCheck(t, err)
			id, integer := key.Integer()
			if !present || !integer {
				t.Fatal("policy target has no key")
			}
			changed, err := f.runtime.Accounts().Passwords().SetPassword(t.Context(), f.actor, id, 1, accountPasswordText)
			creationInputCheck(t, err)
			if changed.ID != id || changed.Revision != 2 {
				t.Fatal("policy target was not provisioned")
			}
			credential, err := f.runtime.Authenticator().Authenticate(t.Context(), "member", accountPasswordText)
			creationInputCheck(t, err)
			for range 3 {
				_, err := f.runtime.Sessions().Create(t.Context(), map[string]string{auth.SessionPrincipalIDKey: credential.Principal().ID(), auth.SessionCredentialStampKey: credential.SessionStamp(), "preserve": "target"})
				creationInputCheck(t, err)
			}
			actorCredential, err := f.runtime.Authenticator().Resolve(t.Context(), f.actor.ID())
			creationInputCheck(t, err)
			_, err = f.runtime.Sessions().Create(t.Context(), map[string]string{auth.SessionPrincipalIDKey: f.actor.ID(), auth.SessionCredentialStampKey: actorCredential.SessionStamp(), "preserve": "actor"})
			creationInputCheck(t, err)
			_, err = f.runtime.Sessions().Create(t.Context(), map[string]string{"preserve": "anonymous"})
			creationInputCheck(t, err)
			for _, mode := range []string{"preflight", "final", "cleanup", "swallowed", "unknown", "cancel_preflight", "cancel_final"} {
				creationInputRun(t, mode, func(t *testing.T) {
					boundary := &accountPolicyBoundary{Backend: f.native, mode: mode, cause: errors.New("private-policy-cleanup")}
					if mode == "unknown" {
						boundary.cause = &query.Error{Code: query.CodeCommitOutcomeUnknown, Detail: "private-policy-outcome"}
					}
					ctx, cancel := context.WithCancel(t.Context())
					defer cancel()
					calls := 0
					config := f.config
					config.Accounts.ValidatePassword = func(_ context.Context, raw string, profile orm.ModelView[usernameAccount]) (validation.Errors, error) {
						calls++
						source, valid := profile.Model()
						value, loaded := profile.Get(f.role.Login)
						name, textual := value.String()
						wantName := "member"
						if operation == "create" {
							wantName = "Candidate"
						}
						secret, hasSecret := profile.Get(f.role.Password)
						encoded, stringSecret := secret.String()
						if !valid || !source.Equal(f.metadata) || !loaded || !textual || name != wantName || !hasSecret || !stringSecret || encoded != "" || raw != "  replacement secret  " {
							t.Fatal("policy lost its typed profile or received a credential")
						}
						if calls == 1 && mode != "preflight" && mode != "cancel_preflight" {
							return validation.Errors{}, nil
						}
						if mode == "cancel_preflight" || mode == "cancel_final" {
							cancel()
						}
						return validation.NewErrors(validation.New("password", "policy_rejected")), nil
					}
					owner, err := project.NewAccountRuntime(t.Context(), boundary, f.hasher, auth.PrincipalAuthorizer{}, config)
					creationInputCheck(t, err)
					before, hashes := f.snapshot(t), f.hasher.calls.Load()
					var failure error
					if operation == "create" {
						// Preserve the same selected profile as the rest of this
						// consumer without guessing a custom model's field name.
						values := map[string]query.Value{f.role.Login: query.String("Candidate")}
						for _, field := range config.Accounts.CreateFields {
							if field != f.role.Login {
								values[field] = query.String("NZ")
							}
						}
						input, err := f.objects.Input(values)
						creationInputCheck(t, err)
						creator := owner.Accounts().Creator()
						prepared, err := creator.Prepare(ctx, f.actor, input, "  replacement secret  ")
						failure = err
						if err == nil {
							result, err := creator.Commit(ctx, f.actor, prepared)
							failure = err
							if !reflect.DeepEqual(result, accountmodel.Creation{}) {
								t.Fatal("failed policy published a creation receipt")
							}
							// A final refusal consumes the same prepared attempt,
							// including uncertain completion. Never replay it.
							replayed, replayError := creator.Commit(t.Context(), f.actor, prepared)
							if !errors.Is(replayError, &accountmodel.Error{Code: accountmodel.CodeConflict}) || !reflect.DeepEqual(replayed, accountmodel.Creation{}) {
								t.Fatal("failed prepared creation was replayable", replayError)
							}
						} else {
							result, invalid := creator.Commit(t.Context(), f.actor, prepared)
							if !errors.Is(invalid, &accountmodel.Error{Code: accountmodel.CodeInvalidInput}) || !reflect.DeepEqual(result, accountmodel.Creation{}) {
								t.Fatal("failed preparation published a usable candidate", invalid)
							}
						}
					} else {
						result, err := owner.Accounts().Passwords().SetPassword(ctx, f.actor, id, changed.Revision, "  replacement secret  ")
						failure = err
						if result != (accountmodel.PasswordEditResult{}) {
							t.Fatal("failed policy published a password receipt")
						}
					}
					wantCalls, wantWrites, wantHashes, wantFaults := 2, 1, int64(1), 0
					if mode == "preflight" || mode == "cancel_preflight" {
						wantCalls, wantWrites, wantHashes = 1, 0, 0
					}
					if mode == "cleanup" || mode == "swallowed" || mode == "unknown" {
						wantFaults = 1
					}
					if failure == nil || calls != wantCalls || boundary.writes != wantWrites || boundary.callbacks != wantWrites || boundary.faults != wantFaults || f.hasher.calls.Load()-hashes != wantHashes {
						t.Fatal("policy phase, hash or native attempt differs", failure, calls, boundary.writes, boundary.callbacks, boundary.faults, f.hasher.calls.Load()-hashes)
					}
					diagnostics, credentialRejection := accountmodel.PasswordInputDiagnostics(failure)
					_, rejected := validation.Rejected(failure)
					if mode == "preflight" || mode == "final" {
						if !credentialRejection || !rejected || !reflect.DeepEqual(diagnostics.All(), []validation.Violation{validation.New("password", "policy_rejected")}) {
							t.Fatal("confirmed password rejection lost its origin", failure)
						}
					} else {
						if credentialRejection || rejected {
							t.Fatal("unconfirmed or canceled policy became renderable input", failure)
						}
						switch mode {
						case "cancel_preflight", "cancel_final":
							if !errors.Is(failure, context.Canceled) {
								t.Fatal("policy cancellation cause disappeared", failure)
							}
						case "unknown":
							if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodeOutcomeUnknown}) || !errors.Is(failure, boundary.cause) {
								t.Fatal("policy unknown completion was misclassified", failure)
							}
						case "swallowed":
							// The owner cannot confirm a rollback when the backend
							// reports success after a rejected callback. Keep the
							// shared atomic-result contract's uncertain outcome.
							if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodeOutcomeUnknown}) || !errors.Is(failure, &query.Error{Code: query.CodeTransactionOutcomeUnknown}) {
								t.Fatal("swallowed callback lost its unknown outcome", failure)
							}
						default:
							if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodePersistence}) || mode == "cleanup" && !errors.Is(failure, boundary.cause) {
								t.Fatal("policy completion failure was hidden", failure)
							}
						}
					}
					// The uncanceled parent and original native backend remain
					// independent of both the failed owner and fault injection.
					if !reflect.DeepEqual(before, f.snapshot(t)) {
						t.Fatal("policy failure changed account, catalog, relation, session, domain or audit rows")
					}
				})
			}
		})
	}
}
