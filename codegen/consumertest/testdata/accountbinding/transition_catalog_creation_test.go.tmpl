  if left.EncodedPassword!=""||right.SecretHash!=""{t.Error("catalog allocation exposed password encoding to policy")}
  groupPending,permissionPending:=b.PendingCatalogKeys()
  if groupPending||permissionPending{
   state.pending.Add(1)
   if groupPending!=(f.role.Catalog.Group.AppLabel!="godj_identity")||permissionPending!=(f.role.Catalog.Permission.AppLabel!="godj_identity"){t.Error("catalog pending state lost its namespace")}
   if groupPending&&len(b.Groups())!=0||permissionPending&&len(b.Permissions())!=0{t.Error("review policy received anticipated target keys")}
  }else{
   state.resolved.Add(1)
   if mode!="explicit_empty"{
    group:=f.sourceGroup
    if f.role.Catalog.Group.AppLabel!="godj_identity"{source,err:=models.GroupObjects.Using(scope).Filter(models.GroupFields.ID.Exact(f.sourceGroup)).Get(t.Context());if err!=nil{return validation.Errors{},err};row,err:=catalog.TeamObjects.Using(scope).Filter(catalog.TeamFields.Title.Exact("created "+source.Name)).Get(t.Context());if err!=nil{return validation.Errors{},err};group=row.ID}
    if !slices.Equal(b.Groups(),[]int64{group}){t.Error("final account policy did not receive actual catalog keys")}
   }
  }
  if keys:=a.Groups();len(keys)!=0{keys[0]=99999};if keys:=b.Groups();len(keys)!=0{keys[0]=99999}
  if state.policy.Load(){return validation.NewErrors(validation.New(validation.NonField,"catalog_creation_policy")),nil};return validation.Errors{},nil
 }
 return f,state
}

