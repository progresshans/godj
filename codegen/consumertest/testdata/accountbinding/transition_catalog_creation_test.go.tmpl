 creation,err:=ccBuild(t,f,state,mode)
 if buildRejected{if err==nil{t.Fatal("invalid typed catalog input admitted")};if f.backend.snapshots.Load()!=reads||!reflect.DeepEqual(before,ccSnapshot(t,f.native)){t.Fatal("input rejection performed I/O or mutation")};return};ctMust(t,err)
 f.config.CatalogCreation=creation
 if mode=="catalog_limit"{f.config.MaxCatalogRows=1}
 f.owner,err=accountmodel.NewTransition(f.oldStore,f.nextStore,f.config);ctMust(t,err)
 if mode=="target_group_present"{_,err=catalog.TeamObjects.Create(t.Context(),f.native,catalog.NewTeamCreate("existing target"));ctMust(t,err)}
 if mode=="target_permission_present"{_,err=catalog.GrantObjects.Create(t.Context(),f.native,catalog.NewGrantCreate("app.existing","existing target"));ctMust(t,err)}
 if mode=="read_cleanup"{f.backend.mode=mode}
 prepareContext:=t.Context();if mode=="canceled"{var cancel context.CancelFunc;prepareContext,cancel=context.WithCancel(prepareContext);cancel()}
 before=ccSnapshot(t,f.native);completed:=f.backend.completed.Load();reads=f.backend.snapshots.Load()
