func ccClear[M any](t *testing.T, backend database.Backend, objects orm.Manager[M]) {
 t.Helper();key,err:=objects.PrimaryKeyField();ctMust(t,err)
 rows,err:=objects.Using(backend).OrderBy(orm.NewAutoField[M](key).Asc()).All(t.Context());ctMust(t,err)
 for _,row:=range rows{_,err:=objects.Delete(t.Context(),backend,&row);ctMust(t,err)}
}

