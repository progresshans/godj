 row,err:=host.CatalogBadgeObjects.Using(scope).Filter(host.CatalogBadgeFields.ID.Exact(state.badge.ID)).Get(t.Context());ctMust(t,err);want:=state.badge;want.GroupID=&group;want.PermissionID=&permission;if !reflect.DeepEqual(row,want){t.Fatal("catalog OneToOne lost identity")};crAudit(t,f,scope,"host.catalog_badge",row.ID,true,"group","permission")
 collections,err:=project.BindCollections();ctMust(t,err)
 groupQuery,err:=collections.HostWorkspaceGroups.From(scope,state.workspace);ctMust(t,err);groupRows,err:=groupQuery.All(t.Context());ctMust(t,err)
 permissionQuery,err:=collections.HostWorkspacePermissions.From(scope,state.workspace);ctMust(t,err);permissionRows,err:=permissionQuery.All(t.Context());ctMust(t,err)
 memberQuery,err:=collections.HostWorkspaceMembers.From(scope,state.workspace);ctMust(t,err);memberRows,err:=memberQuery.All(t.Context());ctMust(t,err)
 if len(groupRows)!=2||len(permissionRows)!=2||len(memberRows)!=2||slices.ContainsFunc(groupRows,func(row catalog.Team)bool{return row.ID!=group})||slices.ContainsFunc(permissionRows,func(row catalog.Grant)bool{return row.ID!=permission}){t.Fatal("business collection projection lost duplicate rows or used a source namespace")}
