 if prepareRejected{
  if err==nil||prepared.Manifest().Version!=0{t.Fatal("refused preparation exposed a commit capability",err)}
  if !reflect.DeepEqual(before,ccSnapshot(t,f.native))||f.backend.completed.Load()!=completed{t.Fatal("refused preparation mutated native state")}
  if mode=="canceled"&&f.backend.snapshots.Load()!=reads{t.Fatal("canceled preparation opened a snapshot")}
  if strings.Contains(mode,"catalog_grant")&&(state.pending.Load()!=0||state.catalogChecks.Load()!=0){t.Fatal("denied catalog creation ran application policy")}
  return
 }
 ctMust(t,err)
 retained:=prepared.Manifest()
 if retained.Version!=7||retained.Catalog!=nil||retained.CatalogCreation==nil||len(retained.CatalogCreation.Groups)!=len(state.groups)||len(retained.CatalogCreation.Permissions)!=len(state.permissions){t.Fatal("creation review lacks complete catalog source evidence")}
 if state.pending.Load()<2||f.backend.completed.Load()!=completed||!reflect.DeepEqual(before,ccSnapshot(t,f.native)){t.Fatal("read-only review wrote or omitted pending-key policy")}
 if mode=="owned_manifest"{
  changed:=prepared.Manifest();changed.CatalogCreation.Groups[0].ID=999;changed.CatalogCreation.Permissions[0].TargetRevision=78
  if !reflect.DeepEqual(retained,prepared.Manifest()){t.Fatal("manifest mutation changed retained evidence")}
 }
 switch mode{
 case "source_catalog_changed":ctMust(t,ctPatchIn(t.Context(),f.native,models.GroupObjects,state.groups[len(state.groups)-1],map[string]query.Value{"name":query.String("later source profile")}))
 case "source_added":_,err=models.GroupObjects.Create(t.Context(),f.native,models.NewGroupCreate("later source group"));ctMust(t,err)
 case "source_deleted":row:=state.groups[len(state.groups)-1];_,err=models.GroupObjects.Delete(t.Context(),f.native,&row);ctMust(t,err)
 case "source_account_changed":ctMust(t,ctPatchIn(t.Context(),f.native,models.UserObjects,f.oldRows[1],map[string]query.Value{"first_name":query.String("later source account")}))
 case "target_account_changed":ctMust(t,ctPatchIn(t.Context(),f.native,members.MemberObjects,f.newRows[0],map[string]query.Value{"first_name":query.String("later staged account")}))
 case "target_added":_,err=catalog.TeamObjects.Create(t.Context(),f.native,catalog.NewTeamCreate("late target"));ctMust(t,err)
 case "permission_revoked":ctMust(t,ctPatchIn(t.Context(),f.native,models.UserObjects,f.oldRows[0],map[string]query.Value{"active":query.Boolean(false)}))
 case "policy_changed":state.policy.Store(true)
 }
 before=ccSnapshot(t,f.native)
 if mode=="concurrent"{ccConcurrent(t,f,state,prepared,retained);return}
 ccInstallFaults(t,f,state,mode)
 result,err:=f.owner.Commit(t.Context(),f.actor,prepared)
 unknown:=mode=="unknown_commit"||mode=="unknown_rollback"
 if unknown{
  var outcome *query.Error
  if !errors.As(err,&outcome)||outcome.Code!=query.CodeCommitOutcomeUnknown||result.Catalog!=nil||len(result.Mappings)!=0||result.Ownership.OperationID()!=""||result.CreatedGroups!=0||result.CreatedPermissions!=0||result.CreatedAccounts!=0{t.Fatal("unknown outcome published allocated identities",err)}
  if f.backend.completed.Load()!=completed+1{t.Fatal("unknown injection did not complete the native callback exactly once")}
 }else if commitRejected{
  if err==nil||result.Catalog!=nil||result.Ownership.OperationID()!=""{t.Fatal("refused commit published partial catalog creation",err)}
 }else{ctMust(t,err)}
 injected:=slices.Contains([]string{"permission_insert_failure","group_insert_failure","grant_insert_failure","account_insert_failure","account_link_failure","audit_failure","mapping_failure","receipt_failure","rollback","late_catalog_change","late_catalog_grant","unowned_incoming","late_account_change","late_policy_change","final_policy_receipt_change","host_write_failure","host_late_change","final_policy_host_change"},mode)
 if injected&&f.backend.faults.Load()==0{t.Fatal("negative control never reached its native write boundary")}
 f.backend.mode="";f.backend.afterInsert=nil;f.backend.afterUpdate=nil;f.backend.afterConflict=nil
