func testAccountCatalogCreation(t *testing.T,strategy,mode string){
 f,state:=ccSetup(t,strategy,mode)
 if mode=="configuration"{ccConfiguration(t,f,state);return}
 buildRejected:=slices.Contains([]string{"duplicate_source","protected_code","protected_revision","target_key","collection_input"},mode)
 prepareRejected:=slices.Contains([]string{"missing_source","source_revision","catalog_limit","invalid_label","target_group_present","target_permission_present","missing_catalog_grant","additional_catalog_grant","read_cleanup","canceled"},mode)
 commitRejected:=slices.Contains([]string{"duplicate_label","source_catalog_changed","source_added","source_deleted","source_account_changed","target_added","target_account_changed","permission_revoked","policy_changed","permission_insert_failure","group_insert_failure","grant_insert_failure","account_insert_failure","account_link_failure","audit_failure","mapping_failure","receipt_failure","rollback","late_catalog_change","late_catalog_grant","unowned_incoming","late_account_change","late_policy_change","final_policy_receipt_change","host_write_failure","host_late_change","final_policy_host_change","unknown_rollback"},mode)
 success:=slices.Contains([]string{"lifecycle","shared_group","shared_permission","page_boundary","explicit_empty","signed_keys","factory","owned_input","owned_manifest","host_references","schema_lifecycle","unknown_commit","concurrent","reconcile_after_edit","stored_mapping_rewrite"},mode)
 if !buildRejected&&!prepareRejected&&!commitRejected&&!success{t.Fatal("unowned catalog creation case",mode)}
