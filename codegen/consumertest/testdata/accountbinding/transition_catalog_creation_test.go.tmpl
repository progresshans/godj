 state:=&ccState{groupGrants:make(map[int64][]int64)}
 if slices.Contains([]string{"host_references","host_write_failure","host_late_change","final_policy_host_change","schema_lifecycle"},mode){
  state.hostGroup,_,state.hostPermission,_=crSeedCatalog(t,f,"lifecycle")
