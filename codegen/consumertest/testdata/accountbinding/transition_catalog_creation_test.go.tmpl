 if commitRejected{
  if mode=="duplicate_label"&&(state.permissionWrites.Load()!=int32(len(state.permissions))||state.groupWrites.Load()!=1){t.Fatal("uniqueness refusal did not follow real provisional catalog inserts")}
  if !reflect.DeepEqual(before,ccSnapshot(t,f.native)){t.Fatal("failed catalog/account/host write did not roll back every durable row")}
  if _,found,err:=f.owner.Reconcile(t.Context(),retained);err!=nil||found{t.Fatal("rolled-back creation acquired a receipt",err)}
  return
 }
 receipt:=result.Ownership
 if mode=="unknown_commit"{var found bool;receipt,found,err=f.owner.Reconcile(t.Context(),retained);ctMust(t,err);if !found{t.Fatal("committed unknown catalog allocation could not be reconciled")}}
