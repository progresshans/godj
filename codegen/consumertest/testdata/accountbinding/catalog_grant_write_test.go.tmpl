type grantHTTPClient struct {
	server  *httptest.Server
	client  *http.Client
	handler sync.Mutex
}

func grantTestSite(t *testing.T, runtime *accountmodel.Runtime[@@ACCOUNT@@, @@GROUP@@, @@PERMISSION@@], overlay auth.Authorizer, clock func() time.Time) *grantHTTPClient {
	t.Helper()
	check := func(err error) { t.Helper(); rootThroughCheck(t, err) }
	cfg, err := settings.New(settings.Definition{ProjectName: "grant_test", InstalledApps: append(project.InstalledApps(), apps.Config{Name: "example.com/godj-project-bundle/consumer", Label: "granttest"})})
	check(err)
	builder := admin.NewBuilder(cfg.Apps())
	check(identityadmin.RegisterCatalog(builder, runtime.Catalog(), identityadmin.CatalogRegistration{Groups: identityadmin.CatalogPresentation{Slug: "groups"}, Permissions: identityadmin.CatalogPresentation{Slug: "permissions"}}))
	registry, err := builder.Build()
	check(err)
	next, err := admin.SiteAllowedNextPaths(registry, "/admin")
	check(err)
	cookie := websession.CookieConfig{Path: "/", AllowInsecure: true}
	login, err := websession.New(websession.Config{Sessions: runtime.Sessions(), Authenticator: runtime.Authenticator(), Authorizer: overlay, LoginPersistence: runtime.LoginPersistence(), Clock: clock,
		SessionCookie: cookie, CSRFCookie: cookie, LoginPath: "/admin/login/", FallbackPath: "/admin/", AllowedNextPaths: next})
	check(err)
	site, err := admin.NewSite(admin.SiteConfig{Apps: cfg.Apps(), Namespace: "granttest", Registry: registry, Auth: login})
	check(err)
	authn, err := apisession.New(login, apisession.WithReadOnlyResolution())
	check(err)
	management, err := identityapi.NewManagement(runtime.Accounts(), runtime.Catalog(), identityapi.ManagementConfig{Namespace: "granttest", Authentication: authn})
	check(err)
	app, err := web.NewApplication(web.Config{Settings: cfg, Routes: append(site.Routes(), management.Routes()...), Middleware: management.Middleware()})
	check(err)
	h := &grantHTTPClient{}
	h.server = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		h.handler.Lock()
		defer h.handler.Unlock()
		app.ServeHTTP(w, r)
	}))
	t.Cleanup(h.server.Close)
	jar, err := cookiejar.New(nil)
	check(err)
	h.client = &http.Client{Transport: h.server.Client().Transport, Jar: jar, Timeout: 30 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
	return h
}

func (h *grantHTTPClient) send(t *testing.T, method, path, body, contentType, token, revision string) (int, http.Header, []byte) {
	t.Helper()
	check := func(err error) { t.Helper(); rootThroughCheck(t, err) }
	req, err := http.NewRequestWithContext(t.Context(), method, h.server.URL+path, strings.NewReader(body))
	check(err)
	if method != "GET" {
		req.Header.Set("Origin", h.server.URL)
		req.Header.Set("Content-Type", contentType)
	}
	if token != "" {
		req.Header.Set(websession.DefaultCSRFHeader, token)
	}
	if revision != "" {
		req.Header.Set("If-Revision", revision)
	}
	// Order this test's failure hooks and counters with the real HTTP handler.
	h.handler.Lock()
	h.handler.Unlock()
	resp, err := h.client.Do(req)
	check(err)
	defer func() { h.handler.Lock(); h.handler.Unlock() }()
	b, err := io.ReadAll(resp.Body)
	check(err)
	check(resp.Body.Close())
	return resp.StatusCode, resp.Header, b
}

func (h *grantHTTPClient) token(t *testing.T, path string) string {
	t.Helper()
	code, _, body := h.send(t, "GET", path, "", "", "", "")
	token := regexp.MustCompile("name=\"csrfmiddlewaretoken\" value=\"([A-Za-z0-9_-]{128})\"").FindSubmatch(body)
	if code != 200 || len(token) != 2 {
		t.Fatalf("GET %s did not render a CSRF form (%d)", path, code)
	}
	return string(token[1])
}

func (h *grantHTTPClient) form(t *testing.T, path string, data url.Values) int {
	t.Helper()
	data.Set("csrfmiddlewaretoken", h.token(t, path))
	code, _, _ := h.send(t, "POST", path, data.Encode(), "application/x-www-form-urlencoded", "", "")
	return code
}

