	})
	t.Run("create_rollback", func(t *testing.T) {
		before := snapshot(reader)
		starts := backend.starts
		values, err := groups.Input(map[string]query.Value{role.Catalog.GroupName: query.String("rolled back grant group")})
		check(err)
		values, err = values.WithCollections(map[string][]int64{role.Catalog.GroupPermissions: targets[4:5]})
		check(err)
		lateRefusal = true
		defer func() { lateRefusal = false }()
		change, err := runtime.Catalog().Groups().Create(t.Context(), actor, values)
		if err == nil || !reflect.DeepEqual(change, accountmodel.CatalogChange{}) || backend.starts != starts+1 || !reflect.DeepEqual(before, snapshot(reader)) {
			t.Fatal("late validation retained a provisional group, child or audit", err)
		}
	})
	for _, name := range []string{"late_child_validation", "late_child_payload", "rollback"} {
		t.Run(name, func(t *testing.T) {
			before := snapshot(reader)
			lateRefusal, lateMutation, backend.rollback = name == "late_child_validation", name == "late_child_payload", name == "rollback"
			defer func() { lateRefusal, lateMutation, backend.rollback = false, false, false }()
			attempt(t, targets[2:4])
			if !reflect.DeepEqual(before, snapshot(reader)) {
				t.Fatal("group grant failure left partial data or audit")
			}
		})
	}
	if "@@KIND@@" == "account" {
		setActive := func(ctx context.Context, active bool) error {
			for _, row := range rootThroughRows(t, reader, objects) {
				values, e := objects.ModelValues(row)
				if e != nil {
					return e
				}
				name, _ := values[role.Login].String()
				if name != operator {
					continue
				}
				rev, ok := values[role.Revision].Integer()
				if !ok || role.Active.Field == "" {
					return errors.New("operator has no mutable active role")
				}
				p, e := objects.PrepareValues(&row, map[string]query.Value{role.Active.Field: query.Boolean(active), role.Revision: query.Integer(rev + 1)})
				if e != nil {
					return e
				}
				updated, e := p.Model()
				if e != nil {
					return e
				}
				return p.Save(ctx, reader, &updated)
			}
			return errors.New("operator missing")
		}
		t.Run("revoked_during_hash", func(t *testing.T) {
			var independent grantStoredState
			hasher.after = func(ctx context.Context) error {
				if err := setActive(ctx, false); err != nil {
					return err
				}
				independent = snapshot(reader)
				return nil
			}
			err := attempt(t, targets[1:4])
			var failure *accountmodel.Error
			if !errors.As(err, &failure) || failure.Code != accountmodel.CodePermission || !reflect.DeepEqual(independent, snapshot(reader)) {
				t.Fatal("revoked operator committed group grants", err)
			}
			check(setActive(t.Context(), true))
		})
		t.Run("replaced_link_during_hash", func(t *testing.T) {
			alter := func(ctx context.Context, old, next int64) error {
				for _, row := range rootThroughRows(t, reader, through) {
					values, err := through.ModelValues(row)
					if err != nil {
						return err
					}
					owner, belongs := values["catalog_owner"].Integer()
					target, found := values["catalog_permission"].Integer()
					if !belongs || owner != id || !found || target != old {
						continue
					}
					p, err := through.PrepareValues(&row, map[string]query.Value{"catalog_permission": query.Integer(next)})
					if err != nil {
						return err
					}
					updated, err := p.Model()
					if err != nil {
						return err
					}
					return p.Save(ctx, reader, &updated)
				}
				return errors.New("expected existing physical grant")
			}
			var independent grantStoredState
			hasher.after = func(ctx context.Context) error {
				if err := alter(ctx, targets[1], targets[4]); err != nil {
					return err
				}
				independent = snapshot(reader)
				return nil
			}
			err := attempt(t, targets[1:4])
			var failure *accountmodel.Error
			if !errors.As(err, &failure) || failure.Code != accountmodel.CodeConflict || !reflect.DeepEqual(independent, snapshot(reader)) {
				t.Fatal("group update adopted changed physical links", err)
			}
			check(alter(t.Context(), targets[4], targets[1]))
		})
	}
	t.Run("unknown_restart", func(t *testing.T) {
		backend.unknown = true
		err := attempt(t, targets[2:4])
		backend.unknown = false
		var failure *accountmodel.Error
		if !errors.As(err, &failure) || failure.Code != accountmodel.CodeOutcomeUnknown {
			t.Fatal("lost group commit was reported as a known outcome", err)
		}
		fresh, err := database.Open(t.Context(), selected)
		check(err)
		defer fresh.Close()
		persisted, rev := findRoot(fresh)
		stored := links(fresh)
		a, one := stored[targets[2]]
		b, two := stored[targets[3]]
		if persisted != id || rev != revision+1 || len(stored) != 2 || !one || !two || a == b {
			t.Fatal("reopened group differs from the committed grant set")
		}
		composed, err := project.NewAccountRuntime(t.Context(), fresh, baseHasher, overlay, runtimeConfig)
		check(err)
		current, err := composed.Authenticator().Authenticate(t.Context(), operator, accountPasswordText)
		check(err)
		row, err := composed.Catalog().Groups().Get(t.Context(), current.Principal(), id)
		check(err)
		keys, loaded := row.View().Collection(role.Catalog.GroupPermissions)
		if !loaded || !slices.Equal(keys, targets[2:4]) || row.Revision() != rev {
			t.Fatal("fresh runtime grant view differs from native rows")
		}
		checkMember(t, composed.Authenticator(), "sample.p2", "sample.p3")
		revision = rev
	})
	t.Run("clear", func(t *testing.T) {
		factories, hashes := len(parents), hasher.calls
		change, err := runtime.Catalog().Groups().Update(t.Context(), actor, id, revision, input(nil))
		check(err)
		if change.ID != id || change.Revision != revision+1 || len(links(reader)) != 0 || len(parents) != factories || hasher.calls != hashes {
			t.Fatal("clearing existing grants created identities or retained links")
		}
		checkMember(t, runtime.Authenticator())
	})
	t.Run("signed_endpoints", func(t *testing.T) {
		// Install unreferenced fixture rows with signed keys. The subsequent
		// update and the actual child inserts use the public catalog.
		groupMeta, err := groups.Metadata()
		check(err)
		groupKey, err := groups.PrimaryKeyField()
		check(err)
		newGroup, err := groups.PrepareValues(nil, map[string]query.Value{role.Catalog.GroupName: query.String("signed group"), role.Catalog.GroupRevision: query.Integer(1)})
		check(err)
		signedGroup, err := newGroup.Model()
		check(err)
		check(newGroup.Save(t.Context(), native, &signedGroup))
		accountStoredKey(t, native, selected, groupMeta.DBTable, groupKey.Column, rootThroughKey(t, groups, signedGroup), 0)
		permMeta, err := permissions.Metadata()
		check(err)
		permKey, err := permissions.PrimaryKeyField()
		check(err)
		keys := []int64{-7, 0}
		for i, signed := range keys {
			p, err := permissions.PrepareValues(nil, map[string]query.Value{role.Catalog.PermissionName: query.String(fmt.Sprintf("signed %d", i)), role.Catalog.PermissionCode: query.String(fmt.Sprintf("sample.signed%d", i)), role.Catalog.PermissionRevision: query.Integer(1)})
			check(err)
			row, err := p.Model()
			check(err)
			check(p.Save(t.Context(), native, &row))
			accountStoredKey(t, native, selected, permMeta.DBTable, permKey.Column, rootThroughKey(t, permissions, row), signed)
		}
		start := len(knownSources)
		change, err := runtime.Catalog().Groups().Update(t.Context(), actor, 0, 1, input(keys))
		check(err)
		if change.ID != 0 || change.Revision != 2 || !slices.Equal(knownSources[start:], []int64{0, 0}) {
			t.Fatal("stored group zero was treated as a pending key", change)
		}
		var actual []int64
		for _, row := range rootThroughRows(t, reader, through) {
			values, err := through.ModelValues(row)
			check(err)
			owner, belongs := values["catalog_owner"].Integer()
			target, exists := values["catalog_permission"].Integer()
			if belongs && owner == 0 {
				if !exists {
					t.Fatal("signed grant missing target")
				}
				actual = append(actual, target)
			}
		}
		slices.Sort(actual)
		if !slices.Equal(actual, keys) {
			t.Fatal("actual signed group grants differ", actual)
		}
	})
}
