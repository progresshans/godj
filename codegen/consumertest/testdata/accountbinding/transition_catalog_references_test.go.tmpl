func crAudit(t *testing.T,f *ctFixture,scope database.Backend,model string,id int64,changed bool,fields ...string){
 t.Helper();namespace,ok:=f.actor.CredentialDomain();if !ok{t.Fatal("fixture actor lacks source domain")}
 events,err:=db.ReadSnapshotResult(t.Context(),scope,func(ctx context.Context,reader db.Queryer)([]accountaudit.Entry,error){return accountaudit.HistoryIn(ctx,reader,namespace,model,id,10)});ctMust(t,err)
 if !changed{if len(events)!=0{t.Fatal("no-op catalog host row was audited",model)};return}
 // Audit preserves the supplied field order; the ORM emits model declaration order.
 if len(events)!=1||events[0].ActorID()!=f.actor.ID()||events[0].Action()!=admin.ActionChange||!slices.Equal(events[0].ChangedFields(),fields){t.Fatal("catalog host row did not receive one complete audit",model)}
}

func crVerifyApplied(t *testing.T,f *ctFixture,scope database.Backend,receipt domain.Receipt,manifest accountmodel.TransitionManifest,recovery *accountmodel.Transition[models.User,members.Member],tickets []host.Ticket,assignments []host.Assignment,badge host.CatalogBadge,workspace host.Workspace,groupField,permissionField string,group,permission int64,changes int){
 t.Helper()
 // Resolve account keys independently by preserved principal, then compare
 // them to the receipt. Host expectations never use a catalog mapping lookup.
 membersByPrincipal,err:=members.MemberObjects.Using(scope).All(t.Context());ctMust(t,err)
 actual:=make(map[int64]int64)
 for _,old:=range f.oldRows{
  index:=slices.IndexFunc(membersByPrincipal,func(row members.Member)bool{return row.Subject==old.PrincipalID})
  if index<0{t.Fatal("mapped principal missing")};actual[old.ID]=membersByPrincipal[index].ID
 }
 stored,err:=db.ReadSnapshotResult(t.Context(),scope,func(ctx context.Context,reader db.Queryer)([]domain.Mapping,error){return domain.LookupMappingsIn(ctx,reader,receipt)});ctMust(t,err)
 if len(stored)!=len(actual){t.Fatal("stored account map incomplete")}
 for _,pair:=range stored{value,ok:=actual[pair.SourceID];if !ok||value!=pair.TargetID{t.Fatal("stored mapping disagrees with independent account identity")}}
 revision:=int64(2);if changes==0||f.mode=="no_revision"{revision=1}
 for _,original:=range tickets{
  row,err:=host.TicketObjects.Using(scope).Filter(host.TicketFields.ID.Exact(original.ID)).Get(t.Context());ctMust(t,err)
  expected:=original;expected.Revision=revision
  if original.OldOwnerID!=nil{key:=actual[*original.OldOwnerID];expected.OwnerID=&key}
  if original.OldGroupID!=nil{if groupField=="group"{expected.GroupID=&group}else{expected.LegacyGroupID=&group}}
  if original.OldPermissionID!=nil{if permissionField=="permission"{expected.PermissionID=&permission}else{expected.LegacyPermissionID=&permission}}
  if !reflect.DeepEqual(row,expected){t.Fatal("mixed catalog/account row changed source keys/profile or used another namespace")}
  crAudit(t,f,scope,"host.ticket",row.ID,changes>0,"owner",groupField,permissionField)
 }
 for _,original:=range assignments{
  row,err:=host.AssignmentObjects.Using(scope).Filter(host.AssignmentFields.ID.Exact(original.ID)).Get(t.Context());ctMust(t,err)
  expected:=original;expected.Revision=revision
  if original.OldUserID!=nil{key:=actual[*original.OldUserID];expected.UserID=&key}
  if original.OldGroupID!=nil{if groupField=="group"{expected.GroupID=&group}else{expected.LegacyGroupID=&group}}
  if original.OldPermissionID!=nil{if permissionField=="permission"{expected.PermissionID=&permission}else{expected.LegacyPermissionID=&permission}}
  if !reflect.DeepEqual(row,expected){t.Fatal("mixed business through row lost owner/profile/source endpoint or namespace")}
  crAudit(t,f,scope,"host.assignment",row.ID,changes>0,"user",groupField,permissionField)
 }
 gotBadge,err:=host.CatalogBadgeObjects.Using(scope).Filter(host.CatalogBadgeFields.ID.Exact(badge.ID)).Get(t.Context());ctMust(t,err)
 expectedBadge:=badge
 if badge.OldGroupID!=nil{if groupField=="group"{expectedBadge.GroupID=&group}else{expectedBadge.LegacyGroupID=&group}}
 if badge.OldPermissionID!=nil{if permissionField=="permission"{expectedBadge.PermissionID=&permission}else{expectedBadge.LegacyPermissionID=&permission}}
 if !reflect.DeepEqual(gotBadge,expectedBadge){t.Fatal("catalog OneToOne mapping lost identity or changed profile")}
 crAudit(t,f,scope,"host.catalog_badge",badge.ID,changes>0,groupField,permissionField)
 auditCount,err:=auditmodels.EventObjects.Using(scope).Count(t.Context());ctMust(t,err)
 expectedAudits:=int64(changes+2);if f.strategy=="created"{expectedAudits+=2};if auditCount!=expectedAudits{t.Fatal("catalog host/account audit count is not atomic",auditCount,expectedAudits)}
 sessionsLeft,err:=sessionmodels.SessionObjects.Using(scope).Count(t.Context());ctMust(t,err);if sessionsLeft!=0{t.Fatal("catalog reference transition retained source sessions")}
 collections,err:=project.BindCollections();ctMust(t,err)
 oldMembers,err:=collections.HostWorkspaceLegacyMembers.From(scope,workspace);ctMust(t,err);oldPeople,err:=oldMembers.All(t.Context());ctMust(t,err)
 newMembers,err:=collections.HostWorkspaceMembers.From(scope,workspace);ctMust(t,err);newPeople,err:=newMembers.All(t.Context());ctMust(t,err)
 expectedMembers:=2;expectedCatalog:=2;if f.mode=="null_references"{expectedMembers,expectedCatalog=0,0}
 if len(oldPeople)!=expectedMembers||len(newPeople)!=expectedMembers{t.Fatal("business M2M account query disagrees with host mapping")}
 oldGroups,err:=collections.HostWorkspaceOldGroups.From(scope,workspace);ctMust(t,err);oldTeams,err:=oldGroups.All(t.Context());ctMust(t,err)
 oldPermissions,err:=collections.HostWorkspaceOldPermissions.From(scope,workspace);ctMust(t,err);oldGrants,err:=oldPermissions.All(t.Context());ctMust(t,err)
 if len(oldTeams)!=expectedCatalog||len(oldGrants)!=expectedCatalog{t.Fatal("catalog through remap changed the old relation")}
 if groupField=="group"{
  related,err:=collections.HostWorkspaceGroups.From(scope,workspace);ctMust(t,err);rows,err:=related.All(t.Context());ctMust(t,err)
  if len(rows)!=expectedCatalog||slices.ContainsFunc(rows,func(row catalog.Team)bool{return row.ID!=group}){t.Fatal("business M2M group target query used wrong namespace")}
 }else{
  related,err:=collections.HostWorkspaceSharedGroups.From(scope,workspace);ctMust(t,err);rows,err:=related.All(t.Context());ctMust(t,err)
  if len(rows)!=expectedCatalog||slices.ContainsFunc(rows,func(row models.Group)bool{return row.ID!=group}){t.Fatal("business M2M shared group query changed identity")}
 }
 if permissionField=="permission"{
  related,err:=collections.HostWorkspacePermissions.From(scope,workspace);ctMust(t,err);rows,err:=related.All(t.Context());ctMust(t,err)
  if len(rows)!=expectedCatalog||slices.ContainsFunc(rows,func(row catalog.Grant)bool{return row.ID!=permission}){t.Fatal("business M2M permission target query used wrong namespace")}
 }else{
  related,err:=collections.HostWorkspaceSharedPermissions.From(scope,workspace);ctMust(t,err);rows,err:=related.All(t.Context());ctMust(t,err)
  if len(rows)!=expectedCatalog||slices.ContainsFunc(rows,func(row models.Permission)bool{return row.ID!=permission}){t.Fatal("business M2M shared permission query changed identity")}
 }
 changed:=manifest;changed.References=slices.Clone(manifest.References);changed.References[0].Fields=slices.Clone(manifest.References[0].Fields);changed.References[0].Fields[0].Kind=accountmodel.TransitionReferenceAccount
 if _,_,err:=recovery.Reconcile(t.Context(),changed);err==nil{t.Fatal("reconciliation ignored changed catalog reference namespace")}
 changed=manifest;changed.Version=5;if _,_,err:=recovery.Reconcile(t.Context(),changed);err==nil{t.Fatal("catalog references were accepted with a pre-kind manifest version")}
 if f.mode=="lifecycle"{
  row,err:=host.TicketObjects.Using(scope).Filter(host.TicketFields.ID.Exact(tickets[0].ID)).Get(t.Context());ctMust(t,err)
  ctMust(t,ctPatchIn(t.Context(),scope,host.TicketObjects,row,map[string]query.Value{"title":query.String("legitimate subsequent host edit")}))
  if got,found,err:=recovery.Reconcile(t.Context(),manifest);err!=nil||!found||got.OperationID()!=receipt.OperationID(){t.Fatal("historical catalog host receipt required frozen live rows",err)}
 }
 if f.mode=="schema_lifecycle"{crVerifyContraction(t,f,scope,receipt,manifest,tickets,workspace,actual,group,permission)}
}

