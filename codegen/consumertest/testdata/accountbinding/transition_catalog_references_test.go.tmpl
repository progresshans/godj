  "team_grants":crRows(t,scope,catalog.TeamGrantsLinkObjects),"cross_team_grants":crRows(t,scope,catalog.TeamLegacyPermissionsLinkObjects),
  "old_memberships":crRows(t,scope,models.UserGroupsLinkObjects),"old_direct":crRows(t,scope,models.UserPermissionsLinkObjects),"old_topics":crRows(t,scope,models.UserTopicsLinkObjects),
  "new_memberships":crRows(t,scope,members.MemberGroupsLinkObjects),"new_direct":crRows(t,scope,members.MemberPermissionsLinkObjects),
