type crState struct {
 mode string
 denied, policy atomic.Bool
 ticketWrites, badgeWrites, faults, validations atomic.Int32
 ticket int64
}

type crAuthorizer struct{ state *crState }
func(a crAuthorizer)Allowed(_ context.Context,actor auth.Principal,permission auth.Permission)(bool,error){
 return actor.Has(permission)&&!(permission=="host.remap_catalog"&&a.state.denied.Load()),nil
}

func crRows[M any](t *testing.T,scope db.Queryer,objects orm.Manager[M])any{
 t.Helper();key,err:=objects.PrimaryKeyField();ctMust(t,err)
 rows,err:=objects.Using(scope).OrderBy(orm.NewAutoField[M](key).Asc()).All(t.Context());ctMust(t,err)
 values:=make([]map[string]query.Value,len(rows));for i,row:=range rows{values[i],err=objects.ModelValues(row);ctMust(t,err)};return values
}

func crSnapshot(t *testing.T,scope db.Queryer)map[string]any{
