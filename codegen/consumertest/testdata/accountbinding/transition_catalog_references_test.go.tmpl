func crSeedCatalog(t *testing.T,f *ctFixture,mode string)(int64,int64,int64,int64){
 t.Helper()
 var old models.Group;var next catalog.Team;var err error
 if mode=="page_boundary"{
  // The catalog page fixture already owns source key 3. Reuse that real
  // source/target pair so the host page still tests overlapping namespaces.
  old,err=models.GroupObjects.Using(f.native).Filter(models.GroupFields.Name.Exact("page-000")).Get(t.Context());ctMust(t,err)
  next,err=catalog.TeamObjects.Using(f.native).Filter(catalog.TeamFields.Title.Exact("mapped-page-000")).Get(t.Context());ctMust(t,err)
 }else{
  old,err=models.GroupObjects.Create(t.Context(),f.native,models.NewGroupCreate("host-only group"));ctMust(t,err)
  next,err=catalog.TeamObjects.Create(t.Context(),f.native,catalog.NewTeamCreate("host-only team"));ctMust(t,err)
 }
 group:=next.ID;groupRevision:=next.Version
 if f.role.Catalog.Group.AppLabel=="godj_identity"{group,groupRevision=old.ID,old.Revision}
 if mode!="page_boundary"{f.catalogMapping.Groups=append(f.catalogMapping.Groups,domain.Mapping{SourceID:old.ID,SourceRevision:old.Revision,TargetID:group,TargetRevision:groupRevision})}
 for _,code:=range []string{"host.remap_catalog","host.audit_catalog"}{
  original,err:=models.PermissionObjects.Create(t.Context(),f.native,models.NewPermissionCreate(code,code));ctMust(t,err)
  target,err:=catalog.GrantObjects.Create(t.Context(),f.native,catalog.NewGrantCreate(code,"mapped "+code));ctMust(t,err)
  permission,revision:=target.ID,target.Version
  if f.role.Catalog.Permission.AppLabel=="godj_identity"{permission,revision=original.ID,original.Revision}
  f.catalogMapping.Permissions=append(f.catalogMapping.Permissions,domain.Mapping{SourceID:original.ID,SourceRevision:original.Revision,TargetID:permission,TargetRevision:revision})
  if mode=="missing_grant"&&code=="host.remap_catalog"||mode=="missing_additional_grant"&&code=="host.audit_catalog"{continue}
  _,err=models.GroupPermissionsLinkObjects.Create(t.Context(),f.native,models.NewGroupPermissionsLinkCreate(f.sourceGroup,original.ID));ctMust(t,err)
  _,err=catalog.TeamGrantsLinkObjects.Create(t.Context(),f.native,catalog.NewTeamGrantsLinkCreate(f.teams[0].ID,target.ID));ctMust(t,err)
  _,err=models.GroupNewPermissionsLinkObjects.Create(t.Context(),f.native,models.NewGroupNewPermissionsLinkCreate(f.sourceGroup,target.ID));ctMust(t,err)
  _,err=catalog.TeamLegacyPermissionsLinkObjects.Create(t.Context(),f.native,catalog.NewTeamLegacyPermissionsLinkCreate(f.teams[0].ID,original.ID));ctMust(t,err)
 }
 verifier,err:=f.oldStore.Authenticator(t.Context(),f.hasher);ctMust(t,err)
 f.credential,err=verifier.Authenticate(t.Context(),"alice",accountPasswordText);ctMust(t,err);f.actor=f.credential.Principal()
 permission:=f.grants[2].ID;if f.role.Catalog.Permission.AppLabel=="godj_identity"{permission=f.oldPermissions[2].ID}
 if old.ID!=f.oldPermissions[2].ID{t.Fatal("fixture must overlap group and permission source keys")}
 if f.role.Catalog.Group.AppLabel!="godj_identity"&&f.role.Catalog.Permission.AppLabel!="godj_identity"&&group==permission{t.Fatal("fixture must distinguish namespace target keys")}
 return old.ID,group,f.oldPermissions[2].ID,permission
}

func(s *crState)install(f *ctFixture){
 changeTicket:=func(ctx context.Context,scope db.Session)error{
  row,err:=host.TicketObjects.Using(scope).Filter(host.TicketFields.ID.Exact(s.ticket)).Get(ctx);if err!=nil{return err}
  return ctPatchIn(ctx,scope,host.TicketObjects,row,map[string]query.Value{"title":query.String("unreviewed native change")})
 }
 f.backend.afterUpdate=func(ctx context.Context,scope db.Session,plan query.UpdatePlan,count int64)(int64,error){
  if plan.Table()=="transition_catalog_badge"{s.badgeWrites.Add(1)}
  if plan.Table()!="transition_ticket"{return count,nil}
  n:=s.ticketWrites.Add(1)
  if s.mode=="second_write_failure"&&n==2{s.faults.Add(1);return count,errors.New("failure after second native catalog reference update")}
  if s.mode=="lost_update"&&n==1{s.faults.Add(1);return 0,nil}
  if s.mode=="host_catalog_change"&&n==1{
   s.faults.Add(1)
   return count,ctPatchIn(ctx,scope,catalog.TeamObjects,f.teams[1],map[string]query.Value{"note":query.String("unreviewed catalog from host rule")})
  }
  return count,nil
 }
 f.backend.afterInsert=func(ctx context.Context,scope db.Session,plan query.InsertPlan,id int64)(int64,error){
  if s.mode=="target_insert_host_change"&&plan.Table()=="members_member"&&s.faults.CompareAndSwap(0,1){return id,changeTicket(ctx,scope)}
  if s.mode=="host_audit_failure"&&plan.Table()=="godj_account_audit_event"&&s.ticketWrites.Load()>0{s.faults.Add(1);return id,errors.New("failure after catalog host audit INSERT")}
  if plan.Table()=="godj_account_domain_transition"{
   if s.mode=="late_host_change"{s.faults.Add(1);return id,changeTicket(ctx,scope)}
   if s.mode=="late_policy_change"{s.faults.Add(1);s.policy.Store(true)}
  }
  return id,nil
 }
}

func TestAccountCatalogReferences(t *testing.T){
 for _,strategy:=range []string{"staged","created"}{t.Run(strategy,func(t *testing.T){
  cases:=[]string{@@STAGED_CASES@@};if strategy=="created"{cases=[]string{@@CREATED_CASES@@}}
  for _,mode:=range cases{t.Run(mode,func(t *testing.T){testAccountCatalogReferences(t,strategy,mode)})}
 })}
}

