const historicalActor = "historical-operator"
const historicalWorkerEnv = "GODJ_HISTORICAL_OPERATOR_REQUEST"

type historicalWorkerRequest struct {
	Action, Mode, Directory                 string
	Vendor                                  database.Kind
	SQLitePath, PostgresURL, PostgresSchema string
}
type historicalWorkerReply struct {
	Status, Operation string
	Sequence          int64
	PID               int
}
type historicalProcessOutput struct {
	buffer   bytes.Buffer
	overflow bool
}

func (output *historicalProcessOutput) Len() int { return output.buffer.Len() }
func (output *historicalProcessOutput) Write(data []byte) (int, error) {
	if len(data) > 65536-output.Len() {
		output.overflow = true
		return 0, errors.New("operator diagnostic exceeds its bound")
	}
	return output.buffer.Write(data)
}
func historicalMust(t *testing.T, err error) {
	t.Helper()
	if err != nil {
		t.Fatal(err)
	}
}

func historicalWriteJSON(path string, value any) error {
	data, err := json.Marshal(value)
	if err != nil {
		return err
	}
	temporary := path + ".pending"
	if err := os.WriteFile(temporary, data, 0600); err != nil {
		return err
	}
	return os.Rename(temporary, path)
}
func historicalReadJSON(t *testing.T, path string, value any) {
	t.Helper()
	data, err := os.ReadFile(path)
	historicalMust(t, err)
	if len(data) > domain.MaximumMappingBytes {
		t.Fatal("operator journal exceeded its bound")
	}
	decoder := json.NewDecoder(bytes.NewReader(data))
	decoder.DisallowUnknownFields()
	historicalMust(t, decoder.Decode(value))
	if decoder.Decode(new(any)) != io.EOF {
		t.Fatal("operator journal has trailing data")
	}
}

