			}
			if mode == "hash_failure" && (hasher.calls != 2 || backend.starts != 0) {
				t.Fatal("partial password preparation reached a write or missed its second failure")
			}
			reader, err := database.Open(t.Context(), selected)
			check(err)
			defer reader.Close()
			actualRows := readRows(reader)
			if rejected {
				if !reflect.DeepEqual(actualRows, initialRows) || !reflect.DeepEqual(readGroups(reader), initialGroups) || len(history(reader, accountName, boot.Account.ID)) != 1 {
					t.Fatal("failed through operation left rows, revision or audit")
				}
				for _, row := range initialGroups {
					if len(history(reader, groupName, graphKey(t, groups, row))) != 0 {
						t.Fatal("failed through operation left a group audit")
					}
				}
				return
			}
			if len(actualRows) != 3 || preparedCount != 2 || mode != "unusable" && hasher.calls != 2 || mode == "unusable" && hasher.calls != 0 {
				t.Fatal("missing/multiple typed candidates or password work", len(actualRows), preparedCount, hasher.calls)
			}
			if mode != "unknown" && (result.ID != boot.Account.ID || result.Revision != 2 || result.RevokedSessions != 0 || !slices.Equal(result.ChangedFields, []string{"@@FIELD@@"})) {
				t.Fatal("root collection change lost revision ownership")
			}
			parent, err := objects.Using(reader).Filter(key.Exact(boot.Account.ID)).Get(t.Context())
			check(err)
			parentValues, err := objects.ModelValues(parent)
			check(err)
			revision, _ := parentValues[role.Revision].Integer()
			if revision != 2 {
				t.Fatal("durable parent advanced more than once")
			}
			groupOwners := []int64{groupID}
			if kind == "groups" {
				groupOwners = slices.Clone(inputKeys)
			}
			for _, owner := range groupOwners {
				view, e := runtime.Catalog().Groups().Get(t.Context(), actor, owner)
				check(e)
				if view.Revision() != 2 {
					t.Fatal("shared catalog through owner did not advance exactly once")
				}
				events := history(reader, groupName, owner)
				if len(events) != 1 || events[0].Action() != admin.ActionChange || !slices.Equal(events[0].ChangedFields(), []string{role.Catalog.GroupPermissions}) {
					t.Fatal("existing group audit was omitted or repeated")
				}
			}
			if len(history(reader, accountName, boot.Account.ID)) != 2 {
				t.Fatal("root account audit was omitted or repeated")
			}
			seen := map[int64]bool{}
			var children []@@ACCOUNT@@
			for _, row := range actualRows {
				id := graphKey(t, objects, row)
				if id == boot.Account.ID {
					continue
				}
				children = append(children, row)
				values, e := objects.ModelValues(row)
				check(e)
				parent, pok := values["link_parent"].Integer()
				catalog, cok := values[otherField].Integer()
				target, tok := values[endpoint].Integer()
				rev, _ := values[role.Revision].Integer()
				encoded, _ := values[role.Password].String()
				principal, _ := values[role.PrincipalID].String()
				if !pok || parent != boot.Account.ID || !cok || catalog != otherKey || !tok || !slices.Contains(inputKeys, target) || seen[target] || rev != 1 || principal == "" {
					t.Fatal("generated child values do not match actual pair")
				}
				seen[target] = true
				if mode == "unusable" {
					if !strings.HasPrefix(encoded, "!") {
						t.Fatal("explicit unusable child became usable")
					}
				} else {
					valid, e := baseHasher.Verify(t.Context(), accountPasswordText, encoded)
					check(e)
					if !valid {
						t.Fatal("generated child credential missing")
					}
				}
				events := history(reader, accountName, id)
				if len(events) != 1 || events[0].Action() != admin.ActionAdd || events[0].ActorID() != actor.ID() {
					t.Fatal("child creation audit missing")
				}
			}
			backend.unknown = false
			backend.rollback = false
			if mode == "no_op" {
				hashes, factories := hasher.calls, preparedCount
				result, e := runtime.Accounts().Editor().Update(t.Context(), actor, boot.Account.ID, 2, input)
				check(e)
				if result.Revision != 2 || len(result.ChangedFields) != 0 || hasher.calls != hashes || preparedCount != factories || !reflect.DeepEqual(actualRows, readRows(reader)) || len(history(reader, accountName, boot.Account.ID)) != 2 {
					t.Fatal("retained pairs recreated or rehashed identities")
				}
			}
			if mode == "delete_sessions" || mode == "replace" || mode == "reuse_deleted_login" {
				var stored sessions.Record
				if mode == "delete_sessions" {
					values, e := objects.ModelValues(children[0])
					check(e)
					login, _ := values[role.Login].String()
					credential, e := runtime.Authenticator().Authenticate(t.Context(), login, accountPasswordText)
					check(e)
					stored, e = auth.EstablishSession(t.Context(), runtime.Sessions(), credential, sessions.Record{})
					check(e)
				}
				keys := []int64{}
				if mode == "replace" || mode == "reuse_deleted_login" {
					keys = []int64{targets[2]}
				}
				if mode == "reuse_deleted_login" {
					values, e := objects.ModelValues(children[0])
					check(e)
					reuseLogin, _ = values[role.Login].String()
				}
				next, e := objects.Input(nil)
				check(e)
				next, e = next.WithCollections(map[string][]int64{"@@FIELD@@": keys})
				check(e)
				changed, e := runtime.Accounts().Editor().Update(t.Context(), actor, boot.Account.ID, 2, next)
				check(e)
				remaining := readRows(reader)
				if changed.Revision != 3 || len(remaining) != 1+len(keys) {
					t.Fatal("through deletion/replacement did not collect exact identities")
				}
				if mode == "reuse_deleted_login" {
					found := false
					for _, row := range remaining {
						values, e := objects.ModelValues(row)
						check(e)
						login, _ := values[role.Login].String()
						found = found || login == reuseLogin
					}
					if !found {
						t.Fatal("deleted login was not reused by a distinct identity")
					}
				}
				if mode == "delete_sessions" {
					if changed.RevokedSessions != 1 {
						t.Fatal("removed identity session not counted")
					}
					_, found, e := runtime.SessionStore().Load(t.Context(), stored.ID())
					check(e)
					if found {
						t.Fatal("deleted through identity retained its session")
					}
				}
				for _, child := range children {
					events := history(reader, accountName, graphKey(t, objects, child))
					deleted := 0
					for _, event := range events {
						if event.Action() == admin.ActionDelete && event.ActorID() == actor.ID() {
							deleted++
						}
					}
					if len(events) != 2 || deleted != 1 {
						t.Fatal("removed through identity audit absent")
					}
				}
				groupEvents := 2
				if mode == "delete_sessions" || kind == "groups" {
					groupEvents = 1
				} // Removal caused by deleting identities is indirect; replacement also directly creates membership.
				for _, owner := range groupOwners {
					final, e := runtime.Catalog().Groups().Get(t.Context(), actor, owner)
					check(e)
					if final.Revision() != 3 || len(history(reader, groupName, owner)) != groupEvents {
						t.Fatal("shared group deletion effect lost its direct/indirect ownership")
					}
				}
				if kind == "groups" {
					for _, owner := range keys {
						final, e := runtime.Catalog().Groups().Get(t.Context(), actor, owner)
						check(e)
						if final.Revision() != 2 || len(history(reader, groupName, owner)) != 1 {
							t.Fatal("new group membership effect was omitted")
						}
					}
				}
			}
			if mode == "restart" {
				verifier, e := project.NewAccountAuthenticator(t.Context(), reader, baseHasher)
				check(e)
				values, e := objects.ModelValues(children[0])
				check(e)
				login, _ := values[role.Login].String()
				_, e = verifier.Authenticate(t.Context(), login, accountPasswordText)
				check(e)
			}
		})
	}
}
