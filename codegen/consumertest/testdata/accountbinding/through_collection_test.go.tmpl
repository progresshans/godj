type throughBackend struct {
	database.Backend
	reading, writing, starts   int
	cleanup, rollback, unknown bool
	scope                      db.RelationSession
}

func (b *throughBackend) ReadSnapshot(ctx context.Context, read func(db.Queryer) error) error {
	b.reading++
	defer func() { b.reading-- }()
	err := b.Backend.ReadSnapshot(ctx, read)
	if b.cleanup {
		b.cleanup = false
		return errors.Join(err, errors.New("private through snapshot cleanup"))
	}
	return err
}
func (b *throughBackend) CoordinatedAtomicRelation(ctx context.Context, write func(db.RelationSession) error) error {
	b.starts++
	b.writing++
	defer func() { b.writing--; b.scope = nil }()
	err := b.Backend.CoordinatedAtomicRelation(ctx, func(scope db.RelationSession) error {
		b.scope = scope
		if err := write(scope); err != nil {
			return err
		}
		if b.rollback {
			return errors.New("private through rollback")
		}
		return nil
	})
	if err == nil && b.unknown {
		return &query.Error{Category: query.CategoryBackend, Code: query.CodeCommitOutcomeUnknown}
	}
	return err
}

type throughHasher struct {
	auth.PasswordHasher
	backend *throughBackend
	calls   int
	after   func(context.Context) error
	fail    bool
}

func (h *throughHasher) Hash(ctx context.Context, raw string) (string, error) {
	h.calls++
	if h.backend.reading != 0 || h.backend.writing != 0 {
		return "", errors.New("password work occurred inside a native scope")
	}
	if h.after != nil {
		callback := h.after
		h.after = nil
		if err := callback(ctx); err != nil {
			return "", err
		}
	}
	if h.fail && h.calls == 2 {
		return "", errors.New("private hash failure")
	}
	return h.PasswordHasher.Hash(ctx, raw)
}

type throughOverlay struct{ deny auth.Permission }

func (o *throughOverlay) Allowed(_ context.Context, actor auth.Principal, p auth.Permission) (bool, error) {
	return actor.Has(p) && p != o.deny, nil
}

func throughRekey(ctx context.Context, scope db.RelationSession, objects orm.Manager[@@ACCOUNT@@], row @@ACCOUNT@@) error {
	key, present, err := objects.PrimaryKey(row)
	if err != nil || !present {
		return errors.New("late through key absent")
	}
	metadata, err := objects.Metadata()
	if err != nil {
		return err
	}
	field, err := objects.PrimaryKeyField()
	if err != nil {
		return err
	}
	ref := query.NewFieldRef(field.Name, field.Column, query.FieldInteger, false)
	source, err := query.NewPlan(metadata.DBTable, []query.FieldRef{ref}).WithConditions(query.NewCondition(ref, query.LookupExact, key))
	if err != nil {
		return err
	}
	literal, err := query.LiteralExpression(query.Integer(-900000000001))
	if err != nil {
		return err
	}
	assignment, err := query.NewScalarAssignment(ref, literal)
	if err != nil {
		return err
	}
	plan, err := query.NewQueryUpdatePlan(source, ref, []query.ScalarAssignment{assignment})
	if err != nil {
		return err
	}
	writer, ok := scope.(db.QueryUpdater)
	if !ok {
		return errors.New("native through fixture has no query update")
	}
	n, err := writer.QueryUpdate(ctx, plan)
	if err == nil && n != 1 {
		return errors.New("late through key mutation missed actual row")
	}
	return err
}

