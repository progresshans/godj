func nuMust(t *testing.T,err error){t.Helper();if err!=nil{nuExplain(t,err,0);t.Fatal(err)}}
// These errors belong to isolated synthetic fixtures. Preserve the bounded
// cause chain in remote diagnostics without changing production redaction.
func nuExplain(t *testing.T,err error,depth int){t.Helper();if err==nil||depth>=8{return};t.Logf("cause[%d] %T: %v",depth,err,err);switch e:=err.(type){case interface{Unwrap()[]error}:for _,cause:=range e.Unwrap(){nuExplain(t,cause,depth+1)};case interface{Unwrap()error}:nuExplain(t,e.Unwrap(),depth+1)}}
func nuRows[M any](t *testing.T,scope db.Queryer,objects orm.Manager[M])[]M{t.Helper();key,err:=objects.PrimaryKeyField();nuMust(t,err);rows,err:=objects.Using(scope).OrderBy(orm.NewAutoField[M](key).Asc()).All(t.Context());nuMust(t,err);return rows}
func nuSave[M any](ctx context.Context,scope db.Mutator,objects orm.Manager[M],row M,values map[string]query.Value)error{prepared,err:=objects.PrepareValues(&row,values);if err!=nil{return err};row,err=prepared.Model();if err!=nil{return err};return prepared.Save(ctx,scope,&row)}
