type nuInsertion struct{key int64;values map[string]query.Value}
type nuBackend struct{database.Backend;reading,writing,completed,faults int;mode,table,natural string;receipt bool;scope db.RelationSession;inserted []nuInsertion}
func(b *nuBackend)ReadSnapshot(ctx context.Context,read func(db.Queryer)error)error{b.reading++;defer func(){b.reading--}();err:=b.Backend.ReadSnapshot(ctx,read);if b.mode=="read_cleanup"{return errors.Join(err,errors.New("transition through cleanup"))};return err}
func(b *nuBackend)CoordinatedAtomicRelation(ctx context.Context,write func(db.RelationSession)error)error{
 b.writing++;defer func(){b.writing--;b.scope=nil}()
 err:=b.Backend.CoordinatedAtomicRelation(ctx,func(scope db.RelationSession)error{
  wrapped:=&nuScope{RelationSession:scope,owner:b};b.scope=wrapped
  if err:=write(wrapped);err!=nil{return err};b.completed++
  if b.mode=="rollback"||b.mode=="unknown_rollback"{b.faults++;return errors.New("after complete collection transition")};return nil
 })
 if b.mode=="unknown_rollback"||err==nil&&b.mode=="unknown_commit"{return &query.Error{Category:query.CategoryBackend,Code:query.CodeCommitOutcomeUnknown}}
 return err
}
type nuScope struct{db.RelationSession;owner *nuBackend}
func(s *nuScope)ValidateSession(ctx context.Context)error{return s.RelationSession.(db.SessionValidator).ValidateSession(ctx)}
func(s *nuScope)InsertOnConflict(ctx context.Context,plan query.ConflictInsertPlan)(db.ConflictInsertResult,error){return s.RelationSession.(db.ConflictInserter).InsertOnConflict(ctx,plan)}
func(s *nuScope)Insert(ctx context.Context,plan query.InsertPlan)(int64,error){
 key,err:=s.RelationSession.Insert(ctx,plan);if err!=nil{return key,err}
 if plan.Table()=="godj_account_domain_transition"{s.owner.receipt=true}
 if plan.Table()=="godj_account_domain_mapping"&&s.owner.mode=="mapping_failure"{s.owner.faults++;return key,errors.New("after mapping INSERT")}
 if plan.Table()==s.owner.table{
  values:=map[string]query.Value{};for _,assignment:=range plan.Assignments(){values[assignment.Field().Name()]=assignment.Value()}
  text,_:=values[s.owner.natural].String()
  if strings.HasPrefix(text,"extra"){
   values["id"]=query.Integer(key);s.owner.inserted=append(s.owner.inserted,nuInsertion{key,values})
   if s.owner.mode=="insert_failure"{s.owner.faults++;return key,errors.New("after typed through INSERT")}
  }
 }
 return key,nil
}
type nuHasher struct{auth.PasswordHasher;backend *nuBackend;calls int}
func(h *nuHasher)Hash(ctx context.Context,raw string)(string,error){h.calls++;if h.backend.reading!=0||h.backend.writing!=0{return "",errors.New("transition hashing retained native scope")};if h.backend.mode=="hash_failure"{return "",errors.New("transition hash failure")};return h.PasswordHasher.Hash(ctx,raw)}
type nuOverlay struct{deny auth.Permission}
func(o *nuOverlay)Allowed(_ context.Context,p auth.Principal,permission auth.Permission)(bool,error){return p.Has(permission)&&permission!=o.deny,nil}
