type filePublicationGate struct{storage.Backend;arrive func();gate <-chan struct{}}
func (backend *filePublicationGate) Save(ctx context.Context,name string,source io.Reader,options storage.SaveOptions)(storage.Info,error){
    backend.arrive();select{case <-backend.gate:case <-ctx.Done():return storage.Info{},&storage.Error{Code:"fixture_canceled",Outcome:storage.NotPublished,Cause:ctx.Err()}}
    return backend.Backend.Save(ctx,name,source,options)
}
