    run("failures",func(t *testing.T){
        for _,mode:=range []string{"stale","denied","invalid_image","read_cleanup","not_published","published_cleanup","uncertain","partial","unique","validator","audit","write_cleanup","unknown_commit","canceled_after_publication","reporter"}{
            t.Run(mode,func(t *testing.T){
                id:=target(t,"file-failure-"+mode);ctx,cancel:=context.WithCancel(t.Context());defer cancel()
                input:=fileData(t,"document","failure.txt",content);fields:=[]string{"document"}
                if mode=="partial"{fields=append(fields,"second_document");input=forms.NewDataWithFiles(nil,map[string][]uploads.File{"document":{upload(t,"failure.txt",content)},"second_document":{upload(t,"failure.txt",content)}})}
                if mode=="invalid_image"{fields=[]string{"portrait"};input=fileData(t,"portrait","broken.png",[]byte("not an image"))}
                var targetSession sessions.Record
                if mode=="audit"||mode=="write_cleanup"||mode=="unknown_commit"{
                    fields=append(fields,role.Active.Field);pid,_:=values(t,row(t,id))[role.PrincipalID].String()
                    targetSession,err=composed.Sessions().Create(t.Context(),map[string]string{auth.SessionPrincipalIDKey:pid});fileCheck(t,err)
                }
                bound:=bind(t,id,fields,input);if mode!="invalid_image"&&!bound.Form().Valid(){t.Fatal("failure fixture was invalid")}
                if mode=="stale"{fileCheck(t,serverPatch(t,id,map[string]query.Value{role.Revision:query.Integer(2)}))}
                if mode=="unique"{fileCheck(t,serverPatch(t,firstResult.Account.ID,map[string]query.Value{"document":query.String("document/"+strconv.FormatInt(id,10)+"/failure.txt")}))}
                acting:=actor
                if mode=="denied"{pid,_:=values(t,row(t,id))[role.PrincipalID].String();credential,present,err:=composed.Credentials().CredentialByID(t.Context(),pid);fileCheck(t,err);if !present{t.Fatal("target credential missing")};acting=credential.Principal()}
                var requestData url.Values
                if mode=="reporter"{requestData=editData(t,id)}
                before:=snapshot(t);beforeSaves,beforeWrites,beforeNames:=disk.saves.Load(),backend.writes.Load(),disk.names.Load()
                switch mode{
                case "read_cleanup":backend.readFailure.Store(true)
                case "not_published","published_cleanup","uncertain","partial":disk.set(mode,nil)
                case "validator":reject.Store(true)
                case "audit":backend.mode.Store("audit")
                case "write_cleanup":backend.mode.Store("cleanup")
                case "unknown_commit":backend.mode.Store("unknown")
                case "canceled_after_publication":disk.set("",func()error{cancel();return nil})
                case "reporter":reports.fail.Store(true)
                }
                var result accountmodel.AccountChange;var publications []formmodel.FilePublication;var failure error
                if mode=="reporter"{
                    status,body:=post(t,id,requestData,map[string][]byte{"document":content})
                    reports.fail.Store(false)
                    if status!=500||strings.Contains(body,"private"){t.Fatal("reporter error was exposed or hidden",status)}
                    report,_:=reports.last();result,publications,failure=report.Change(),report.Publications(),report.Err()
                    if failure!=nil||result.Revision!=2{t.Fatal("reporter lost confirmed account outcome")}
                }else{result,publications,failure=composed.Accounts().Editor().UpdateForm(ctx,acting,id,1,bound)}
                disk.set("",nil);reject.Store(false);backend.mode.Store("");backend.readFailure.Store(false)
                early:=mode=="stale"||mode=="denied"||mode=="invalid_image"||mode=="read_cleanup"
                if mode!="reporter"&&(failure==nil||!reflect.DeepEqual(result,accountmodel.AccountChange{})){t.Fatal("failed file edit published account metadata",failure)}
                if early{
                    if len(publications)!=0||disk.saves.Load()!=beforeSaves||backend.writes.Load()!=beforeWrites||disk.names.Load()!=beforeNames{t.Fatal("prepublication refusal invoked naming or wrote file/DB")}
                }else{
                    wanted:=1;if mode=="partial"{wanted=2};if len(publications)!=wanted||disk.saves.Load()!=beforeSaves+int64(wanted){t.Fatal("publication attempts were lost or retried")}
                    if mode=="not_published"{if publications[0].Outcome()!=storage.NotPublished{t.Fatal("prepublication outcome changed")}}else{assertStored(t,publications[0],content)}
                    if mode=="published_cleanup"&&publications[0].Outcome()!=storage.Published{t.Fatal("confirmed publication became unknown")}
                    if mode=="uncertain"&&publications[0].Outcome()!=storage.Uncertain{t.Fatal("uncertain publication became confirmed")}
                    if mode=="partial"&&(publications[0].Outcome()!=storage.Published||publications[1].Outcome()!=storage.NotPublished){t.Fatal("partial publication state was flattened")}
                }
                if mode=="unknown_commit"||mode=="reporter"{
                    if revision(t,id)!=2{t.Fatal("native commit did not reach DB")}
                    stored,_:=values(t,row(t,id))["document"].String();if stored!=publications[0].Info().Name(){t.Fatal("committed name differs from publication")}
                    events,err:=composed.Accounts().Reader().History(t.Context(),actor,id,100);fileCheck(t,err);if len(events)!=2{t.Fatal("confirmed or uncertain commit lost its atomic audit")}
                    if mode=="unknown_commit"&&!errors.Is(failure,&accountmodel.Error{Code:accountmodel.CodeOutcomeUnknown}){t.Fatal("unknown commit was classified as ordinary failure",failure)}
                    if mode=="unknown_commit"{if _,present,err:=composed.Sessions().Load(t.Context(),targetSession.ID());err!=nil||present{t.Fatal("unknown committed file/role edit did not revoke its session",err)}}
                }else{assertSame(t,before)}
                if mode=="unique"{if diagnostics,rejected:=validation.Rejected(failure);!rejected||diagnostics.ByField("document").Empty(){t.Fatal("actual published name bypassed final uniqueness",failure)}}
                if disk.deletes.Load()!=0{t.Fatal("failed file edit attempted compensation deletion")}
            })
        }
    })
    run("concurrent_revision",func(t *testing.T){
        id:=target(t,"concurrent-files");first:=bind(t,id,[]string{"document"},fileData(t,"document","race.txt",content));second:=bind(t,id,[]string{"document"},fileData(t,"document","race.txt",content))
        // Both attempts must finish their read preparation before publication
        // returns; they then contend on the actual native revision fence.
        gate:=make(chan struct{});var arrivals atomic.Int64
        blocking:=&filePublicationGate{Backend:root,arrive:func(){if arrivals.Add(1)==2{close(gate)}},gate:gate}
        policy,err:=accountmodel.NewProfileFile(binding,"document",accountmodel.ProfileFileConfig[fileAccount]{Backend:blocking,Name:func(fileAccount,uploads.File)(string,error){return "concurrent/race.txt",nil}});fileCheck(t,err)
        config:=runtimeConfig.Accounts;config.EditFields=[]string{"document"};config.Files=[]accountmodel.ProfileFile[fileAccount]{policy}
        management,err:=project.NewAccountManagement(composed.SessionStore(),composed.Authenticator(),auth.PrincipalAuthorizer{},config);fileCheck(t,err)
        type outcome struct{change accountmodel.AccountChange;files []formmodel.FilePublication;err error};results:=make(chan outcome,2)
        work,stop:=context.WithTimeout(t.Context(),30*time.Second);defer stop()
        for _,form:=range []formmodel.BoundForm{first,second}{go func(){value,files,err:=management.Editor().UpdateForm(work,actor,id,1,form);results<-outcome{value,files,err}}()}
        committed,conflicts:=0,0;var names []string
        for range 2{result:=<-results;if len(result.files)!=1||result.files[0].Outcome()!=storage.Published{t.Fatal("concurrent attempt lost publication")};names=append(names,result.files[0].Info().Name());assertStored(t,result.files[0],content)
            if result.err==nil&&result.change.Revision==2{committed++}else if errors.Is(result.err,&accountmodel.Error{Code:accountmodel.CodeConflict})&&result.change.Revision==0{conflicts++}else{t.Fatal("concurrent file edit failed outside revision contract",result.err)}}
        if committed!=1||conflicts!=1||names[0]==names[1]||revision(t,id)!=2{t.Fatal("concurrent file edit overwrote content or committed twice")}
        events,err:=composed.Accounts().Reader().History(t.Context(),actor,id,100);fileCheck(t,err);if len(events)!=2{t.Fatal("concurrent rejection added audit")}
    })
