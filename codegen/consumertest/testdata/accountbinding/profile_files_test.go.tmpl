// Both shapes use actual generated File/Image fields, typed factories, native
// migrations, real TCP multipart requests and explicit storage capabilities.
func TestGeneratedProfileFileLifecycle(t *testing.T) {
    run := func(name string, body func(*testing.T)) { t.Helper(); if !t.Run(name,body) { t.FailNow() } }
    binding, err := project.BindAccount(); fileCheck(t,err)
    role, err := binding.Role(); fileCheck(t,err)
    objects, err := binding.Objects(); fileCheck(t,err)
    metadata, err := objects.Metadata(); fileCheck(t,err)
    keyField, err := objects.PrimaryKeyField(); fileCheck(t,err)
    key := orm.NewAutoField[fileAccount](keyField)
    native, selected := accountDatabaseWithConfig(t, @@SCHEMAS@@)
    backend := &fileDatabase{Backend:native}
    backend.mode.Store("")
    root, err := storage.OpenFilesystem(t.Context(),storage.FilesystemConfig{Directory:t.TempDir()}); fileCheck(t,err)
    t.Cleanup(func(){fileCheck(t,root.Close())})
    disk := &fileStorage{Backend:root}
    inspector, err := storage.NewImageInspector(disk); fileCheck(t,err)
    for index, name := range []string{"presets/first.png","presets/second.png"} {
        _, err := root.Save(t.Context(),name,bytes.NewReader(filePNG(t,index+2,index+3)),storage.SaveOptions{}); fileCheck(t,err)
    }
    var policies []accountmodel.ProfileFile[fileAccount]
    for _, field := range []string{"document","second_document","portrait"} {
        policy, err := accountmodel.NewProfileFile(binding,field,accountmodel.ProfileFileConfig[fileAccount]{Backend:disk,Name:func(candidate fileAccount, file uploads.File)(string,error){
            disk.names.Add(1)
            values, err := objects.ModelValues(candidate); if err != nil { return "",err }
            if encoded, _ := values[role.Password].String(); encoded!="" { return "",errors.New("file namer received credential material") }
            if principal, _ := values[role.PrincipalID].String(); principal!="" { return "",errors.New("file namer received principal identity") }
            target, present, err := objects.PrimaryKey(candidate); if err != nil || !present { return "",errors.New("file namer lost target identity") }
            id, valid := target.Integer(); if !valid { return "",errors.New("file namer target is not typed") }
            disk.retain(file)
            return field+"/"+strconv.FormatInt(id,10)+"/"+file.Name(),nil
        }}); fileCheck(t,err)
        policies=append(policies,policy)
    }
    preset, err := accountmodel.NewProfileFile(binding,"preset",accountmodel.ProfileFileConfig[fileAccount]{ImageChoices:inspector.Inspect}); fileCheck(t,err)
    policies=append(policies,preset)
    baseFields:=[]string{role.Login,"@@PROFILE@@"}
    createFields:=append(slices.Clone(baseFields),role.Groups,role.Permissions)
    editFields:=append(slices.Clone(baseFields),"document","second_document","portrait","preset",role.Groups,role.Permissions)
    for _, field:=range []string{role.Active.Field,role.Staff.Field,role.Superuser.Field} { if field!="" { editFields=append(editFields,field) } }
    readFields:=append(slices.Clone(editFields),"portrait_width","portrait_height","preset_width","preset_height")
    accountPermissions:=accountmodel.AccountPermissions{View:"account.view",Add:"account.add",Change:"account.change",Delete:"account.delete"}
    groupPermissions:=accountmodel.CatalogPermissions{View:"catalog.view_group",Add:"catalog.add_group",Change:"catalog.change_group",Delete:"catalog.delete_group"}
    permissionPermissions:=accountmodel.CatalogPermissions{View:"catalog.view_permission",Add:"catalog.add_permission",Change:"catalog.change_permission",Delete:"catalog.delete_permission"}
    reject:=&atomic.Bool{}
    // Keep legitimate HTTP session touches at one instant, so complete durable
    // snapshots can detect mutation failures without ignoring any session data.
    now:=time.Now().UTC().Truncate(time.Microsecond)
    clock:=func()time.Time{return now}
    runtimeConfig:=accountmodel.RuntimeConfig[fileAccount,@@GROUP@@,@@PERMISSION@@]{
        Sessions:sessions.Config{Clock:clock},
        Accounts:accountmodel.AccountManagementConfig[fileAccount]{ReadFields:readFields,CreateFields:createFields,EditFields:editFields,Files:policies,Permissions:accountPermissions,
            Now:clock,
            GroupPermissions:accountmodel.DeletionPermissions{Change:groupPermissions.Change,Delete:groupPermissions.Delete},
            PermissionPermissions:accountmodel.DeletionPermissions{Change:permissionPermissions.Change,Delete:permissionPermissions.Delete},
            ValidateEdit:func(context.Context,db.Queryer,fileAccount,fileAccount,accountmodel.AccountMemberships)(validation.Errors,error){
                if reject.Load() { return validation.NewErrors(validation.New("document","rejected")),nil }; return validation.Errors{},nil
            }},
        Catalog:accountmodel.CatalogConfig[@@GROUP@@,@@PERMISSION@@]{
            Now:clock,
            Group:accountmodel.CatalogModelConfig[@@GROUP@@]{ReadFields:[]string{role.Catalog.GroupName,role.Catalog.GroupPermissions},WriteFields:[]string{role.Catalog.GroupName,role.Catalog.GroupPermissions},Permissions:groupPermissions},
            Permission:accountmodel.CatalogModelConfig[@@PERMISSION@@]{ReadFields:[]string{role.Catalog.PermissionName,role.Catalog.PermissionCode},WriteFields:[]string{role.Catalog.PermissionName,role.Catalog.PermissionCode},Permissions:permissionPermissions},
            AccountPermissions:accountmodel.DeletionPermissions{Change:accountPermissions.Change,Delete:accountPermissions.Delete}},
    }
    hasher,_:=accountPassword(t)
    first,err:=project.NewFirstAccount(backend,hasher,accountmodel.FirstAccountConfig[fileAccount]{CreationPolicy:accountmodel.CreationPolicy[fileAccount]{Fields:baseFields,Now:clock},EvidenceSHA256:strings.Repeat("b",64)});fileCheck(t,err)
    initial,err:=objects.Input(map[string]query.Value{role.Login:query.String("first@example.test"),"@@PROFILE@@":query.String("NZ")});fileCheck(t,err)
    pending,err:=first.Prepare(t.Context(),initial,accountPasswordText);fileCheck(t,err)
    firstResult,err:=first.Commit(t.Context(),pending);fileCheck(t,err)
    composed,err:=project.NewAccountRuntime(t.Context(),backend,hasher,auth.PrincipalAuthorizer{},runtimeConfig);fileCheck(t,err)
    credential,err:=composed.Authenticator().Authenticate(t.Context(),"first@example.test",accountPasswordText);fileCheck(t,err)
    actor:=credential.Principal()
    // The custom model requires nonempty Form collections. Provision real
    // catalog choices and keep them selected instead of relaxing its Schema IR.
    grantInput,err:=@@PERMISSION@@Objects.Input(map[string]query.Value{role.Catalog.PermissionName:query.String("Profile files"),role.Catalog.PermissionCode:query.String("profile.files")});fileCheck(t,err)
    grant,err:=composed.Catalog().Permissions().Create(t.Context(),actor,grantInput);fileCheck(t,err)
    groupInput,err:=@@GROUP@@Objects.Input(map[string]query.Value{role.Catalog.GroupName:query.String("Profile team")});fileCheck(t,err)
    groupInput,err=groupInput.WithCollections(map[string][]int64{role.Catalog.GroupPermissions:{grant.ID}});fileCheck(t,err)
    group,err:=composed.Catalog().Groups().Create(t.Context(),actor,groupInput);fileCheck(t,err)
    row:=func(t *testing.T,id int64)fileAccount{t.Helper();value,err:=objects.Using(native).Filter(key.Exact(id)).Get(t.Context());fileCheck(t,err);return value}
    values:=func(t *testing.T,value fileAccount)map[string]query.Value{t.Helper();result,err:=objects.ModelValues(value);fileCheck(t,err);return result}
    revision:=func(t *testing.T,id int64)int64{t.Helper();version,valid:=values(t,row(t,id))[role.Revision].Integer();if !valid{t.Fatal("missing stored revision")};return version}
    target:=func(t *testing.T,name string)int64{
        t.Helper();input,err:=objects.Input(map[string]query.Value{role.Login:query.String(name+"@example.test"),"@@PROFILE@@":query.String("NZ")});fileCheck(t,err)
        input,err=input.WithCollections(map[string][]int64{role.Groups:{group.ID},role.Permissions:{grant.ID}});fileCheck(t,err)
        prepared,err:=composed.Accounts().Creator().Prepare(t.Context(),actor,input,accountPasswordText);fileCheck(t,err)
        created,err:=composed.Accounts().Creator().Commit(t.Context(),actor,prepared);fileCheck(t,err);return created.ID
    }
    bind:=func(t *testing.T,id int64,fields []string,data forms.Data)formmodel.BoundForm{
        t.Helper();var overrides []formmodel.Override
        if slices.Contains(fields,"preset"){overrides=append(overrides,formmodel.OverrideField("preset",formmodel.WithImageChoiceInspector(inspector.Inspect)))}
        spec,err:=formmodel.NewSpecForFields(metadata,fields,overrides...);fileCheck(t,err)
        current:=row(t,id);bound,err:=formmodel.BindInstance(t.Context(),objects,spec,data,&current,formmodel.PostClean{});fileCheck(t,err)
        return bound.BoundForm()
    }
    upload:=func(t *testing.T,name string,content []byte)uploads.File{t.Helper();file,err:=uploads.NewFile(name,"application/octet-stream",content);fileCheck(t,err);return file}
    fileData:=func(t *testing.T,field,name string,content []byte)forms.Data{return forms.NewDataWithFiles(nil,map[string][]uploads.File{field:{upload(t,name,content)}})}
    serverPatch:=func(t *testing.T,id int64,changes map[string]query.Value)error{
        t.Helper();current:=row(t,id);prepared,err:=objects.PrepareValues(&current,changes);if err!=nil{return err};next,err:=prepared.Model();if err!=nil{return err};return prepared.Save(t.Context(),native,&next)
    }
    snapshot:=func(t *testing.T)map[string]any{
        t.Helper();accounts,err:=objects.Using(native).OrderBy(key.Asc()).All(t.Context());fileCheck(t,err)
        audits,err:=auditmodels.EventObjects.Using(native).OrderBy(auditmodels.EventFields.ID.Asc()).All(t.Context());fileCheck(t,err)
        domains,err:=domainmodels.TransitionObjects.Using(native).OrderBy(domainmodels.TransitionFields.ID.Asc()).All(t.Context());fileCheck(t,err)
        sessions,err:=sessionmodels.SessionObjects.Using(native).OrderBy(sessionmodels.SessionFields.ID.Asc()).All(t.Context());fileCheck(t,err)
        groups,err:=@@GROUP@@Objects.Using(native).All(t.Context());fileCheck(t,err)
        grants,err:=@@PERMISSION@@Objects.Using(native).All(t.Context());fileCheck(t,err)
        collections:=map[int64]map[string][]int64{}
        for _,account:=range accounts{keyValue,_,err:=objects.PrimaryKey(account);fileCheck(t,err);id,_:=keyValue.Integer();profile,err:=composed.Accounts().Reader().Get(t.Context(),actor,id);fileCheck(t,err);collections[id]=profile.View().Collections()}
        return map[string]any{"accounts":accounts,"audits":audits,"domains":domains,"sessions":sessions,"groups":groups,"permissions":grants,"collections":collections}
    }
    assertSame:=func(t *testing.T,before map[string]any){t.Helper();after:=snapshot(t);for name,wanted:=range before{if !reflect.DeepEqual(wanted,after[name]){t.Fatalf("failed file operation changed durable %s",name)}}}
    assertStored:=func(t *testing.T,publication formmodel.FilePublication,content []byte){t.Helper();reader,err:=root.Open(t.Context(),publication.Info().Name());fileCheck(t,err);actual,err:=io.ReadAll(reader);fileCheck(t,err);fileCheck(t,reader.Close());if !bytes.Equal(actual,content){t.Fatal("published content changed or was deleted")}}
    reports:=&fileReports{}
    configured,err:=settings.New(settings.Definition{ProjectName:"profile_files",InstalledApps:append(project.InstalledApps(),apps.Config{Name:"example.com/godj-project-bundle/fileadmin",Label:"fileadmin"},apps.Config{Name:"example.com/godj-project-bundle/fileapi",Label:"fileapi"})});fileCheck(t,err)
    run("construction",func(t *testing.T){
        beforeNames,beforeSaves,beforeOpens:=disk.names.Load(),disk.saves.Load(),disk.opens.Load()
        for _,files:=range [][]accountmodel.ProfileFile[fileAccount]{nil,{policies[0]},append(slices.Clone(policies),policies[0]),append(slices.Clone(policies),accountmodel.ProfileFile[fileAccount]{})}{
            invalid:=runtimeConfig.Accounts;invalid.Files=files
            if _,err:=project.NewAccountManagement(composed.SessionStore(),composed.Authenticator(),auth.PrincipalAuthorizer{},invalid);err==nil{t.Fatal("missing, duplicate or invalid file policy accepted")}
        }
        for _,field:=range []string{role.Password,role.Revision,"portrait_width","missing"}{if _,err:=accountmodel.NewProfileFile(binding,field,accountmodel.ProfileFileConfig[fileAccount]{Backend:disk,Name:func(fileAccount,uploads.File)(string,error){return "unused",nil}});err==nil{t.Fatal("non-file profile acquired publication capability")}}
        for _,config:=range []accountmodel.ProfileFileConfig[fileAccount]{{},{Backend:disk},{Name:func(fileAccount,uploads.File)(string,error){return "unused",nil}},{Backend:(*fileStorage)(nil),Name:func(fileAccount,uploads.File)(string,error){return "unused",nil}}}{if _,err:=accountmodel.NewProfileFile(binding,"document",config);err==nil{t.Fatal("incomplete publication capability accepted")}}
        if _,err:=accountmodel.NewProfileFile(binding,"preset",accountmodel.ProfileFileConfig[fileAccount]{});err==nil{t.Fatal("image choices silently acquired a storage reader")}
        extra,err:=schema.Build(schema.Definition{AppLabel:"foreign_profile_host",Models:[]schema.Model{{Name:"record",GoName:"Record",Fields:[]schema.Field{schema.CharField("title","Title",24)}}}});fileCheck(t,err)
        foreign,err:=accountmodel.Bind(role,@@ACCOUNT@@Descriptor{},append([]ir.Schema{@@SCHEMAS@@},extra)...);fileCheck(t,err)
        foreignFile,err:=accountmodel.NewProfileFile(foreign,"document",accountmodel.ProfileFileConfig[fileAccount]{Backend:disk,Name:func(fileAccount,uploads.File)(string,error){return "unused",nil}});fileCheck(t,err)
        foreignConfig:=runtimeConfig.Accounts;foreignConfig.Files=slices.Clone(policies);foreignConfig.Files[0]=foreignFile
        if _,err:=project.NewAccountManagement(composed.SessionStore(),composed.Authenticator(),auth.PrincipalAuthorizer{},foreignConfig);err==nil{t.Fatal("same-shaped foreign host policy accepted")}
        invalid:=runtimeConfig.Accounts;invalid.EditFields=append(slices.Clone(editFields),"portrait_width")
        if _,err:=project.NewAccountManagement(composed.SessionStore(),composed.Authenticator(),auth.PrincipalAuthorizer{},invalid);err==nil{t.Fatal("image size became independent account input")}
        if err:=identityadmin.RegisterAccount(admin.NewBuilder(configured.Apps()),composed.Accounts(),identityadmin.AccountRegistration{Slug:"accounts"});err==nil{t.Fatal("Admin discarded publication retention policy")}
        choiceConfig:=runtimeConfig.Accounts;choiceConfig.EditFields=[]string{"preset"};choiceConfig.Files=[]accountmodel.ProfileFile[fileAccount]{preset}
        choiceOwner,err:=project.NewAccountManagement(composed.SessionStore(),composed.Authenticator(),auth.PrincipalAuthorizer{},choiceConfig);fileCheck(t,err)
        fileCheck(t,identityadmin.RegisterAccount(admin.NewBuilder(configured.Apps()),choiceOwner,identityadmin.AccountRegistration{Slug:"choices"}))
        names:=composed.Accounts().Editor().FileFields();names[0]="mutated";if composed.Accounts().Editor().FileFields()[0]!="document"{t.Fatal("file selection aliases caller memory")}
        if beforeNames!=disk.names.Load()||beforeSaves!=disk.saves.Load()||beforeOpens!=disk.opens.Load(){t.Fatal("file policy construction performed callback or I/O")}
        if strings.Contains(fmt.Sprintf("%#v",policies),"document"){t.Fatal("file policy formatting disclosed state")}
    })
    builder:=admin.NewBuilder(configured.Apps());fileCheck(t,identityadmin.RegisterAccount(builder,composed.Accounts(),identityadmin.AccountRegistration{Slug:"accounts",ReportFileEdit:reports.record}))
    registry,err:=builder.Build();fileCheck(t,err)
    paths,err:=admin.SiteAllowedNextPaths(registry,"/admin");fileCheck(t,err)
    sessionRuntime,err:=websession.New(websession.Config{Sessions:composed.Sessions(),Authenticator:composed.Authenticator(),Authorizer:auth.PrincipalAuthorizer{},LoginPersistence:composed.LoginPersistence(),Clock:clock,SessionCookie:websession.CookieConfig{Path:"/",AllowInsecure:true},CSRFCookie:websession.CookieConfig{Path:"/",AllowInsecure:true},LoginPath:"/admin/login/",FallbackPath:"/admin/",AllowedNextPaths:paths});fileCheck(t,err)
    site,err:=admin.NewSite(admin.SiteConfig{Apps:configured.Apps(),Namespace:"fileadmin",Registry:registry,Auth:sessionRuntime});fileCheck(t,err)
    authentication,err:=apisession.New(sessionRuntime,apisession.WithReadOnlyResolution());fileCheck(t,err)
    management,err:=identityapi.NewManagement(composed.Accounts(),composed.Catalog(),identityapi.ManagementConfig{Namespace:"fileapi",Authentication:authentication});fileCheck(t,err)
    application,err:=web.NewApplication(web.Config{Settings:configured,Routes:append(site.Routes(),management.Routes()...),Middleware:management.Middleware()});fileCheck(t,err)
    server:=httptest.NewServer(application);t.Cleanup(server.Close)
    jar,err:=cookiejar.New(nil);fileCheck(t,err)
    client:=&http.Client{Transport:server.Client().Transport,Jar:jar,Timeout:30*time.Second,CheckRedirect:func(*http.Request,[]*http.Request)error{return http.ErrUseLastResponse}}
    send:=func(t *testing.T,method,path,contentType string,body io.Reader,version,token string)(int,http.Header,string){
        t.Helper();request,err:=http.NewRequestWithContext(t.Context(),method,server.URL+path,body);fileCheck(t,err)
        if contentType!=""{request.Header.Set("Content-Type",contentType)};if version!=""{request.Header.Set("If-Revision",version)};if token!=""{request.Header.Set(websession.DefaultCSRFHeader,token);request.Header.Set("Origin",server.URL)}
        response,err:=client.Do(request);fileCheck(t,err);raw,err:=io.ReadAll(response.Body);fileCheck(t,err);fileCheck(t,response.Body.Close());return response.StatusCode,response.Header,string(raw)
    }
    changePath:=func(id int64)string{return "/admin/accounts/change/?id="+strconv.FormatInt(id,10)}
    token:=func(t *testing.T,path string)string{t.Helper();status,_,body:=send(t,"GET",path,"",nil,"","");if status!=200{t.Fatal("file form GET",status)};match:=regexp.MustCompile(`name="csrfmiddlewaretoken" value="([^"]+)"`).FindStringSubmatch(body);if len(match)!=2{t.Fatal("file CSRF missing")};return html.UnescapeString(match[1])}
    loginData:=url.Values{"username":{"first@example.test"},"password":{accountPasswordText},"csrfmiddlewaretoken":{token(t,"/admin/login/")}}
    status,_,_:=send(t,"POST","/admin/login/","application/x-www-form-urlencoded",strings.NewReader(loginData.Encode()),"","");if status!=302{t.Fatal("file consumer login",status)}
    editData:=func(t *testing.T,id int64)url.Values{
        t.Helper();current:=values(t,row(t,id));data:=url.Values{"expected_revision":{strconv.FormatInt(revision(t,id),10)},"csrfmiddlewaretoken":{token(t,changePath(id))}}
        for _,name:=range baseFields{value,_:=current[name].String();data.Set(name,value)}
        for _,name:=range []string{role.Active.Field,role.Staff.Field,role.Superuser.Field}{if name!=""{if enabled,_:=current[name].Boolean();enabled{data.Set(name,"on")}}}
        if preset,_:=current["preset"].String();preset!=""{data.Set("preset",preset)}
        profile,err:=composed.Accounts().Reader().Get(t.Context(),actor,id);fileCheck(t,err)
        for _,name:=range []string{role.Groups,role.Permissions}{ids,_:=profile.View().Collection(name);for _,id:=range ids{data.Add(name,strconv.FormatInt(id,10))}}
        return data
    }
    post:=func(t *testing.T,id int64,data url.Values,files map[string][]byte)(int,string){
        t.Helper();var content bytes.Buffer;writer:=multipart.NewWriter(&content)
        names:=make([]string,0,len(data));for name:=range data{names=append(names,name)};slices.Sort(names)
        for _,name:=range names{for _,value:=range data[name]{fileCheck(t,writer.WriteField(name,value))}}
        names=names[:0];for name:=range files{names=append(names,name)};slices.Sort(names)
        for _,name:=range names{filename:="same.txt";if name=="portrait"{filename="photo.png"};part,err:=writer.CreateFormFile(name,filename);fileCheck(t,err);_,err=part.Write(files[name]);fileCheck(t,err)}
        fileCheck(t,writer.Close());status,_,body:=send(t,"POST",changePath(id),writer.FormDataContentType(),&content,"","");return status,body
    }
    targetID:=target(t,"managed-files")
    content:=[]byte("private profile document")
    portrait:=filePNG(t,3,5)
    var firstDocument string
    run("typed_edit",func(t *testing.T){
        editor,err:=project.NewAccountProfileEditor(backend,auth.PrincipalAuthorizer{},accountmodel.ProfileConfig[fileAccount]{Fields:[]string{"document","portrait"},Files:[]accountmodel.ProfileFile[fileAccount]{policies[0],policies[2]},ChangePermission:accountPermissions.Change});fileCheck(t,err)
        input:=forms.NewDataWithFiles(nil,map[string][]uploads.File{"document":{upload(t,"same.txt",content)},"portrait":{upload(t,"photo.png",portrait)}})
        definition,err:=editor.FormDefinition();fileCheck(t,err);spec,err:=definition.Spec(metadata);fileCheck(t,err)
        profile,err:=composed.Accounts().Reader().Get(t.Context(),actor,targetID);fileCheck(t,err)
        bound,err:=formmodel.BindView(t.Context(),objects,spec,input,profile.View(),formmodel.PostClean{});fileCheck(t,err);if !bound.Form().Valid(){t.Fatal("typed file form invalid")}
        before:=values(t,row(t,targetID))
        result,publications,err:=editor.UpdateForm(t.Context(),actor,targetID,1,bound);fileCheck(t,err)
        if result.Revision!=2||len(publications)!=2||!slices.Equal(result.ChangedFields,[]string{"document","portrait","portrait_width","portrait_height"}){t.Fatal("typed file edit lost dimensions, publication or revision")}
        after:=values(t,row(t,targetID));firstDocument,_=after["document"].String()
        if firstDocument!=publications[0].Info().Name()||firstDocument=="same.txt"||!after["portrait_width"].Equal(query.Integer(3))||!after["portrait_height"].Equal(query.Integer(5)){t.Fatal("typed storage result or image dimensions changed")}
        for _,name:=range []string{role.Password,role.PrincipalID,role.Active.Field,role.Staff.Field,role.Superuser.Field}{if name!=""&&!before[name].Equal(after[name]){t.Fatal("file edit changed protected account state")}}
        assertStored(t,publications[0],content);assertStored(t,publications[1],portrait)
        raw,err:=objects.Input(map[string]query.Value{"document":query.String("forged/private-name")});fileCheck(t,err)
        if _,err:=editor.Update(t.Context(),actor,targetID,2,raw);!errors.Is(err,&accountmodel.Error{Code:accountmodel.CodeInvalidInput}){t.Fatal("plain scalar input assigned a file reference",err)}
    })
    run("admin_upload",func(t *testing.T){
        for _,field:=range metadata.ManyToMany{
            if field.Blank||field.Name!=role.Groups&&field.Name!=role.Permissions{continue}
            data:=editData(t,targetID);data.Del(field.Name);before:=snapshot(t);saves,names:=disk.saves.Load(),disk.names.Load()
            status,body:=post(t,targetID,data,map[string][]byte{"document":content})
            if status!=200||!strings.Contains(body,"required")||disk.saves.Load()!=saves||disk.names.Load()!=names{t.Fatal("required collection omission reached file publication",field.Name,status)}
            assertSame(t,before)
        }
        data:=editData(t,targetID);before:=disk.saves.Load();status,body:=post(t,targetID,data,map[string][]byte{"document":content,"portrait":portrait})
        if status!=302||strings.Contains(body,"private profile document")||disk.saves.Load()!=before+2{t.Fatal("real multipart account update failed or retried",status)}
        report,_:=reports.last();publications:=report.Publications()
        if report.Err()!=nil||report.Change().Revision!=3||len(publications)!=2{t.Fatal("Admin lost confirmed publication report")}
        actual:=values(t,row(t,targetID));name,_:=actual["document"].String();if name==firstDocument||name!=publications[0].Info().Name(){t.Fatal("replacement did not retain actual collision-safe name")}
        if _,err:=root.Stat(t.Context(),firstDocument);err!=nil{t.Fatal("old file was deleted on replacement",err)}
        assertStored(t,publications[0],content)
        expired:=disk.lastUpload();if reader,err:=expired.Open(t.Context());err==nil{_ = reader.Close();t.Fatal("Admin extended request upload lifetime")}
        if strings.Contains(fmt.Sprintf("%#v",report),"same.txt"){t.Fatal("file report formatting disclosed paths")}
    })
    run("keep_clear",func(t *testing.T){
        before:=values(t,row(t,targetID));old,_:=before["portrait"].String();saves,opens:=disk.saves.Load(),disk.opens.Load()
        data:=editData(t,targetID);data.Set("document","forged/private-name")
        status,_:=post(t,targetID,data,nil);if status!=302||revision(t,targetID)!=3{t.Fatal("omitted file did not retain no-op semantics",status)}
        if !reflect.DeepEqual(before,values(t,row(t,targetID)))||disk.saves.Load()!=saves||disk.opens.Load()!=opens{t.Fatal("keep input changed state or opened storage")}
        data=editData(t,targetID);data.Set("portrait-clear","on");data.Set("document-clear","on")
        status,_=post(t,targetID,data,nil);if status!=302||revision(t,targetID)!=4{t.Fatal("file clear failed",status)}
        after:=values(t,row(t,targetID));if !after["portrait"].Equal(query.String(""))||!after["document"].Equal(query.String(""))||!after["portrait_width"].IsNull()||!after["portrait_height"].IsNull(){t.Fatal("nullable file clear lost empty-name and NULL-size distinction")}
        if disk.saves.Load()!=saves||disk.opens.Load()!=opens||disk.deletes.Load()!=0{t.Fatal("clear performed unauthorized file I/O")}
        if _,err:=root.Stat(t.Context(),old);err!=nil{t.Fatal("cleared reference deleted content",err)}
    })
    run("image_choices",func(t *testing.T){
