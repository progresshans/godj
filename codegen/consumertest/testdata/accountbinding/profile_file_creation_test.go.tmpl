        if _,err:=creator.Prepare(t.Context(),f.actor,raw,accountPasswordText);!errors.Is(err,&accountmodel.Error{Code:accountmodel.CodeInvalidInput}){t.Fatal("raw creation acquired file-reference authority",err)}
        if f.disk.saves.Load()!=beforeSaves||f.disk.names.Load()!=beforeNames||f.hasher.calls.Load()!=beforeRawHashes{t.Fatal("raw file injection performed private work")}
        bound:=f.form(t,definition,f.data(t,"typed@example.test",false));beforeHashes:=f.hasher.calls.Load()
        result,files,err:=creator.CreateForm(t.Context(),f.actor,bound,accountPasswordText);fileCheck(t,err)
        if f.hasher.calls.Load()!=beforeHashes+1{t.Fatal("typed creation repeated hashing")};typedID=result.ID;f.confirmed(t,result,files,"typed@example.test")
        profile,err:=f.runtime.Accounts().Reader().Get(t.Context(),f.actor,result.ID);fileCheck(t,err)
        if keys,_:=profile.View().Collection(f.role.Groups);!slices.Equal(keys,[]int64{f.groupID}){t.Fatal("creation lost selected group")}
