type creationFileHasher struct {
    auth.PasswordHasher
    calls atomic.Int64
    fail atomic.Bool
    mu sync.Mutex
    after func() error
}
func (hasher *creationFileHasher) Hash(ctx context.Context, raw string)(string,error){
    hasher.calls.Add(1)
    if hasher.fail.Load(){return "",errors.New("private creation hash failure")}
    encoded,err:=hasher.PasswordHasher.Hash(ctx,raw)
    hasher.mu.Lock();after:=hasher.after;hasher.after=nil;hasher.mu.Unlock()
    if err==nil&&after!=nil{err=after()};return encoded,err
}
func (hasher *creationFileHasher) setAfter(after func()error){hasher.mu.Lock();hasher.after=after;hasher.mu.Unlock()}

type creationFileReports struct{
    mu sync.Mutex
    reports []identityadmin.AccountFileCreationReport
    fail atomic.Bool
}
func (reports *creationFileReports) record(_ context.Context,report identityadmin.AccountFileCreationReport)error{
    reports.mu.Lock();reports.reports=append(reports.reports,report);reports.mu.Unlock()
    if reports.fail.Load(){return errors.New("private creation report failure")};return nil
}
func (reports *creationFileReports) last()(identityadmin.AccountFileCreationReport,int){
    reports.mu.Lock();defer reports.mu.Unlock()
    if len(reports.reports)==0{return identityadmin.AccountFileCreationReport{},0}
    return reports.reports[len(reports.reports)-1],len(reports.reports)
}

