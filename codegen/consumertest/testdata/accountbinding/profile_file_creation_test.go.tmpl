type creationFileGate struct{storage.Backend;gate chan struct{};arrivals *atomic.Int64}
func (backend *creationFileGate) Save(ctx context.Context,name string,source io.Reader,options storage.SaveOptions)(storage.Info,error){
    if backend.arrivals.Add(1)==2{close(backend.gate)}
    select{case <-backend.gate:case <-ctx.Done():return storage.Info{},&storage.Error{Code:"canceled",Outcome:storage.NotPublished,Cause:ctx.Err()}}
    return backend.Backend.Save(ctx,name,source,options)
}
