}

func TestGeneratedProfileFileCreation(t *testing.T){
    run:=func(name string,body func(*testing.T)){t.Helper();if !t.Run(name,body){t.FailNow()}}
    run("command",testProfileFileCommand)
    f:=newCreationFileFixture(t)
    run("construction",func(t *testing.T){
        before:=f.snapshot(t);names,saves,hashes:=f.disk.names.Load(),f.disk.saves.Load(),f.hasher.calls.Load()
        for _,files:=range [][]accountmodel.ProfileFile[fileAccount]{nil,{f.files[0]},append(slices.Clone(f.files),f.files[0]),append(slices.Clone(f.files),accountmodel.ProfileFile[fileAccount]{})}{
            _,err:=project.NewFirstAccountDefinition(f.hasher,accountmodel.FirstAccountConfig[fileAccount]{CreationPolicy:accountmodel.CreationPolicy[fileAccount]{Fields:f.fields,Files:files},EvidenceSHA256:strings.Repeat("b",64)})
            if err==nil{t.Fatal("incomplete creation file policy accepted")}
        }
        invalid:=append(slices.Clone(f.fields),"portrait_width")
        if _,err:=project.NewFirstAccountDefinition(f.hasher,accountmodel.FirstAccountConfig[fileAccount]{CreationPolicy:accountmodel.CreationPolicy[fileAccount]{Fields:invalid,Files:f.files},EvidenceSHA256:strings.Repeat("b",64)});err==nil{t.Fatal("creation allowed independent image dimensions")}
        extra,err:=schema.Build(schema.Definition{AppLabel:"unrelated_creation_host",Models:[]schema.Model{{Name:"record",GoName:"Record",Fields:[]schema.Field{schema.CharField("title","Title",24)}}}});fileCheck(t,err)
        foreign,err:=accountmodel.Bind(f.role,@@ACCOUNT@@Descriptor{},append([]ir.Schema{@@SCHEMAS@@},extra)...);fileCheck(t,err)
        foreignFile,err:=accountmodel.NewProfileFile(foreign,"document",accountmodel.ProfileFileConfig[fileAccount]{Backend:f.disk,Name:func(fileAccount,uploads.File)(string,error){return "never",nil}});fileCheck(t,err)
        files:=slices.Clone(f.files);files[0]=foreignFile
        if _,err:=project.NewFirstAccountDefinition(f.hasher,accountmodel.FirstAccountConfig[fileAccount]{CreationPolicy:accountmodel.CreationPolicy[fileAccount]{Fields:f.fields,Files:files},EvidenceSHA256:strings.Repeat("b",64)});err==nil{t.Fatal("foreign full source acquired creation file policy")}
        if names!=f.disk.names.Load()||saves!=f.disk.saves.Load()||hashes!=f.hasher.calls.Load(){t.Fatal("creation declaration performed callbacks or I/O")};f.same(t,before)
    })
    run("first_account",func(t *testing.T){
        owner,err:=f.definition.Bind(f.backend);fileCheck(t,err)
        raw,err:=f.objects.Input(map[string]query.Value{f.role.Login:query.String("forged@example.test"),"@@PROFILE@@":query.String("NZ"),"document":query.String("private/existing"),"portrait":query.String("private/image")});fileCheck(t,err)
        if _,err:=owner.Prepare(t.Context(),raw,accountPasswordText);!errors.Is(err,&accountmodel.Error{Code:accountmodel.CodeInvalidInput}){t.Fatal("scalar first-account input acquired file authority",err)}
        definition,err:=f.definition.FormDefinition();fileCheck(t,err);spec,err:=definition.Spec(f.metadata);fileCheck(t,err)
        forged,err:=formmodel.Bind(t.Context(),f.metadata,spec,forms.NewData(map[string][]string{f.role.Login:{"forged@example.test"},"@@PROFILE@@":{"NZ"}}),map[string]forms.Value{"document":forms.String("private/existing"),"portrait":forms.String("private/image")},formmodel.PostClean{});fileCheck(t,err)
        if _,files,err:=owner.CreateForm(t.Context(),strings.Repeat("a",64),forged,accountPasswordText);err==nil||len(files)!=0{t.Fatal("fabricated initial file became creation authority")}
        collision:=f.name("document","first@example.test","same.txt");_,err=f.root.Save(t.Context(),collision,bytes.NewReader([]byte("retained collision")),storage.SaveOptions{});fileCheck(t,err)
        before:=f.hasher.calls.Load();result,files,err:=f.first(t,t.Context(),strings.Repeat("a",64),"first@example.test",false);fileCheck(t,err)
        if f.hasher.calls.Load()!=before+1||result.Ownership.OperationID()!=strings.Repeat("a",64)||files[0].Info().Name()==collision{t.Fatal("first creation lost single hash, operation or actual collision name")}
        f.confirmed(t,result.Account,files,"first@example.test")
        receipt,err:=accountdomain.Lookup(t.Context(),f.native,result.Ownership.OperationID());fileCheck(t,err);if receipt.Generation()!=result.Ownership.Generation(){t.Fatal("first creation receipt does not match committed domain")}
        f.start(t,result)
        beforeState:=f.snapshot(t);beforeSaves,beforeHashes:=f.disk.saves.Load(),f.hasher.calls.Load()
        result,files,err=f.first(t,t.Context(),strings.Repeat("c",64),"another@example.test",false)
        if !errors.Is(err,&accountmodel.Error{Code:accountmodel.CodeNotFresh})||!reflect.DeepEqual(result,accountmodel.FirstAccountCreation{})||len(files)!=0||f.disk.saves.Load()!=beforeSaves||f.hasher.calls.Load()!=beforeHashes{t.Fatal("populated first owner published files or retried",err)};f.same(t,beforeState)
    })
    run("first_failures",func(t *testing.T){
        for _,mode:=range []string{"invalid","read_cleanup","partial","validation","hash","audit","cleanup","unknown_commit","competing_first"}{t.Run(mode,func(t *testing.T){
            fresh:=newCreationFileFixture(t);owner,err:=fresh.definition.Bind(fresh.backend);fileCheck(t,err);definition,err:=owner.FormDefinition();fileCheck(t,err)
            data:=fresh.data(t,"first-failure@example.test",mode=="partial")
            if mode=="invalid"{data=forms.NewData(map[string][]string{fresh.role.Login:{"first-failure@example.test"},"@@PROFILE@@":{"NZ"}})}
            bound:=fresh.form(t,definition,data);before:=fresh.snapshot(t)
            var concurrent map[string]any
            switch mode{
            case "read_cleanup":fresh.backend.readFailure.Store(true)
            case "partial":fresh.disk.set("partial",nil)
            case "validation":fresh.reject.Store(true)
            case "hash":fresh.hasher.fail.Store(true)
            case "audit":fresh.backend.mode.Store("audit")
            case "cleanup":fresh.backend.mode.Store("cleanup")
            case "unknown_commit":fresh.backend.mode.Store("unknown")
            case "competing_first":fresh.disk.set("",func()error{
                _,files,err:=fresh.first(t,t.Context(),strings.Repeat("d",64),"winner@example.test",false)
                if err==nil{fresh.stored(t,files);concurrent=fresh.snapshot(t)};return err
            })
            }
            result,files,err:=owner.CreateForm(t.Context(),strings.Repeat("e",64),bound,accountPasswordText)
            if err==nil||!reflect.DeepEqual(result,accountmodel.FirstAccountCreation{}){t.Fatal("failed first file creation published confirmed account",mode,err)}
            if mode=="invalid"||mode=="read_cleanup"{if len(files)!=0||fresh.disk.saves.Load()!=0||fresh.disk.names.Load()!=0||fresh.hasher.calls.Load()!=0{t.Fatal("early first refusal performed private work")}}else{if len(files)!=2{t.Fatal("first failure lost file attempts",mode,len(files))};fresh.stored(t,files)}
            if mode=="unknown_commit"{
                if !errors.Is(err,&accountmodel.Error{Code:accountmodel.CodeOutcomeUnknown}){t.Fatal("first unknown outcome flattened",err)}
                receipt,err:=accountdomain.Lookup(t.Context(),fresh.native,strings.Repeat("e",64));fileCheck(t,err);if receipt.OperationID()!=strings.Repeat("e",64){t.Fatal("first unknown receipt was lost")}
                after:=fresh.snapshot(t);if len(after["accounts"].([]fileAccount))!=1||len(after["audits"].([]auditmodels.Event))!=1||len(after["domains"].([]domainmodels.Transition))!=1{t.Fatal("first unknown commit was partial")}
            }else if mode=="competing_first"{if !errors.Is(err,&accountmodel.Error{Code:accountmodel.CodeNotFresh})||concurrent==nil{t.Fatal("first freshness was not rechecked after publication",err)};fresh.same(t,concurrent)}else{fresh.same(t,before)}
            if mode=="validation"&&fresh.hasher.calls.Load()!=0{t.Fatal("rejected actual file candidate was hashed")}
        })}
    })
    var typedID int64
    run("typed_creation",func(t *testing.T){
        creator:=f.runtime.Accounts().Creator();definition,err:=creator.FormDefinition();fileCheck(t,err)
        raw,err:=f.objects.Input(map[string]query.Value{f.role.Login:query.String("forged-native@example.test"),"@@PROFILE@@":query.String("NZ"),"document":query.String("private/existing")});fileCheck(t,err)
