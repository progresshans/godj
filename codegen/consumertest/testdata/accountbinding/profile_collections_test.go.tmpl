type collectionBackend struct {
 database.Backend
 mode string
 readFailure atomic.Bool
 reads atomic.Int64
 rootTable string
 afterRoot func(context.Context,db.RelationSession)error
}
func (backend *collectionBackend) ReadSnapshot(ctx context.Context, read func(db.Queryer) error) error {
 backend.reads.Add(1)
 err:=backend.Backend.ReadSnapshot(ctx,read)
 if backend.readFailure.Swap(false) {return errors.Join(err,errors.New("private profile read cleanup"))}
 return err
}
func (backend *collectionBackend) CoordinatedAtomicRelation(ctx context.Context, write func(db.RelationSession) error) error {
 err:=backend.Backend.CoordinatedAtomicRelation(ctx,func(scope db.RelationSession)error{
  if backend.afterRoot!=nil{conflict,ok:=scope.(db.ConflictInserter);if !ok{return errors.New("native conflict inserter missing")};scope=&collectionTamperScope{RelationSession:scope,conflict:conflict,table:backend.rootTable,after:backend.afterRoot}}
  if err:=write(scope);err!=nil{return err}
  if backend.mode=="rollback"{return errors.New("private failure after native profile writes")}
  return nil
 })
 if err==nil&&backend.mode=="unknown"{return &query.Error{Code:query.CodeCommitOutcomeUnknown}}
 return err
}
type collectionTamperScope struct{db.RelationSession;conflict db.ConflictInserter;table string;after func(context.Context,db.RelationSession)error;fired bool}
func(scope *collectionTamperScope) ValidateSession(ctx context.Context)error{return scope.RelationSession.(db.SessionValidator).ValidateSession(ctx)}
func(scope *collectionTamperScope) InsertOnConflict(ctx context.Context,plan query.ConflictInsertPlan)(bool,error){return scope.conflict.InsertOnConflict(ctx,plan)}
func(scope *collectionTamperScope) Update(ctx context.Context,plan query.UpdatePlan)(int64,error){n,err:=scope.RelationSession.Update(ctx,plan);if err==nil&&!scope.fired&&plan.Table()==scope.table{scope.fired=true;err=scope.after(ctx,scope.RelationSession)};return n,err}
type collectionProbe struct {mu sync.Mutex; last map[string][]int64; reject,filterFailure atomic.Bool}
func(probe *collectionProbe) validate(_ context.Context,_ db.Queryer,_,_ @@ACCOUNT@@, selection accountmodel.AccountMemberships)(validation.Errors,error){
 probe.mu.Lock();probe.last=selection.Collections();probe.mu.Unlock()
 if keys,present:=selection.Collection("topics");present&&len(keys)>0{
  keys[0]=-9999
  again,_:=selection.Collection("topics");if len(again)>0&&again[0]==-9999{return validation.Errors{},errors.New("membership accessor borrowed validator memory")}
 }
 if probe.reject.Load(){return validation.NewErrors(validation.New("topics","rejected")),nil}
 return validation.Errors{},nil
}
