type collectionAdminAccess struct { readOnly atomic.Bool }
func(access *collectionAdminAccess) Allowed(_ context.Context,actor auth.Principal,permission auth.Permission)(bool,error){return actor.Has(permission)&&!(access.readOnly.Load()&&permission=="account.change"),nil}

