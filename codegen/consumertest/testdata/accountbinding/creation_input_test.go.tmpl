		creationInputCheck(t, f.objects.Save(t.Context(), f.native, &row, orm.ForceUpdate[usernameAccount]()))
		current, err := f.runtime.Authenticator().Resolve(t.Context(), f.actor.ID())
		creationInputCheck(t, err)
		f.actor = current.Principal()
		if f.actor.Staff() {
			t.Fatal("reusable Form still has a staff actor")
		}
	}
	f.insert(t, "member")
	f.insert(t, "bad name")
	projectBinding, err := f.binding.Project()
	creationInputCheck(t, err)
	models := make(map[string]ir.Model)
	add := func(model ir.Model) {
		if old, present := models[model.DBTable]; present && !old.Equal(model) {
			t.Fatal("snapshot table has conflicting source metadata")
		}
		models[model.DBTable] = model
	}
	for _, schema := range append(schemas, domainmodels.GoDjRelationSchema(), auditmodels.GoDjRelationSchema(), sessionmodels.GoDjRelationSchema()) {
		for _, model := range schema.Models {
			add(model)
		}
	}
	for _, relation := range projectBinding.ManyToManyRelations() {
		model, found := projectBinding.Model(relation.Through.Model)
		if !found {
			t.Fatal("snapshot lost a through table")
		}
		add(model)
	}
	var tables []string
	for table := range models {
		tables = append(tables, table)
	}
	slices.Sort(tables)
	f.keys = make(map[string]int)
	for _, table := range tables {
		model := models[table]
		fields := make([]query.FieldRef, len(model.Fields))
		primary := -1
		for index, field := range model.Fields {
			var kind query.FieldKind
			switch field.Kind {
			case ir.FieldAuto, ir.FieldInteger, ir.FieldForeignKey:
				kind = query.FieldInteger
			case ir.FieldChar, ir.FieldEmail, ir.FieldText:
				kind = query.FieldString
			case ir.FieldBoolean:
				kind = query.FieldBoolean
			case ir.FieldDateTime:
				kind = query.FieldDateTime
			default:
				t.Fatal("snapshot needs an explicit projection for a new field kind", field.Kind)
			}
			fields[index] = query.NewFieldRef(field.Name, field.Column, kind, field.Nullable)
			if field.PrimaryKey {
				if primary != -1 || kind != query.FieldInteger {
					t.Fatal("snapshot key changed")
				}
				primary = index
			}
		}
		if primary == -1 {
			t.Fatal("snapshot lacks a primary key")
		}
		f.keys[table] = primary
		f.plans = append(f.plans, query.NewPlan(table, fields).WithOrderings(query.NewOrdering(fields[primary], query.Ascending)))
	}
	return f
}

