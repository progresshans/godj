type creationInputState map[string][][]any

func (f *creationInputFixture) snapshot(t *testing.T) creationInputState {
	t.Helper()
	state := make(creationInputState)
	visits := 0
	creationInputCheck(t, f.native.ReadSnapshot(t.Context(), func(reader db.Queryer) error {
		visits++
		if visits != 1 {
			return errors.New("snapshot repeated its callback")
		}
		for _, plan := range f.plans {
			rows, err := reader.Query(t.Context(), plan)
			if err != nil {
				if rows != nil {
					err = errors.Join(err, rows.Close())
				}
				return err
			}
			if rows == nil {
				return errors.New("snapshot has no rowset")
			}
			state[plan.Table()] = [][]any{}
			var last int64
			present := false
			for rows.Next() {
				values := make([]any, len(plan.SourceFields()))
				destinations := make([]any, len(values))
				for index := range values {
					destinations[index] = &values[index]
				}
				if err := rows.Scan(destinations...); err != nil {
					return errors.Join(err, rows.Close())
				}
				id, valid := values[f.keys[plan.Table()]].(int64)
				if !valid || present && id <= last {
					return errors.Join(errors.New("snapshot has an invalid or repeated key"), rows.Close())
				}
				last, present = id, true
				for index, value := range values {
					if raw, binary := value.([]byte); binary {
						values[index] = slices.Clone(raw)
					}
				}
				state[plan.Table()] = append(state[plan.Table()], values)
			}
			if err := errors.Join(rows.Err(), rows.Close(), t.Context().Err()); err != nil {
				return err
			}
		}
		return nil
	}))
	if visits != 1 {
		t.Fatal("snapshot skipped its callback")
	}
	return state
}
func (f *creationInputFixture) recorded(clear bool) []string {
	f.mu.Lock()
	defer f.mu.Unlock()
	values := append([]string{}, f.profiles...)
	if clear {
		f.profiles = nil
	}
	return values
}
