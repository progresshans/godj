func (f *creationInputFixture) codes(form *accountmodel.CreationForm[usernameAccount], errors validation.Errors) map[string][]string {
	result := make(map[string][]string)
	names := form.PasswordFields()
	for _, item := range errors.All() {
		name := string(item.Field())
		switch name {
		case f.role.Login:
			name = "username"
		case names.First:
			name = "password1"
		case names.Confirmation:
			name = "password2"
		}
		result[name] = append(result[name], string(item.Code()))
	}
	return result
}
func creationInputProfiles(want creationInputObservation) []string {
	values := []string{}
	for _, profile := range want.Profiles {
		name := ""
		if profile != nil {
			name = *profile
		}
		values = append(values, name)
	}
	return values
}

func (f *creationInputFixture) saved(t *testing.T, before creationInputState, created accountmodel.Creation, name, raw string, usable bool) map[string]any {
	t.Helper()
	if created.ID <= 0 || created.Revision != 1 {
		t.Fatal("creation did not publish a confirmed receipt")
	}
	row, err := f.objects.Using(f.native).Filter(f.key.Exact(created.ID)).Get(t.Context())
	creationInputCheck(t, err)
	values, err := f.objects.ModelValues(row)
	creationInputCheck(t, err)
	actual, _ := values[f.role.Login].String()
	profile, _ := values["@@PROFILE@@"].String()
	principal, _ := values[f.role.PrincipalID].String()
	revision, _ := values[f.role.Revision].Integer()
	if actual != name || profile != "NZ" || principal == "" || revision != 1 || f.role.LastLogin != "" && !values[f.role.LastLogin].IsNull() {
		t.Fatal("stored creation profile differs")
	}
	credential, found, err := f.runtime.Credentials().CredentialByID(t.Context(), principal)
	creationInputCheck(t, err)
	if !found || credential.HasUsablePassword() != usable || !credential.Principal().Active() || credential.Principal().Staff() || credential.Principal().Superuser() {
		t.Fatal("stored creation credential defaults differ")
	}
	if f.role.Login != "username" {
		for field, expected := range map[string]string{"username": "unrelated-name", "password1": "unrelated-command-name"} {
			value, _ := values[field].String()
			if value != expected {
				t.Fatal("login or command projection overwrote an unselected profile")
			}
		}
	}
	if f.role.CreatedAt != "" && !values[f.role.CreatedAt].Equal(query.DateTime(f.now)) {
		t.Fatal("creation lost its server time")
	}
	if raw != "" {
		_, err := f.runtime.Authenticator().Authenticate(t.Context(), name, raw)
		if usable && err != nil || !usable && !errors.Is(err, auth.ErrInvalidCredentials) {
			t.Fatal("created credential has a different password outcome", err)
		}
	}
	audits, err := auditmodels.EventObjects.Using(f.native).OrderBy(auditmodels.EventFields.ID.Asc()).All(t.Context())
	creationInputCheck(t, err)
	auditMetadata := (auditmodels.EventDescriptor{}).Metadata()
	if len(audits) != len(before[auditMetadata.DBTable])+1 {
		t.Fatal("creation did not add one audit")
	}
	event := audits[len(audits)-1]
	domain, _ := f.actor.CredentialDomain()
	if event.ObjectID != created.ID || event.Model != f.role.Model.AppLabel+"."+f.role.Model.ModelName || event.ActorID != f.actor.ID() || event.Domain != domain.Identifier() || event.Action != string(admin.ActionAdd) {
		t.Fatal("creation audit differs from the current owner")
	}
	after := f.snapshot(t)
	for table, id := range map[string]int64{f.metadata.DBTable: created.ID, auditMetadata.DBTable: event.ID} {
		index := f.keys[table]
		removed := 0
		retained := make([][]any, 0, len(after[table]))
		for _, row := range after[table] {
			if row[index] == id {
				removed++
			} else {
				retained = append(retained, row)
			}
		}
		if removed != 1 || len(after[table]) != len(before[table])+1 {
			t.Fatal("creation changed unexpected row cardinality")
		}
		after[table] = retained
	}
	if !reflect.DeepEqual(before, after) {
		t.Fatal("creation changed an unrelated native row, membership, session or domain")
	}
	return map[string]any{"usable": credential.HasUsablePassword(), "active": credential.Principal().Active(),
		"staff": credential.Principal().Staff(), "superuser": credential.Principal().Superuser(),
		"last_login_none": f.role.LastLogin == "" || values[f.role.LastLogin].IsNull()}
}

func (f *creationInputFixture) bindProbe(t *testing.T, mode string, probe creationInputCase, want creationInputObservation) {
	t.Helper()
	form := f.form(t, mode)
	before := f.snapshot(t)
	hashes, ids := f.hasher.calls.Load(), f.ids.Load()
	f.recorded(true)
	bound, err := form.Bind(t.Context(), f.actor, f.data(form, mode, probe))
	creationInputCheck(t, err)
	name, present := bound.Form().Cleaned().String(f.role.Login)
	if bound.Form().Valid() != want.Valid || !reflect.DeepEqual(f.codes(form, bound.Form().Errors()), want.Codes) || present != (want.Username != nil) || present && name != *want.Username {
		t.Fatal("selected reusable Form differs from independent input observation", f.codes(form, bound.Form().Errors()), want.Codes)
	}
	if !reflect.DeepEqual(f.recorded(false), creationInputProfiles(want)) {
		t.Fatal("password policy observed a different candidate")
	}
	if want.UserDelta != 0 || f.hasher.calls.Load() != hashes || f.ids.Load() != ids || !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("Bind allocated identity, hashed or changed durable state")
	}
}

func (f *creationInputFixture) lifecycle(t *testing.T, mode, operation string, want map[string]any) {
	t.Helper()
	form := f.form(t, mode)
	name := "Lifecycle_" + mode + "_" + operation
	if operation == "invalid" {
		name = "MEMBER"
	}
	probe := creationInputCase{Username: name, Password1: "independent-secret", Password2: "independent-secret"}
	before := f.snapshot(t)
	hashes := f.hasher.calls.Load()
	state := func() map[string]any {
		snapshot := f.snapshot(t)
		return map[string]any{"user_delta": len(snapshot[f.metadata.DBTable]) - len(before[f.metadata.DBTable]), "hashes": f.hasher.calls.Load() - hashes}
	}
	bound, err := form.Bind(t.Context(), f.actor, f.data(form, mode, probe))
	creationInputCheck(t, err)
	actual := map[string]any{"valid": bound.Form().Valid(), "checked": state()}
	var created accountmodel.Creation
	if operation == "immediate" {
		var publications []formmodel.FilePublication
		created, publications, err = form.Create(t.Context(), f.actor, bound)
		creationInputCheck(t, err)
		if len(publications) != 0 {
			t.Fatal("scalar creation published a file")
		}
		phase := state()
		phase["pk_set"] = created.ID > 0
		actual["prepared"] = phase
	} else {
		prepared, publications, failure := form.Prepare(t.Context(), f.actor, bound)
		if len(publications) != 0 {
			t.Fatal("scalar preparation published a file")
		}
		if operation == "invalid" {
			_, rejected := validation.Rejected(failure)
			actual["rejected"] = rejected
			if failure == nil || !rejected {
				t.Fatal("invalid Form reached preparation", failure)
			}
		} else {
			creationInputCheck(t, failure)
			phase := state()
			phase["pk_set"] = false
			actual["prepared"] = phase
			encoded, err := json.Marshal(prepared)
			creationInputCheck(t, err)
			printed := fmt.Sprintf("%v %+v %#v %x %p", prepared, prepared, prepared, prepared, prepared) + string(encoded)
			if strings.Contains(printed, probe.Password1) || strings.Contains(printed, name) || strings.Contains(printed, "generated-user-") {
				t.Fatal("prepared creation exposed private input")
			}
		}
		if !reflect.DeepEqual(before, f.snapshot(t)) {
			t.Fatal("Prepare changed native rows")
		}
		if operation == "deferred" {
			created, err = form.Commit(t.Context(), f.actor, prepared)
			creationInputCheck(t, err)
			copyResult, failure := form.Commit(t.Context(), f.actor, prepared)
			if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodeConflict}) || copyResult.ID != 0 {
				t.Fatal("prepared creation was reused", failure)
			}
		}
	}
	for key, value := range state() {
		actual[key] = value
	}
	if created.ID != 0 {
		for key, value := range f.saved(t, before, created, name, probe.Password1, mode != "admin_disabled") {
			actual[key] = value
		}
	} else if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("abandoned or rejected creation wrote")
	}
	expected := make(map[string]any)
	for key, value := range want {
		switch key {
		case "usable", "active", "staff", "superuser", "last_login_none":
			// An opaque abandoned candidate has no public model attributes.
			// Compare all five values directly to the independent capture once
			// the account is actually stored.
			if created.ID == 0 {
				continue
			}
		}
		expected[key] = value
	}
	got, err := json.Marshal(actual)
	creationInputCheck(t, err)
	reference, err := json.Marshal(expected)
	creationInputCheck(t, err)
	if !slices.Equal(got, reference) {
		t.Fatal("selected creation lifecycle differs from independent observation")
	}
}

func (f *creationInputFixture) preparedOwnership(t *testing.T, operation, mode string) {
	t.Helper()
	formMode := "standard"
	wantHashes := int64(1)
	if mode == "unusable" {
		formMode, wantHashes = "admin_disabled", 0
	}
	form := f.form(t, formMode)
	name := "Owner_" + operation + "_" + mode
	probe := creationInputCase{Username: name, Password1: "independent-secret", Password2: "independent-secret"}
	var otherActor auth.Principal
	if operation == "unadmitted_calls" {
		other := f.insert(t, "Authorized_"+mode)
		row, err := f.objects.Using(f.native).Filter(f.key.Exact(other.ID)).Get(t.Context())
		creationInputCheck(t, err)
		row, err = f.objects.ApplyValues(row, map[string]query.Value{f.role.Superuser.Field: query.Boolean(true), f.role.Revision: query.Integer(2)})
		creationInputCheck(t, err)
		creationInputCheck(t, f.objects.Save(t.Context(), f.native, &row, orm.ForceUpdate[usernameAccount]()))
		values, err := f.objects.ModelValues(row)
		creationInputCheck(t, err)
		id, _ := values[f.role.PrincipalID].String()
		credential, found, err := f.runtime.Credentials().CredentialByID(t.Context(), id)
		creationInputCheck(t, err)
		otherActor = credential.Principal()
		if !found || !otherActor.Active() || !otherActor.Superuser() || otherActor.ID() == f.actor.ID() {
			t.Fatal("second actor does not have independent current authority")
		}
	}
	before := f.snapshot(t)
	hashes, ids := f.hasher.calls.Load(), f.ids.Load()
	bound, err := form.Bind(t.Context(), f.actor, f.data(form, formMode, probe))
	creationInputCheck(t, err)
	if !bound.Form().Valid() {
		t.Fatal("prepared ownership fixture has invalid inputs")
	}
	prepared, publications, err := form.Prepare(t.Context(), f.actor, bound)
	creationInputCheck(t, err)
	if len(publications) != 0 || f.hasher.calls.Load() != hashes+wantHashes || f.ids.Load() != ids+1 || !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("ownership preparation repeated private work or changed native state")
	}
	retained := prepared
	if operation == "unadmitted_calls" {
		// Prove that another currently authorized actor is rejected by the
		// prepared capability's ownership, not merely by an ordinary deny.
		otherBound, err := form.Bind(t.Context(), otherActor, f.data(form, formMode, probe))
		creationInputCheck(t, err)
		if !otherBound.Form().Valid() {
			t.Fatal("second actor lacked current creation authority")
		}
		result, failure := form.Commit(t.Context(), otherActor, retained)
		if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodePermission}) || !reflect.DeepEqual(result, accountmodel.Creation{}) {
			t.Fatal("authorized foreign actor adopted a prepared operation", failure)
		}
		canceled, cancel := context.WithCancel(t.Context())
		cancel()
		result, failure = form.Commit(canceled, f.actor, retained)
		if !errors.Is(failure, context.Canceled) || !reflect.DeepEqual(result, accountmodel.Creation{}) {
			t.Fatal("unadmitted canceled call lost its cause", failure)
		}
		result, failure = form.Commit(t.Context(), f.actor, accountmodel.PreparedCreation[usernameAccount]{})
		if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodeInvalidInput}) || !reflect.DeepEqual(result, accountmodel.Creation{}) {
			t.Fatal("zero prepared operation reached persistence", failure)
		}
		if f.hasher.calls.Load() != hashes+wantHashes || f.ids.Load() != ids+1 || !reflect.DeepEqual(before, f.snapshot(t)) {
			t.Fatal("unadmitted calls allocated, rehashed or changed native state")
		}
	}
	var created accountmodel.Creation
	if operation == "concurrent_copies" {
		type result struct {
			creation accountmodel.Creation
			err      error
		}
		start := make(chan struct{})
		results := make(chan result, 4)
		var workers sync.WaitGroup
		for range 4 {
			workers.Add(1)
			go func(copy accountmodel.PreparedCreation[usernameAccount]) {
				defer workers.Done()
				<-start
				creation, err := form.Commit(t.Context(), f.actor, copy)
				results <- result{creation, err}
			}(prepared)
		}
		close(start)
		workers.Wait()
		close(results)
		succeeded, conflicted := 0, 0
		for result := range results {
			if result.err == nil {
				created = result.creation
				succeeded++
			} else if errors.Is(result.err, &accountmodel.Error{Code: accountmodel.CodeConflict}) && reflect.DeepEqual(result.creation, accountmodel.Creation{}) {
				conflicted++
			} else {
				t.Fatal("prepared copy produced an unexpected concurrent outcome", result.err)
			}
		}
		if succeeded != 1 || conflicted != 3 {
			t.Fatal("prepared copies did not share exactly one attempt", succeeded, conflicted)
		}
	} else {
		created, err = form.Commit(t.Context(), f.actor, prepared)
		creationInputCheck(t, err)
	}
	f.saved(t, before, created, name, probe.Password1, mode != "unusable")
	if operation == "single_attempt_after_delete" {
		removed, err := f.runtime.Accounts().Deleter().Delete(t.Context(), f.actor, created.ID, created.Revision)
		creationInputCheck(t, err)
		if removed.ID != created.ID || removed.DeletedRows != 1 || removed.RevokedSessions != 0 {
			t.Fatal("prepared deletion fixture changed unrelated data")
		}
		audits, err := auditmodels.EventObjects.Using(f.native).OrderBy(auditmodels.EventFields.ID.Asc()).All(t.Context())
		creationInputCheck(t, err)
		table := (auditmodels.EventDescriptor{}).Metadata().DBTable
		if len(audits) != len(before[table])+2 {
			t.Fatal("create and delete did not produce exactly two audits")
		}
		event := audits[len(audits)-1]
		domain, _ := f.actor.CredentialDomain()
		if event.ObjectID != created.ID || event.Model != f.role.Model.AppLabel+"."+f.role.Model.ModelName || event.ActorID != f.actor.ID() || event.Domain != domain.Identifier() || event.Action != string(admin.ActionDelete) {
			t.Fatal("deletion audit differs from the current owner")
		}
		after := f.snapshot(t)
		if len(after[table]) != len(before[table])+2 {
			t.Fatal("physical audit rows disagree with typed deletion observations")
		}
		after[table] = after[table][:len(before[table])]
		if !reflect.DeepEqual(before, after) {
			t.Fatal("creation followed by deletion changed other rows or retained its account")
		}
	}
	beforeReplay := f.snapshot(t)
	replayed, failure := form.Commit(t.Context(), f.actor, retained)
	if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodeConflict}) || !reflect.DeepEqual(replayed, accountmodel.Creation{}) ||
		f.hasher.calls.Load() != hashes+wantHashes || f.ids.Load() != ids+1 || !reflect.DeepEqual(beforeReplay, f.snapshot(t)) {
		t.Fatal("consumed prepared copy allocated, rehashed or changed durable state", failure)
	}
}

type creationInputHTTP struct {
	fixture *creationInputFixture
	client  *http.Client
	server  *httptest.Server
}

var creationInputToken = regexp.MustCompile(`name="csrfmiddlewaretoken" value="([A-Za-z0-9_-]{128})"`)

func (f *creationInputFixture) admin(t *testing.T) *creationInputHTTP {
	t.Helper()
	configured, err := settings.New(settings.Definition{ProjectName: "creation_inputs", InstalledApps: append(project.InstalledApps(), apps.Config{Name: "example.com/godj-project-bundle/consumer", Label: "creationinput"})})
	creationInputCheck(t, err)
	builder := admin.NewBuilder(configured.Apps())
	creationInputCheck(t, identityadmin.RegisterAccount(builder, f.runtime.Accounts(), identityadmin.AccountRegistration{Slug: "accounts", CreationLoginInput: accountmodel.UnicodeUsernameInput(150)}))
	registry, err := builder.Build()
	creationInputCheck(t, err)
	paths, err := admin.SiteAllowedNextPaths(registry, "/admin")
	creationInputCheck(t, err)
	runtime, err := websession.New(websession.Config{Sessions: f.runtime.Sessions(), Authenticator: f.runtime.Authenticator(), Authorizer: auth.PrincipalAuthorizer{}, LoginPersistence: f.runtime.LoginPersistence(), Clock: func() time.Time { return f.now },
		SessionCookie: websession.CookieConfig{Path: "/", AllowInsecure: true}, CSRFCookie: websession.CookieConfig{Path: "/", AllowInsecure: true}, LoginPath: "/admin/login/", FallbackPath: "/admin/", AllowedNextPaths: paths})
	creationInputCheck(t, err)
	site, err := admin.NewSite(admin.SiteConfig{Apps: configured.Apps(), Namespace: "creationinput", Registry: registry, Auth: runtime})
	creationInputCheck(t, err)
	app, err := web.NewApplication(web.Config{Settings: configured, Routes: site.Routes()})
	creationInputCheck(t, err)
	h := &creationInputHTTP{fixture: f, server: httptest.NewServer(app)}
	t.Cleanup(h.server.Close)
	jar, err := cookiejar.New(nil)
	creationInputCheck(t, err)
	h.client = &http.Client{Transport: h.server.Client().Transport, Jar: jar, Timeout: 30 * time.Second, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
	status, _, body := h.send(t, "GET", "/admin/login/", nil)
	if status != 200 {
		t.Fatal("login page", status)
	}
	token := creationInputToken.FindSubmatch(body)
	if len(token) != 2 {
		t.Fatal("login token missing")
	}
	status, _, _ = h.send(t, "POST", "/admin/login/", url.Values{"username": {"manager"}, "password": {accountPasswordText}, "csrfmiddlewaretoken": {string(token[1])}})
	if status != 302 {
		t.Fatal("selected Admin login", status)
	}
	return h
}
func (h *creationInputHTTP) send(t *testing.T, method, path string, data url.Values) (int, http.Header, []byte) {
	t.Helper()
	var body io.Reader
	if data != nil {
		body = strings.NewReader(data.Encode())
	}
	request, err := http.NewRequestWithContext(t.Context(), method, h.server.URL+path, body)
	creationInputCheck(t, err)
	if data != nil {
		request.Header.Set("Content-Type", "application/x-www-form-urlencoded")
		request.Header.Set("Origin", h.server.URL)
	}
	response, err := h.client.Do(request)
	creationInputCheck(t, err)
	raw, err := io.ReadAll(response.Body)
	creationInputCheck(t, err)
	creationInputCheck(t, response.Body.Close())
	return response.StatusCode, response.Header, raw
}

func creationInputDiagnostics(t *testing.T, form *accountmodel.CreationForm[usernameAccount], body []byte) validation.Errors {
	t.Helper()
	failures := []validation.Violation{}
	for _, match := range regexp.MustCompile(`data-error-field="([^"]+)" data-error-code="([^"]+)"`).FindAllSubmatch(body, -1) {
		failures = append(failures, validation.New(validation.Field(html.UnescapeString(string(match[1]))), validation.Code(html.UnescapeString(string(match[2])))))
	}
	names := form.PasswordFields()
	for _, input := range regexp.MustCompile(`<input[^>]*>`).FindAll(body, -1) {
		for _, name := range []string{names.First, names.Confirmation} {
			if strings.Contains(string(input), `name="`+name+`"`) {
				value := regexp.MustCompile(`value="([^"]*)"`).FindSubmatch(input)
				if len(value) != 0 && len(value[1]) != 0 {
					t.Fatal("rejected Admin form redisplayed a password")
				}
			}
		}
	}
	return validation.NewErrors(failures...)
}

func (h *creationInputHTTP) probe(t *testing.T, mode string, probe creationInputCase, want creationInputObservation) {
	t.Helper()
	f := h.fixture
	form := f.form(t, mode)
	names := form.PasswordFields()
	status, _, body := h.send(t, "GET", "/admin/accounts/add/", nil)
	if status != 200 {
		t.Fatal("creation page", status)
	}
	token := creationInputToken.FindSubmatch(body)
	if len(token) != 2 {
		t.Fatal("creation token missing")
	}
	data := url.Values{f.role.Login: {probe.Username}, "@@PROFILE@@": {"NZ"}, names.First: {probe.Password1}, names.Confirmation: {probe.Password2}, "csrfmiddlewaretoken": {string(token[1])}}
	if mode == "admin_disabled" {
		data[names.Unusable] = []string{"true"}
	}
	before := f.snapshot(t)
	hashes, ids := f.hasher.calls.Load(), f.ids.Load()
	f.recorded(true)
	status, header, body := h.send(t, "POST", "/admin/accounts/add/", data)
	expectedStatus := 200
	if want.Valid {
		expectedStatus = 302
	}
	if status != expectedStatus || want.Valid && !strings.HasPrefix(header.Get("Location"), "/admin/accounts/") {
		t.Fatal("selected Admin creation response", status)
	}
	if !reflect.DeepEqual(f.codes(form, creationInputDiagnostics(t, form, body)), want.Codes) {
		t.Fatal("Admin input phases differ from independent reference")
	}
	profiles := creationInputProfiles(want)
	expectedHashes, expectedIDs := int64(0), int64(0)
	if want.Valid {
		expectedIDs = 1
		if mode == "admin_enabled" {
			expectedHashes = 1
			// Selected creation checks before hashing, before insertion and
			// again against the final collected graph. These are Go fences,
			// in addition to the one independent Form policy observation.
			profiles = append(profiles, *want.Username, *want.Username, *want.Username)
		}
		row, err := f.objects.Using(f.native).Filter(f.login.Exact(*want.Username)).Get(t.Context())
		creationInputCheck(t, err)
		key, present, err := f.objects.PrimaryKey(row)
		creationInputCheck(t, err)
		id, valid := key.Integer()
		if !present || !valid {
			t.Fatal("Admin creation lost its key")
		}
		f.saved(t, before, accountmodel.Creation{ID: id, Revision: 1}, *want.Username, probe.Password1, mode != "admin_disabled")
	} else if !reflect.DeepEqual(before, f.snapshot(t)) {
		t.Fatal("rejected Admin input changed native rows")
	}
	if !reflect.DeepEqual(f.recorded(false), profiles) || f.hasher.calls.Load()-hashes != expectedHashes || f.ids.Load()-ids != expectedIDs {
		t.Fatal("Admin creation lost candidate phases or performed extra work")
	}
}

func TestCreationInputPolicy(t *testing.T) {
	cases, reference := creationInputReferenceData(t)
	for _, surface := range []string{"form", "admin"} {
		creationInputRun(t, surface, func(t *testing.T) {
			modes := []string{"standard", "admin_enabled", "admin_disabled"}
			if surface == "admin" {
				modes = modes[1:]
			}
			for _, mode := range modes {
				creationInputRun(t, mode, func(t *testing.T) {
					f := newCreationInputFixture(t, surface == "form")
					var h *creationInputHTTP
					if surface == "admin" {
						h = f.admin(t)
					}
					for _, probe := range cases {
						creationInputRun(t, probe.Name, func(t *testing.T) {
							want, found := reference.Observations[mode][probe.Name]
							if !found {
								t.Fatal("reference omitted input")
							}
							if h != nil {
								h.probe(t, mode, probe, want)
							} else {
								f.bindProbe(t, mode, probe, want)
							}
						})
					}
					if surface == "form" {
						for _, operation := range []string{"immediate", "deferred", "abandoned", "invalid"} {
							creationInputRun(t, "lifecycle_"+operation, func(t *testing.T) { f.lifecycle(t, mode, operation, reference.Lifecycle[mode][operation]) })
						}
					}
				})
			}
		})
	}
	creationInputRun(t, "boundaries", func(t *testing.T) {
		f := newCreationInputFixture(t, true)
		form := f.form(t, "standard")
		creationInputRun(t, "stored_limit", func(t *testing.T) {
			name := strings.Repeat("long", 50)
			before := f.snapshot(t)
			created := f.insert(t, name)
			f.saved(t, before, created, name, "", false)
			row, err := f.objects.Using(f.native).Filter(f.key.Exact(created.ID)).Get(t.Context())
			creationInputCheck(t, err)
			definition, err := f.runtime.Accounts().FormDefinition(admin.ActionChange)
			creationInputCheck(t, err)
			spec, err := definition.Spec(f.metadata)
			creationInputCheck(t, err)
			for _, field := range spec.Fields() {
				if field.Name() == f.role.Login && field.MaxLength() != 256 {
					t.Fatal("creation narrowing changed editing")
				}
			}
			instance, err := formmodel.BindInstance(t.Context(), f.objects, spec, forms.NewData(map[string][]string{f.role.Login: {name}, "@@PROFILE@@": {"NZ"}}), &row, definition.PostClean)
			creationInputCheck(t, err)
			if !instance.BoundForm().Form().Valid() {
				t.Fatal("existing long login cannot round-trip through editing")
			}
			creationInputCheck(t, f.runtime.Accounts().CheckChangeForm(t.Context(), f.actor, created.ID, 1, instance.BoundForm()))
		})
		creationInputRun(t, "raw_normalization_limit", func(t *testing.T) {
			before := f.snapshot(t)
			hashes, ids := f.hasher.calls.Load(), f.ids.Load()
			bound, err := form.Bind(t.Context(), f.actor, f.data(form, "standard", creationInputCase{Username: strings.Repeat("Å", 76), Password1: "independent-secret", Password2: "independent-secret"}))
			creationInputCheck(t, err)
			if bound.Form().Valid() || bound.Form().Errors().ByField(validation.Field(f.role.Login)).Empty() || f.hasher.calls.Load() != hashes || f.ids.Load() != ids || !reflect.DeepEqual(before, f.snapshot(t)) {
				t.Fatal("normalization erased the raw input bound")
			}
		})
		for _, kind := range []string{"length", "grammar", "normalization"} {
			creationInputRun(t, "forged_"+kind, func(t *testing.T) {
				loose, err := f.runtime.Accounts().Creator().FormDefinition()
				creationInputCheck(t, err)
				strict := form.Definition()
				loose.ExtraFields, loose.Validators = strict.ExtraFields, strict.Validators
				spec, err := loose.Spec(f.metadata)
				creationInputCheck(t, err)
				name := "bad input"
				if kind == "length" {
					name = strings.Repeat("z", 200)
				}
				if kind == "normalization" {
					name = "\x1cUntrimmed\x1c"
				}
				instance, err := formmodel.BindInstance(t.Context(), f.objects, spec, f.data(form, "standard", creationInputCase{Username: name, Password1: "independent-secret", Password2: "independent-secret"}), nil, loose.PostClean)
				creationInputCheck(t, err)
				if !instance.BoundForm().Form().Valid() {
					t.Fatal("weaker projection did not produce a valid test input")
				}
				before := f.snapshot(t)
				hashes, ids := f.hasher.calls.Load(), f.ids.Load()
				_, publications, failure := form.Prepare(t.Context(), f.actor, instance.BoundForm())
				failures, rejected := validation.Rejected(failure)
				if !rejected || failures.ByField(validation.Field(f.role.Login)).Empty() || len(publications) != 0 || f.hasher.calls.Load() != hashes || f.ids.Load() != ids || !reflect.DeepEqual(before, f.snapshot(t)) {
					t.Fatal("prepared creation trusted a weaker login projection", failure)
				}
			})
		}
		creationInputRun(t, "late_duplicate", func(t *testing.T) {
			probe := creationInputCase{Username: "RacingUsername", Password1: "independent-secret", Password2: "independent-secret"}
			bound, err := form.Bind(t.Context(), f.actor, f.data(form, "standard", probe))
			creationInputCheck(t, err)
			if !bound.Form().Valid() {
				t.Fatal("fresh duplicate fixture was invalid")
			}
			before := f.snapshot(t)
			prepared, publications, err := form.Prepare(t.Context(), f.actor, bound)
			creationInputCheck(t, err)
			if len(publications) != 0 || !reflect.DeepEqual(before, f.snapshot(t)) {
				t.Fatal("Prepare wrote before the competing account")
			}
			f.insert(t, "racingusername")
			before = f.snapshot(t)
			hashes := f.hasher.calls.Load()
			created, failure := form.Commit(t.Context(), f.actor, prepared)
			failures, rejected := validation.Rejected(failure)
			if !rejected || failures.ByField(validation.Field(f.role.Login)).Empty() || created.ID != 0 || f.hasher.calls.Load() != hashes || !reflect.DeepEqual(before, f.snapshot(t)) {
				t.Fatal("late case-insensitive duplicate was not fenced", failure)
			}
			_, failure = form.Commit(t.Context(), f.actor, prepared)
			if !errors.Is(failure, &accountmodel.Error{Code: accountmodel.CodeConflict}) || !reflect.DeepEqual(before, f.snapshot(t)) {
				t.Fatal("failed creation attempt was reused", failure)
			}
		})
	})
	creationInputRun(t, "prepared_ownership", func(t *testing.T) {
		f := newCreationInputFixture(t, true)
		for _, operation := range []string{"single_attempt_after_delete", "concurrent_copies", "unadmitted_calls"} {
			creationInputRun(t, operation, func(t *testing.T) {
				for _, mode := range []string{"usable", "unusable"} {
					creationInputRun(t, mode, func(t *testing.T) { f.preparedOwnership(t, operation, mode) })
				}
			})
		}
	})
}
