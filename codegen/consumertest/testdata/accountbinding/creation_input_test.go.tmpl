//go:embed testdata/user-creation-*.json
var creationInputReferences embed.FS

type usernameAccount = @@ACCOUNT@@
type creationInputCase struct{ Name, Username, Password1, Password2 string }
type creationInputObservation struct {
	Valid     bool
	Codes     map[string][]string
	Username  *string   `json:"cleaned_username"`
	Profiles  []*string `json:"policy_profiles"`
	UserDelta int       `json:"user_delta"`
}
type creationInputReference struct {
	Django, Python, Unicode, Backend string
	InputSHA                         string            `json:"input_sha256"`
	Sources                          map[string]string `json:"source_sha256"`
	Observations                     map[string]map[string]creationInputObservation
	Lifecycle                        map[string]map[string]map[string]any
}

func creationInputCheck(t *testing.T, err error) {
	t.Helper()
	if err != nil {
		t.Fatal(err)
	}
}
func creationInputRun(t *testing.T, name string, body func(*testing.T)) {
	t.Helper()
	if !t.Run(name, body) {
		t.FailNow()
	}
}

func creationInputReferenceData(t *testing.T) ([]creationInputCase, creationInputReference) {
	t.Helper()
	raw, err := creationInputReferences.ReadFile("testdata/user-creation-inputs.json")
	creationInputCheck(t, err)
	var cases []creationInputCase
	creationInputCheck(t, json.Unmarshal(raw, &cases))
	if len(cases) != 20 {
		t.Fatal("independent creation input corpus is incomplete")
	}
	digest := sha256.Sum256(raw)
	var reference creationInputReference
	var previous []byte
	for _, vendor := range []string{"sqlite", "postgres"} {
		data, err := creationInputReferences.ReadFile("testdata/user-creation-django61-" + vendor + ".json")
		creationInputCheck(t, err)
		reference = creationInputReference{}
		creationInputCheck(t, json.Unmarshal(data, &reference))
		if reference.Django != "6.1" || reference.Python != "3.14.3" || reference.Unicode != "16.0.0" || reference.Backend != vendor ||
			reference.InputSHA != hex.EncodeToString(digest[:]) || len(reference.Sources) != 6 || len(reference.Observations) != 3 || len(reference.Lifecycle) != 3 {
			t.Fatal("creation reference lost its independent runtime or input binding")
		}
		for _, source := range []string{"auth_forms", "base_user", "hashers", "model_base", "model_forms", "password_validation"} {
			raw, err := hex.DecodeString(reference.Sources[source])
			if err != nil || len(raw) != 32 || hex.EncodeToString(raw) != reference.Sources[source] {
				t.Fatal("creation reference lost a producer source")
			}
		}
		observed, err := json.Marshal(struct {
			Observations any
			Lifecycle    any
			Sources      any
		}{reference.Observations, reference.Lifecycle, reference.Sources})
		creationInputCheck(t, err)
		if previous != nil && !slices.Equal(previous, observed) {
			t.Fatal("independent backend observations differ")
		}
		previous = observed
		for _, mode := range []string{"standard", "admin_enabled", "admin_disabled"} {
			if len(reference.Observations[mode]) != len(cases) || len(reference.Lifecycle[mode]) != 4 {
				t.Fatal("creation reference omitted a required observation")
			}
		}
	}
	return cases, reference
}

type creationInputHasher struct {
	auth.PasswordHasher
	calls atomic.Int64
}

func (hasher *creationInputHasher) Hash(ctx context.Context, raw string) (string, error) {
	hasher.calls.Add(1)
	return hasher.PasswordHasher.Hash(ctx, raw)
}

