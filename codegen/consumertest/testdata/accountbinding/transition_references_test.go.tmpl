    }
    for _,name:=range []string{"missing","title","owner"}{bad:=ticketConfig;bad.RevisionField=name;if _,err:=accountmodel.NewTransitionReference(sourceBinding,targetBinding,ir.ModelIdentity{AppLabel:"host",ModelName:"ticket"},host.TicketDescriptor{},bad);err==nil{t.Fatal("invalid reference revision accepted")}}
    for _,maximum:=range []int{-1,accountmodel.MaximumTransitionReferenceRows+1}{bad:=ticketConfig;bad.MaxRows=maximum;if _,err:=accountmodel.NewTransitionReference(sourceBinding,targetBinding,ir.ModelIdentity{AppLabel:"host",ModelName:"ticket"},host.TicketDescriptor{},bad);err==nil{t.Fatal("invalid reference budget accepted")}}
    bad:=config;bad.References=append(slices.Clone(config.References),ticketRef);if _,err:=accountmodel.NewTransition(oldStore,nextStore,bad);err==nil{t.Fatal("duplicate host model owners accepted")}
