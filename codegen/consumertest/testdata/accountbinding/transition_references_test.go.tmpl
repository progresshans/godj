type referenceBackend struct {
 database.Backend
 mode string
 ticket, source int64
 writes, badgeWrites, faults, completed atomic.Int32
 policy, denied atomic.Bool
}
func (b *referenceBackend) ReadSnapshot(ctx context.Context, read func(db.Queryer) error) error {
 err:=b.Backend.ReadSnapshot(ctx,read)
 if err==nil&&b.mode=="read_cleanup" {return errors.New("private reference snapshot cleanup")}
 return err
}
func (b *referenceBackend) CoordinatedAtomic(ctx context.Context, write func(db.Session)error)error{
 err:=b.Backend.CoordinatedAtomic(ctx,func(scope db.Session)error{
  if err:=write(&referenceScope{Session:scope,owner:b});err!=nil{return err}
  b.completed.Add(1)
  if b.mode=="unknown_rollback"{return errors.New("reference rollback after complete callback")};return nil
 })
 if b.mode=="unknown_rollback"||err==nil&&b.mode=="unknown_commit"{return &query.Error{Category:query.CategoryBackend,Code:query.CodeCommitOutcomeUnknown}}
 return err
}
func (b *referenceBackend) CoordinatedAtomicRelation(ctx context.Context, write func(db.RelationSession)error)error{
 err:=b.Backend.CoordinatedAtomicRelation(ctx,func(scope db.RelationSession)error{
  if err:=write(&referenceScope{Session:scope,owner:b});err!=nil{return err}
  b.completed.Add(1)
  if b.mode=="unknown_rollback"{return errors.New("reference rollback after complete relation callback")};return nil
 })
 if b.mode=="unknown_rollback"||err==nil&&b.mode=="unknown_commit"{return &query.Error{Category:query.CategoryBackend,Code:query.CodeCommitOutcomeUnknown}}
 return err
}
type referenceScope struct {db.Session;owner *referenceBackend}
func(s *referenceScope)ValidateSession(ctx context.Context)error{return s.Session.(db.SessionValidator).ValidateSession(ctx)}
func(s *referenceScope)RelationSetNull(ctx context.Context,plan query.RelationSetNullPlan)(int64,error){return s.Session.(db.RelationSession).RelationSetNull(ctx,plan)}
func(s *referenceScope)InsertOnConflict(ctx context.Context,plan query.ConflictInsertPlan)(bool,error){return s.Session.(db.ConflictInserter).InsertOnConflict(ctx,plan)}
func(s *referenceScope)changeTicket(ctx context.Context)error{
 row,err:=host.TicketObjects.Using(s.Session).Filter(host.TicketFields.ID.Exact(s.owner.ticket)).Get(ctx);if err!=nil{return err}
 prepared,err:=host.TicketObjects.PrepareValues(&row,map[string]query.Value{"title":query.String("changed by native rule")});if err!=nil{return err}
 row,err=prepared.Model();if err!=nil{return err};return prepared.Save(ctx,s.Session,&row)
}
func(s *referenceScope)Update(ctx context.Context,plan query.UpdatePlan)(int64,error){
 count,err:=s.Session.Update(ctx,plan);if err==nil&&plan.Table()=="transition_badge"{s.owner.badgeWrites.Add(1)};if err!=nil||plan.Table()!="transition_ticket"{return count,err}
 n:=s.owner.writes.Add(1)
 if s.owner.mode=="second_write_failure"&&n==2{s.owner.faults.Add(1);return count,errors.New("failure after second host update")}
 if s.owner.mode=="lost_update"&&n==1{s.owner.faults.Add(1);return 0,nil}
 if s.owner.mode=="host_source_change"&&n==1{
  row,e:=models.UserObjects.Using(s.Session).Filter(models.UserFields.ID.Exact(s.owner.source)).Get(ctx);if e!=nil{return 0,e}
  prepared,e:=models.UserObjects.PrepareValues(&row,map[string]query.Value{"first_name":query.String("unreviewed source change")});if e!=nil{return 0,e}
  row,e=prepared.Model();if e!=nil{return 0,e};if e=prepared.Save(ctx,s.Session,&row);e!=nil{return 0,e};s.owner.faults.Add(1)
 }
 return count,nil
}
func(s *referenceScope)Insert(ctx context.Context,plan query.InsertPlan)(int64,error){
 id,err:=s.Session.Insert(ctx,plan);if err!=nil{return id,err}
 if s.owner.mode=="target_insert_host_change"&&plan.Table()=="members_member"&&s.owner.faults.CompareAndSwap(0,1){if err:=s.changeTicket(ctx);err!=nil{return 0,err}}
 if s.owner.mode=="audit_after_write"&&plan.Table()=="godj_account_audit_event"&&s.owner.writes.Load()>0{s.owner.faults.Add(1);return id,errors.New("failure after host audit insert")}
 if plan.Table()=="godj_account_domain_transition"{
  if s.owner.mode=="late_host_change"{s.owner.faults.Add(1);if err:=s.changeTicket(ctx);err!=nil{return 0,err}}
  if s.owner.mode=="late_policy_change"{s.owner.faults.Add(1);s.owner.policy.Store(true)}
 }
 return id,nil
}
type referenceOverlay struct {state *referenceBackend}
func(o referenceOverlay)Allowed(_ context.Context,actor auth.Principal,permission auth.Permission)(bool,error){
 return actor.Has(permission)&&!(permission=="host.remap"&&o.state.denied.Load()),nil
}

func referenceRows[M any](t *testing.T,scope db.Queryer,objects orm.Manager[M])any{
 t.Helper();key,err:=objects.PrimaryKeyField();transitionCheck(t,err)
 rows,err:=objects.Using(scope).OrderBy(orm.NewAutoField[M](key).Asc()).All(t.Context());transitionCheck(t,err)
 values:=make([]map[string]query.Value,len(rows));for i,row:=range rows{values[i],err=objects.ModelValues(row);transitionCheck(t,err)};return values
}
func referenceSnapshot(t *testing.T,scope db.Queryer)map[string]any{
 t.Helper();return map[string]any{
  "users":referenceRows(t,scope,models.UserObjects),"members":referenceRows(t,scope,members.MemberObjects),
  "groups":referenceRows(t,scope,models.GroupObjects),"permissions":referenceRows(t,scope,models.PermissionObjects),
  "group_permissions":referenceRows(t,scope,models.GroupPermissionsLinkObjects),"user_groups":referenceRows(t,scope,models.UserGroupsLinkObjects),
  "user_permissions":referenceRows(t,scope,models.UserPermissionsLinkObjects),"user_topics":referenceRows(t,scope,models.UserTopicsLinkObjects),
  "member_groups":referenceRows(t,scope,members.MemberGroupsLinkObjects),"member_permissions":referenceRows(t,scope,members.MemberPermissionsLinkObjects),"member_interests":referenceRows(t,scope,members.MemberInterestsLinkObjects),
  "tickets":referenceRows(t,scope,host.TicketObjects),"badges":referenceRows(t,scope,host.BadgeObjects),"workspaces":referenceRows(t,scope,host.WorkspaceObjects),"assignments":referenceRows(t,scope,host.AssignmentObjects),
  "ownership":referenceRows(t,scope,domainmodels.TransitionObjects),"mapping":referenceRows(t,scope,domainmodels.MappingObjects),"audit":referenceRows(t,scope,auditmodels.EventObjects),"sessions":referenceRows(t,scope,sessionmodels.SessionObjects),
 }
}

func TestAccountTransitionReferences(t *testing.T){
 for _,strategy:=range []string{"staged","created"}{t.Run(strategy,func(t *testing.T){
  cases:=[]string{"lifecycle","schema_lifecycle","signed_keys","null_references","no_revision","page_boundary","row_limit","revision_limit","callback_owned","config_owned","missing_grant","permission_revoked","policy_rejected","row_changed","new_row","row_deleted","second_write_failure","audit_after_write","late_host_change","host_source_change","lost_update","unknown_commit","unknown_rollback","concurrent","configuration","read_cleanup","canceled","late_policy_change","one_to_one_conflict"}
  if strategy=="staged"{cases=append(cases,"already_mapped","wrong_target","target_without_source")}else{cases=append(cases,"target_insert_host_change")}
  for _,mode:=range cases{t.Run(mode,func(t *testing.T){
   native,selected:=openAccountDatabase(t)
   if mode=="schema_lifecycle"{migrateAccountDefinitions(t,native,@@LEGACY_MIGRATIONS@@)}else{migrateAccountDefinitions(t,native,@@MIGRATIONS@@)}
   backend:=&referenceBackend{Backend:native}
   hasher,encoded:=accountPassword(t);joined:=time.Date(2026,10,28,3,4,5,0,time.UTC)
   var originals []models.User
   var staged []members.Member
   var mapping []accountmodel.AccountMapping
   var requests []accountmodel.AccountCreation[members.Member]
   for i,name:=range []string{"alice","bob"}{
    row,err:=models.UserObjects.Create(t.Context(),native,models.NewUserCreate("reference-principal-"+name,name,encoded,joined).WithFirstName("private-"+name).WithStaff(i==0));transitionCheck(t,err)
    if mode=="signed_keys"{key:=int64(-9);if i==1{key=0};accountStoredKey(t,native,selected,"godj_identity_user","id",row.ID,key);row.ID=key}
    originals=append(originals,row)
    if strategy=="staged"{
     next,err:=members.MemberObjects.Create(t.Context(),native,members.NewMemberCreate(row.PrincipalID,name+"-new",encoded,joined,"").WithStaff(row.Staff).WithSuperuser(row.Superuser).WithActive(row.Active));transitionCheck(t,err)
     if mode=="signed_keys"{key:=int64(-20);if i==1{key=0};accountStoredKey(t,native,selected,"members_member","id",next.ID,key);next.ID=key}
     staged=append(staged,next);mapping=append(mapping,accountmodel.AccountMapping{SourceID:row.ID,SourceRevision:row.Revision,TargetID:next.ID,TargetRevision:next.Version})
    }else{
     input,err:=members.MemberObjects.Input(map[string]query.Value{"handle":query.String(name+"-new")});transitionCheck(t,err)
     requests=append(requests,accountmodel.AccountCreation[members.Member]{Source:accountmodel.SourceAccount{ID:row.ID,Revision:row.Revision},Input:input})
    }
   }
   for _,code:=range []string{"account.transition","host.remap","host.audit"}{
    permission,err:=models.PermissionObjects.Create(t.Context(),native,models.NewPermissionCreate(code,code));transitionCheck(t,err)
    if mode=="missing_grant"&&code=="host.remap"{continue}
    _,err=models.UserPermissionsLinkObjects.Create(t.Context(),native,models.NewUserPermissionsLinkCreate(originals[0].ID,permission.ID));transitionCheck(t,err)
    if strategy=="staged"{_,err=members.MemberPermissionsLinkObjects.Create(t.Context(),native,members.NewMemberPermissionsLinkCreate(staged[0].ID,permission.ID));transitionCheck(t,err)}
   }
   ticketCount:=2;if mode=="page_boundary"{ticketCount=257}
   var tickets []host.Ticket
   var badge host.Badge
   var workspace host.Workspace
   var assignments []host.Assignment
   if mode=="schema_lifecycle"{
    for i:=0;i<ticketCount;i++{_,err:=legacyhost.TicketObjects.Create(t.Context(),native,legacyhost.NewTicketCreate(fmt.Sprintf("ticket-%d",i)).WithOldOwnerID(originals[i%2].ID).WithOldReviewerID(originals[(i+1)%2].ID));transitionCheck(t,err)}
    _,err:=legacyhost.BadgeObjects.Create(t.Context(),native,legacyhost.NewBadgeCreate("badge").WithOldUserID(originals[0].ID));transitionCheck(t,err)
    legacyWorkspace,err:=legacyhost.WorkspaceObjects.Create(t.Context(),native,legacyhost.NewWorkspaceCreate("workspace"));transitionCheck(t,err)
    for i,old:=range originals{_,err:=legacyhost.AssignmentObjects.Create(t.Context(),native,legacyhost.NewAssignmentCreate(fmt.Sprintf("assignment-%d",i)).WithWorkspaceID(legacyWorkspace.ID).WithOldUserID(old.ID));transitionCheck(t,err)}
    migrateAccountDefinitions(t,native,@@EXPANDED_MIGRATIONS@@)
    tickets,err=host.TicketObjects.Using(native).OrderBy(host.TicketFields.ID.Asc()).All(t.Context());transitionCheck(t,err)
    badge,err=host.BadgeObjects.Using(native).Get(t.Context());transitionCheck(t,err)
