    if len(tickets)!=2||len(assignments)!=2{t.Fatal("schema expansion lost filled host rows")}
    for i,row:=range tickets{if row.Title!=fmt.Sprintf("ticket-%d",i)||row.Revision!=1||row.OldOwnerID==nil||*row.OldOwnerID!=originals[i%2].ID||row.OldReviewerID==nil||*row.OldReviewerID!=originals[(i+1)%2].ID||row.OwnerID!=nil||row.ReviewerID!=nil{t.Fatal("schema expansion did not preserve source references and empty destinations")}}
   }else{
   for i:=0;i<ticketCount;i++{
    input:=host.NewTicketCreate(fmt.Sprintf("ticket-%d",i))
