   }
   owner,err:=accountmodel.NewTransition(oldStore,nextStore,config);transitionCheck(t,err)
   if mode=="read_cleanup"{backend.mode=mode}
   beforePreparation:=referenceSnapshot(t,native)
   prepare:=func(owner *accountmodel.Transition[models.User,members.Member],operation string)(accountmodel.PreparedTransition[models.User,members.Member],error){if strategy=="created"{return owner.PrepareCreation(t.Context(),actor,operation,requests)};return owner.Prepare(t.Context(),actor,operation,mapping)}
   prepared,prepareErr:=prepare(owner,strings.Repeat("e",64));backend.mode=""
