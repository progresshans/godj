   workspace,err=host.WorkspaceObjects.Create(t.Context(),native,host.NewWorkspaceCreate("workspace"));transitionCheck(t,err)
   for i,old:=range originals{
    input:=host.NewAssignmentCreate(fmt.Sprintf("assignment-%d",i)).WithWorkspaceID(workspace.ID)
    if mode!="null_references"{input=input.WithOldUserID(old.ID)}
    if mode=="already_mapped"{input=input.WithUserID(staged[i].ID)}
    row,err:=host.AssignmentObjects.Create(t.Context(),native,input);transitionCheck(t,err);assignments=append(assignments,row)
   }
   }
   backend.ticket,backend.source=tickets[0].ID,originals[0].ID
   sourceBinding,err:=project.BindAccount();transitionCheck(t,err);targetBinding:=transitionTargetBinding(t)
   role,err:=sourceBinding.RoleFingerprint();transitionCheck(t,err)
   initial,err:=domain.Prepare(t.Context(),role,strings.Repeat("a",64));transitionCheck(t,err)
   transitionCheck(t,native.CoordinatedAtomic(t.Context(),func(scope db.Session)error{_,err:=domain.InitializeIn(t.Context(),scope,initial,joined);return err}))
   oldStore,nextStore:=transitionStores(t,backend)
   verifier,err:=oldStore.Authenticator(t.Context(),hasher);transitionCheck(t,err);credential,err:=verifier.Authenticate(t.Context(),"alice",accountPasswordText);transitionCheck(t,err)
   actor:=credential.Principal();namespace,_:=actor.CredentialDomain()
   manager,err:=sessions.NewManager(oldStore,sessions.Config{});transitionCheck(t,err)
   session,err:=manager.Create(t.Context(),map[string]string{auth.SessionPrincipalIDKey:actor.ID(),auth.SessionCredentialStampKey:credential.SessionStamp()});transitionCheck(t,err)
   _=session
   policy:=func(current auth.Principal)validation.Errors{
    if current.ID()!=actor.ID()||!current.Has("host.remap"){t.Error("reference validator lost admitted source authority")}
    if backend.policy.Load(){return validation.NewErrors(validation.New(validation.NonField,"reference_policy"))};return validation.Errors{}
   }
   revision:="revision";if mode=="no_revision"{revision=""}
   maxRows:=300;if mode=="row_limit"{maxRows=1}
   ticketConfig:=accountmodel.TransitionReferenceConfig[host.Ticket]{Fields:[]accountmodel.TransitionReferenceFields{{Source:"old_reviewer",Target:"reviewer"},{Source:"old_owner",Target:"owner"}},RevisionField:revision,Permission:"host.remap",AdditionalPermissions:[]auth.Permission{"host.audit"},MaxRows:maxRows,
    Validate:func(_ context.Context,_ db.Queryer,current auth.Principal,before,after host.Ticket)(validation.Errors,error){if before.Title!=after.Title||!reflect.DeepEqual(before.OldOwnerID,after.OldOwnerID)||!reflect.DeepEqual(before.OldReviewerID,after.OldReviewerID){t.Error("reference candidate changed unrelated state")};if mode=="callback_owned"{after.Title="callback local edit";if after.OwnerID!=nil{*after.OwnerID=999999}};return policy(current),nil},
   }
   ticketRef,err:=accountmodel.NewTransitionReference(sourceBinding,targetBinding,ir.ModelIdentity{AppLabel:"host",ModelName:"ticket"},host.TicketDescriptor{},ticketConfig);transitionCheck(t,err)
   if mode=="config_owned"{ticketConfig.Fields[0].Target="title"}
   badgeRef,err:=accountmodel.NewTransitionReference(sourceBinding,targetBinding,ir.ModelIdentity{AppLabel:"host",ModelName:"badge"},host.BadgeDescriptor{},accountmodel.TransitionReferenceConfig[host.Badge]{Fields:[]accountmodel.TransitionReferenceFields{{Source:"old_user",Target:"user"}},Permission:"host.remap",Validate:func(_ context.Context,_ db.Queryer,current auth.Principal,before,after host.Badge)(validation.Errors,error){return policy(current),nil}});transitionCheck(t,err)
   assignmentRef,err:=accountmodel.NewTransitionReference(sourceBinding,targetBinding,ir.ModelIdentity{AppLabel:"host",ModelName:"assignment"},host.AssignmentDescriptor{},accountmodel.TransitionReferenceConfig[host.Assignment]{Fields:[]accountmodel.TransitionReferenceFields{{Source:"old_user",Target:"user"}},RevisionField:revision,Permission:"host.remap",Validate:func(_ context.Context,_ db.Queryer,current auth.Principal,before,after host.Assignment)(validation.Errors,error){if before.Note!=after.Note||!reflect.DeepEqual(before.WorkspaceID,after.WorkspaceID){t.Error("through remap changed its host owner")};return policy(current),nil}});transitionCheck(t,err)
   config:=accountmodel.TransitionConfig[models.User,members.Member]{Permission:"account.transition",Authorizer:referenceOverlay{backend},References:[]accountmodel.TransitionReference[models.User,members.Member]{ticketRef,badgeRef,assignmentRef}}
   if strategy=="created"{collections,err:=project.BindCollections();transitionCheck(t,err);config.TargetCreation,err=accountmodel.NewTransitionTarget(targetBinding,collections.MembersMemberGroups,collections.MembersMemberPermissions,accountmodel.TransitionTargetConfig[members.Member]{Fields:[]string{"handle"}});transitionCheck(t,err)}
