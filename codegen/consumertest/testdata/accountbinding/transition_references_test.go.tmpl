   switch mode{
   case "row_changed":transitionPatch(t,native,host.TicketObjects,tickets[0],map[string]query.Value{"title":query.String("concurrent change without revision")})
   case "new_row":_,err=host.TicketObjects.Create(t.Context(),native,host.NewTicketCreate("concurrent row"));transitionCheck(t,err)
   case "row_deleted":_,err=host.TicketObjects.Delete(t.Context(),native,&tickets[0]);transitionCheck(t,err)
   case "permission_revoked":backend.denied.Store(true)
   case "policy_rejected":backend.policy.Store(true)
   }
   if mode=="concurrent"{
    secondNative,err:=database.Open(t.Context(),selected);transitionCheck(t,err);defer secondNative.Close()
    secondBackend:=&referenceBackend{Backend:secondNative};secondOld,secondNext:=transitionStores(t,secondBackend)
    secondConfig:=config;secondConfig.Authorizer=referenceOverlay{secondBackend}
    second,err:=accountmodel.NewTransition(secondOld,secondNext,secondConfig);transitionCheck(t,err)
    other,err:=prepare(second,strings.Repeat("f",64));transitionCheck(t,err)
    var results [2]accountmodel.TransitionResult;var failures [2]error;var wait sync.WaitGroup;start:=make(chan struct{})
    for i,pending:=range []accountmodel.PreparedTransition[models.User,members.Member]{prepared,other}{wait.Add(1);go func(){defer wait.Done();<-start;if i==0{results[i],failures[i]=owner.Commit(t.Context(),actor,pending)}else{results[i],failures[i]=second.Commit(t.Context(),actor,pending)}}()};close(start);wait.Wait()
    wins:=0;for i,failure:=range failures{if failure==nil{wins++;if results[i].RemappedRows!=5{t.Fatal("winner lost host mapping")}}else if !reflect.DeepEqual(results[i],accountmodel.TransitionResult{}){t.Fatal("loser published partial host result")}}
    if wins!=1{t.Fatal("host transition race did not produce one winner",failures)}
    stored,err:=host.TicketObjects.Using(native).OrderBy(host.TicketFields.ID.Asc()).All(t.Context());transitionCheck(t,err);for _,row:=range stored{if row.Revision!=2||row.OwnerID==nil||row.ReviewerID==nil{t.Fatal("concurrent host mapping incomplete")}};return
   }
   beforeCommit:=referenceSnapshot(t,native)
   faults:=[]string{"second_write_failure","audit_after_write","late_host_change","host_source_change","lost_update","unknown_commit","unknown_rollback","late_policy_change","target_insert_host_change"}
