				}
				if mode == "cascade_account" {
					found, e := objects.Using(reader).Filter(orm.NewAutoField[@@ACCOUNT@@](parentKey).Exact(victim)).Exists(t.Context())
					check(e)
					_, loaded, e := runtime.SessionStore().Load(t.Context(), stored.ID())
					check(e)
					events := history(reader, accountName, victim)
					deleted := 0
					for _, event := range events {
						if event.Action() == admin.ActionDelete {
							deleted++
						}
					}
					if found || loaded || changed.RevokedSessions != 1 || deleted != 1 {
						t.Fatal("catalog deletion lost dependent account/session/audit ownership")
					}
				}
			}
			if mode == "restart" {
				restarted, e := project.NewAccountRuntime(t.Context(), reader, hasher, overlay, runtimeConfig)
				check(e)
				credential, e := restarted.Authenticator().Authenticate(t.Context(), "operator@example.test", accountPasswordText)
				check(e)
				view, e := restarted.Accounts().Reader().Get(t.Context(), credential.Principal(), boot.Account.ID)
				check(e)
				if view.Revision() != 2 || len(readCreated(reader)) != 2 {
					t.Fatal("restart lost through-created catalog identities")
				}
			}
		})
	}
}
