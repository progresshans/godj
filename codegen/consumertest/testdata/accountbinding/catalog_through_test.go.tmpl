type catalogThroughBackend struct {
	database.Backend
	reading, writing, starts, snapshots int
	cleanup, rollback, unknown          bool
	scope                               db.RelationSession
}

func (b *catalogThroughBackend) ReadSnapshot(ctx context.Context, read func(db.Queryer) error) error {
	b.reading++
	b.snapshots++
	defer func() { b.reading-- }()
	err := b.Backend.ReadSnapshot(ctx, read)
	if b.cleanup {
		b.cleanup = false
		return errors.Join(err, errors.New("catalog through snapshot cleanup"))
	}
	return err
}
func (b *catalogThroughBackend) CoordinatedAtomicRelation(ctx context.Context, write func(db.RelationSession) error) error {
	b.starts++
	b.writing++
	defer func() { b.writing--; b.scope = nil }()
	err := b.Backend.CoordinatedAtomicRelation(ctx, func(scope db.RelationSession) error {
		b.scope = scope
		if err := write(scope); err != nil {
			return err
		}
		if b.rollback {
			return errors.New("catalog through rollback")
		}
		return nil
	})
	if err == nil && b.unknown {
		return &query.Error{Category: query.CategoryBackend, Code: query.CodeCommitOutcomeUnknown}
	}
	return err
}

type catalogThroughOverlay struct{ deny auth.Permission }

func (o *catalogThroughOverlay) Allowed(_ context.Context, actor auth.Principal, p auth.Permission) (bool, error) {
	return actor.Has(p) && p != o.deny, nil
}

func catalogThroughCheck(t *testing.T, err error) {
	t.Helper()
	if err != nil {
		t.Fatal(err)
	}
}
func catalogThroughKey[M any](t *testing.T, objects orm.Manager[M], row M) int64 {
	t.Helper()
	key, present, err := objects.PrimaryKey(row)
	id, valid := key.Integer()
	if err != nil || !present || !valid {
		t.Fatal("missing actual typed key", err)
	}
	return id
}
func catalogThroughInsert[M any](t *testing.T, scope db.Session, objects orm.Manager[M], values map[string]query.Value) M {
	t.Helper()
	prepared, err := objects.PrepareValues(nil, values)
	catalogThroughCheck(t, err)
	row, err := prepared.Model()
	catalogThroughCheck(t, err)
	catalogThroughCheck(t, prepared.Save(t.Context(), scope, &row))
	return row
}
func catalogThroughRows[M any](t *testing.T, reader db.Queryer, objects orm.Manager[M]) []M {
	t.Helper()
	field, err := objects.PrimaryKeyField()
	catalogThroughCheck(t, err)
	rows, err := objects.Using(reader).OrderBy(orm.NewAutoField[M](field).Asc()).All(t.Context())
	catalogThroughCheck(t, err)
	return rows
}

