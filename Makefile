	go run ./conformance/cmd/godjcheck \
		-profile $(PROFILE) -manifest $(MIGRATION_DEFINITION_SOURCE_MANIFEST) \
		-expected $(MIGRATION_DEFINITION_SOURCE_ORACLE)
	go run ./conformance/cmd/godjcheck \
		-profile $(PROFILE) -manifest $(MIGRATION_PROJECT_CHECK_MANIFEST) \
