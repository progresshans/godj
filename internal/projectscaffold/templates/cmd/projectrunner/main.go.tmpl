package main

import (
	"context"
	"fmt"
	"os"

	"github.com/progresshans/godj/project"
	"github.com/progresshans/godj/settings"
	"github.com/progresshans/godj/settings/database"
	"github.com/progresshans/godj/systemstate"
	"[[.Module]]/internal/config"
	"[[.Module]]/modeldef"
)

func main() {
	environment, err := settings.NewEnvironment(os.Environ())
	if err != nil {
		fmt.Fprintln(os.Stderr, "project configuration failed")
		os.Exit(1)
	}
	selected, selectionErr := config.Database(environment)
	identity, identityErr := config.Identity()
	principal, principalErr := config.InitialSuperuser()
	err = project.Run(context.Background(), project.Config{
		LoadProjectSpec: modeldef.ProjectSpec,
		MigrationDefinitionRoots: []string{"migrations"},
		MigrationDefinitionSources: systemstate.IdentityMigrationSources(),
		MigrationSQLRenderer: selected.MigrationSQLRenderer(),
		OpenMigrationBackend: func(ctx context.Context) (project.MigrationBackend, error) {
			if selectionErr != nil { return nil, selectionErr }
			return database.Open(ctx, selected)
		},
		OpenSystemStateBackend: func(ctx context.Context) (project.SystemStateBackend, error) {
			if selectionErr != nil { return nil, selectionErr }
			if identityErr != nil { return nil, identityErr }
			if principalErr != nil { return nil, principalErr }
			return database.Open(ctx, selected)
		},
		InitialSuperuser: principal,
		PasswordHasher: identity.PasswordHasher,
	}, os.Args[1:], os.Stdin, os.Stdout)
	if err != nil {
		code := project.RunnerExitCode(err)
		if code == 1 { fmt.Fprintln(os.Stderr, "project command failed") }
		os.Exit(code)
	}
}
